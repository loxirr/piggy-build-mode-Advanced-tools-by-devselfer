				if Handles then
					Handles:Destroy()
					Handles = nil
				end
				if Adornee then
					Adornee:Destroy()
					Adornee = nil
				end
				if AnteriorModel then
					RemoveInitialSizeToModel(AnteriorModel)
					AnteriorModel = nil
				end

				if not Act then
					return
				end

				local InitialSize = Act:GetExtentsSize()
				local InitialPosition = Act:GetPivot()
				local InitialScale = Act:GetScale()
				local LastDistance = 0
				SetInitialSizeToModel(Act)

				Adornee = Instance.new("Part")
				Adornee.Parent = workspace
				Adornee.Anchored = true
				Adornee.CanCollide = false
				Adornee.Transparency = 1
				Adornee.Size = InitialSize
				Adornee.CFrame = InitialPosition

				Handles = Instance.new("Handles")
				Handles.Parent = PlayerGui
				Handles.Adornee = Adornee
				Handles.Color3 = ActualColors.Selected

				AnteriorModel = Act

				AddToClean(Handles.MouseButton1Up:Connect(function()
					InitialSize = Act:GetExtentsSize()
					InitialPosition = Act:GetPivot()
					InitialScale = Act:GetScale()
					LastDistance = 0
					SetInitialSizeToModel(Act)
					BuildFunctions.Resize(Act,Adornee.CFrame,Adornee.Size)
				end))

				AddToClean(Handles.MouseDrag:Connect(function(Face, distance)
					distance = math.min(distance,2000)

					if ActualToolGridState and ToolGrid > 0 then
						distance = (distance // ToolGrid) * ToolGrid
					end

					if CtlrPressingState then

						if ShiftPressingState then

							local AxisNewSize
							local AxisInitialSize

							if Face == Enum.NormalId.Right then
								AxisInitialSize = InitialSize.X
								AxisNewSize = AxisInitialSize + distance
							elseif Face == Enum.NormalId.Left then
								AxisInitialSize = InitialSize.X
								AxisNewSize = AxisInitialSize + distance
							elseif Face == Enum.NormalId.Top then
								AxisInitialSize = InitialSize.Y
								AxisNewSize = AxisInitialSize + distance
							elseif Face == Enum.NormalId.Bottom then
								AxisInitialSize = InitialSize.Y
								AxisNewSize = AxisInitialSize + distance
							elseif Face == Enum.NormalId.Back then
								AxisInitialSize = InitialSize.Z
								AxisNewSize = AxisInitialSize + distance
							elseif Face == Enum.NormalId.Front then
								AxisInitialSize = InitialSize.Z
								AxisNewSize = AxisInitialSize + distance
							end
							local NewScale = (AxisNewSize / AxisInitialSize)*InitialScale
							if NewScale <= 0 then
								NewScale = 0.001
							end
							Act:ScaleTo(NewScale)
							Adornee.Size = Act:GetExtentsSize()
						else
							distance *= 2

							if Face == Enum.NormalId.Right or Face == Enum.NormalId.Left then
								Adornee.Size = Vector3.new(
									InitialSize.X + distance,
									InitialSize.Y,
									InitialSize.Z
								)
							elseif Face == Enum.NormalId.Top or Face == Enum.NormalId.Bottom then
								Adornee.Size = Vector3.new(
									InitialSize.X,
									InitialSize.Y + distance,
									InitialSize.Z
								)
							elseif Face == Enum.NormalId.Back or Face == Enum.NormalId.Front then
								Adornee.Size = Vector3.new(
									InitialSize.X,
									InitialSize.Y,
									InitialSize.Z + distance
								)
							end
							ResizeModel(Act,InitialSize,Adornee.Size)
						end
					else

						if ShiftPressingState then

							local AxisNewSize
							local AxisInitialSize

							local NewPositionX = 0
							local NewPositionY = 0
							local NewPositionZ = 0

							if Face == Enum.NormalId.Right then
								AxisInitialSize = InitialSize.X
								AxisNewSize = AxisInitialSize + distance
								if AxisNewSize > 0 then
									NewPositionX += distance/2
								else
									NewPositionX += -InitialSize.X/2
								end
							elseif Face == Enum.NormalId.Left then
								AxisInitialSize = InitialSize.X
								AxisNewSize = AxisInitialSize + distance
								if AxisNewSize > 0 then
									NewPositionX -= distance/2
								else
									NewPositionX -= -InitialSize.X/2
								end
							elseif Face == Enum.NormalId.Top then
								AxisInitialSize = InitialSize.Y
								AxisNewSize = AxisInitialSize + distance
								if AxisNewSize > 0 then
									NewPositionY += distance/2
								else
									NewPositionY += -InitialSize.Y/2
								end
							elseif Face == Enum.NormalId.Bottom then
								AxisInitialSize = InitialSize.Y
								AxisNewSize = AxisInitialSize + distance
								if AxisNewSize > 0 then
									NewPositionY -= distance/2
								else
									NewPositionY -= -InitialSize.Y/2
								end
							elseif Face == Enum.NormalId.Back then
								AxisInitialSize = InitialSize.Z
								AxisNewSize = AxisInitialSize + distance
								if AxisNewSize > 0 then
									NewPositionZ += distance/2
								else
									NewPositionZ += -InitialSize.Z/2
								end
							elseif Face == Enum.NormalId.Front then
								AxisInitialSize = InitialSize.Z
								AxisNewSize = AxisInitialSize + distance
								if AxisNewSize > 0 then
									NewPositionZ -= distance/2
								else
									NewPositionZ -= -InitialSize.Z/2
								end
							end

							local NewScale = (AxisNewSize / AxisInitialSize)*InitialScale
							if NewScale <= 0 then
								NewScale = 0.001
							end
							Act:ScaleTo(NewScale)
							Adornee.Size = Act:GetExtentsSize()
							Adornee.CFrame = InitialPosition * CFrame.new(
								NewPositionX,
								NewPositionY,
								NewPositionZ
							)
							Act:PivotTo(Adornee.CFrame)
						else

							local NewSizeX = InitialSize.X
							local NewSizeY = InitialSize.Y
							local NewSizeZ = InitialSize.Z
							local NewPositionX = 0
							local NewPositionY = 0
							local NewPositionZ = 0

							if Face == Enum.NormalId.Right then
								NewSizeX = InitialSize.X + distance
								if NewSizeX > 0 then
									NewPositionX += distance/2
								else
									NewPositionX += -InitialSize.X/2
								end
							elseif Face == Enum.NormalId.Left then
								NewSizeX = InitialSize.X + distance
								if NewSizeX > 0 then
									NewPositionX -= distance/2
								else
									NewPositionX -= -InitialSize.X/2
								end
							elseif Face == Enum.NormalId.Top then
								NewSizeY = InitialSize.Y + distance
								if NewSizeY > 0 then
									NewPositionY += distance/2
								else
									NewPositionY += -InitialSize.Y/2
								end
							elseif Face == Enum.NormalId.Bottom then
								NewSizeY = InitialSize.Y + distance
								if NewSizeY > 0 then
									NewPositionY -= distance/2
								else
									NewPositionY -= -InitialSize.Y/2
								end
							elseif Face == Enum.NormalId.Back then
								NewSizeZ = InitialSize.Z + distance
								if NewSizeZ > 0 then
									NewPositionZ += distance/2
								else
									NewPositionZ += -InitialSize.Z/2
								end
							elseif Face == Enum.NormalId.Front then
								NewSizeZ = InitialSize.Z + distance
								if NewSizeZ > 0 then
									NewPositionZ -= distance/2
								else
									NewPositionZ -= -InitialSize.Z/2
								end
							end
							Adornee.Size = Vector3.new(
								NewSizeX,
								NewSizeY,
								NewSizeZ
							)
							Adornee.CFrame = InitialPosition * CFrame.new(
								NewPositionX,
								NewPositionY,
								NewPositionZ
							)
							Act:PivotTo(Adornee.CFrame)
							ResizeModel(Act,InitialSize,Adornee.Size)
						end
					end

					LastDistance = distance
					RemoveBorders(Act)
					CreateBorders(Act,ActualColors.NoSelected)
				end))

				AddToClean(Adornee)
				AddToClean(Handles)
			end

			AddToClean(RunService.PreSimulation:Connect(function()
				if ActualState == "resize" then

					--NormalTarget

					--Obtener targets
					local NewTarget = GetTarget()
					local AnteriorTarget = ActualTarget
					ActualTarget = NewTarget

					--condicionales
					local TargetIsNew = not ActualTarget or not AnteriorTarget or ActualTarget ~= AnteriorTarget


					--Poner y quitar bordes
					if TargetIsNew then

						--condicionales
						local AnteriorTargetIsClicked = ActualClicked and AnteriorTarget and AnteriorTarget == ActualClicked
						local TargetIsClicked = ActualClicked and ActualTarget and ActualTarget == ActualClicked

						--si el anterior es clicked ponerle otro color, en contrario caso quitarle bordes
						if AnteriorTargetIsClicked then
							CreateBorders(AnteriorTarget,ActualColors.Selected)
						else
							RemoveBorders(AnteriorTarget)
						end

						--si el nuevo es clicked ponerle otro color, en otro caso ponerles bordes
						if TargetIsClicked then
							CreateBorders(ActualTarget,ActualColors.Selected)
						else
							CreateBorders(ActualTarget,ActualColors.NoSelected)
						end
					end

				end

			end))

			AddToClean(Mouse.Button1Down:Connect(function()
				if ActualState == "resize" then
					RemoveBorders(ActualClicked)
					ActualClicked = ActualTarget
					CreateBorders(ActualClicked,ActualColors.Selected)
					CreateHandles(ActualClicked)					
				end
			end))

			AddToClean(Events.StateChanged.Event:Connect(function()
				RemoveBorders(ActualTarget)
				RemoveBorders(ActualClicked)
				ActualTarget = nil
				ActualClicked = nil
				if Handles then
					Handles:Destroy()
					Handles = nil
				end
				if Adornee then
					Adornee:Destroy()
					Adornee = nil
				end
			end))
		end

		--Rotar
		do
			local ActualTarget
			local ActualClicked

			local Handles
			local Adornee
			local function CreateHandles(Act)

				if Handles then
					Handles:Destroy()
					Handles = nil
				end
				if Adornee then
					Adornee:Destroy()
					Adornee = nil
				end

				if not Act then
					return
				end

				local ActualPivot = Act:GetPivot()
				local lastAngle = 0

				Adornee = Instance.new("Part")
				Adornee.Parent = workspace
				Adornee.Anchored = true
				Adornee.CanCollide = false
				Adornee.Transparency = 1
				Adornee.Size = Act:GetExtentsSize()
				Adornee.CFrame = ActualPivot

				Handles = Instance.new("ArcHandles")
				Handles.Parent = PlayerGui
				Handles.Adornee = Adornee

				AddToClean(Handles.MouseButton1Up:Connect(function()
					lastAngle = 0
					BuildFunctions.Move(Act,ActualPivot)
				end))

				AddToClean(Handles.MouseDrag:Connect(function(axis, angle)
					local Vec

					if ActualToolGridState and ActualRotationGrid > 0 then
						local actrot = math.rad(ActualRotationGrid)
						angle = (angle // actrot)*actrot
					end

					if axis == Enum.Axis.X then
						Vec = Vector3.new(1,0,0)
					elseif axis == Enum.Axis.Y then
						Vec = Vector3.new(0,1,0)
					elseif axis == Enum.Axis.Z then
						Vec = Vector3.new(0,0,1)
					end

					local delta = angle - lastAngle
					lastAngle = angle

					ActualPivot = ActualPivot * CFrame.fromAxisAngle(Vec, delta)

					Act:PivotTo(ActualPivot)
					Adornee.CFrame = ActualPivot
				end))

				AddToClean(Adornee)
				AddToClean(Handles)
			end

			local ActualColors = {
				Selected = Color3.new(0.0666667, 1, 0),
				NoSelected = Color3.new(0.0352941, 0.509804, 0),
			}

			AddToClean(RunService.PreSimulation:Connect(function()
				if ActualState == "rote" then

					--NormalTarget

					--Obtener targets
					local NewTarget = GetTarget()
					local AnteriorTarget = ActualTarget
					ActualTarget = NewTarget

					--condicionales
					local TargetIsNew = not ActualTarget or not AnteriorTarget or ActualTarget ~= AnteriorTarget


					--Poner y quitar bordes
					if TargetIsNew then

						--condicionales
						local AnteriorTargetIsClicked = ActualClicked and AnteriorTarget and AnteriorTarget == ActualClicked
						local TargetIsClicked = ActualClicked and ActualTarget and ActualTarget == ActualClicked

						--si el anterior es clicked ponerle otro color, en contrario caso quitarle bordes
						if AnteriorTargetIsClicked then
							CreateBorders(AnteriorTarget,ActualColors.Selected)
						else
							RemoveBorders(AnteriorTarget)
						end

						--si el nuevo es clicked ponerle otro color, en otro caso ponerles bordes
						CreateBorders(ActualTarget,ActualColors.NoSelected)
					end

				end

			end))

			AddToClean(Mouse.Button1Down:Connect(function()
				if ActualState == "rote" then
					RemoveBorders(ActualClicked)
					ActualClicked = ActualTarget
					CreateBorders(ActualClicked,ActualColors.NoSelected)
					CreateHandles(ActualClicked)					
				end
			end))

			AddToClean(Events.StateChanged.Event:Connect(function()
				RemoveBorders(ActualTarget)
				RemoveBorders(ActualClicked)
				ActualTarget = nil
				ActualClicked = nil
				if Handles then
					Handles:Destroy()
					Handles = nil
				end
				if Adornee then
					Adornee:Destroy()
					Adornee = nil
				end
			end))
		end

	end
end

--Programar tool bar
do 
	local ToolBar = ScreenGui.ToolBar
	local ScriptRemover = ToolBar.ScriptRemover
	AddToClean(ScriptRemover.Activated:Connect(function()
		ScreenGui:Destroy()
	end))

	local ScrollingFrame = ToolBar:FindFirstChildOfClass("ScrollingFrame")

	local modelsButton = ScrollingFrame:FindFirstChild("models") :: TextButton
	local toolsButton = ScrollingFrame:FindFirstChild("tools") :: TextButton
	local settingsButton = ScrollingFrame:FindFirstChild("settings") :: TextButton
	local materialButton = ScrollingFrame:FindFirstChild("material") :: TextButton
	local colorButton = ScrollingFrame:FindFirstChild("color") :: TextButton

	local modelsMenu = ScreenGui:FindFirstChild("objectsmenu") :: Frame
	local toolsMenu = ScreenGui:FindFirstChild("toolsmenu") :: Frame
	local settingsMenu = ScreenGui:FindFirstChild("settingsmenu") :: Frame
	local materialMenu = ScreenGui:FindFirstChild("materialmenu") :: Frame
	local colorMenu = ScreenGui:FindFirstChild("colormenu") :: Frame

	local Menus = {
		{modelsMenu,modelsButton},
		{toolsMenu,toolsButton},
		{colorMenu,colorButton},
		{materialMenu,materialButton},
		{settingsMenu,settingsButton},
	}

	local ActualMenu = nil
	local BlockMenuChange = false

	local function SetMenusVisible(ActualMenuFunc,State)
		for i, child in ipairs(Menus) do
			local Menu = child[1]
			if Menu == ActualMenuFunc then 
				local newstate
				if State == nil then
					newstate = not Menu.Visible
				else
					newstate = State
				end
				Menu.Visible = newstate
				if newstate then
					ActualMenu = Menu
				else
					ActualMenu = nil
				end
			else
				Menu.Visible = false
			end
		end
	end

	local function ConvertNumberToString(Number)
		if Number == 1 then
			return "One"
		elseif Number == 2 then
			return "Two"
		elseif Number == 3 then
			return "Three"
		elseif Number == 4 then
			return "Four"
		elseif Number == 5 then
			return "Five"
		elseif Number == 6 then
			return "Six"
		elseif Number == 7 then
			return "Seven"
		elseif Number == 8 then
			return "Eight"
		elseif Number == 9 then
			return "Nine"
		end
	end
	for i, child in ipairs(Menus) do
		local Menu = child[1]
		local Button = child[2]
		AddToClean(Menu.Changed:Connect(function(propertie)
			if propertie == "Visible" then
				local state = Menu.Visible

				if Menu == toolsMenu then
					if state then
						BlockMenuChange = true
					else
						task.delay(0.1,function()
							BlockMenuChange = false
						end)
					end
				end

				SetButtonColor(state,Button)
				if state then
					ActualMenu = Menu
				elseif ActualMenu == Menu then
					ActualMenu = nil
				end
			end
		end))
		AddToClean(Button.Activated:Connect(function()
			SetMenusVisible(Menu)
		end))

		local numbertostring = ConvertNumberToString(Button.LayoutOrder)

		AddToClean(UserInputService.InputBegan:Connect(function(input,gameprocessedevent)

			if gameprocessedevent or BlockMenuChange then return end

			if input.KeyCode == Enum.KeyCode[numbertostring] then
				SetMenusVisible(Menu)
			end
		end))
	end

	--Boton de modelos
	local ViewPortFrame = modelsButton:FindFirstChildOfClass("ViewportFrame")
	local Camera = ViewPortFrame:FindFirstChildOfClass("Camera") or Instance.new("Camera",ViewPortFrame)
	ViewPortFrame.CurrentCamera = Camera
	Camera.FieldOfView = 10
	local function Update()
		local newmodel = ActualCreationModel:Clone()
		local oldmodel = ViewPortFrame:FindFirstChildOfClass("Model")
		if oldmodel then
			oldmodel:Destroy()
		end
		newmodel.Parent = ViewPortFrame

		ApuntaCamaraToItem(ViewPortFrame,Camera,newmodel)

		local PivotAnterior = newmodel:GetPivot()
		AddToClean(RunService.Heartbeat:Connect(function(delta)
			PivotAnterior = PivotAnterior  * CFrame.Angles(0,math.rad(45*delta),0)
			newmodel:PivotTo(PivotAnterior)
		end))

		for i, child in ipairs(newmodel:GetDescendants()) do
			if child:IsA("BasePart") and child.Name == "ColorPart" then
				child.BrickColor = ActualBrickColor
				child.Material = ActualMaterial
			end
		end
	end
	AddToClean(Events.ModelChanged.Event:Connect(Update))
	AddToClean(Events.MaterialChanged.Event:Connect(Update))
	AddToClean(Events.BrickColorChanged.Event:Connect(Update))
	Update()

	--Boton de tools
	local toolsMenuScrollingFrame = toolsMenu.ScrollingFrame
	for i, child in ipairs(toolsMenuScrollingFrame:GetChildren()) do
		if child:IsA("ImageButton") then
			local function Set()
				SetActualState(child.Name)
				toolsMenu.Visible = false
			end
			AddToClean(child.Activated:Connect(Set))

			local numbertostring = ConvertNumberToString(child.LayoutOrder)

			AddToClean(UserInputService.InputBegan:Connect(function(input,gameprocessedevent)

				if gameprocessedevent or ActualMenu ~= toolsMenu then return end

				if input.KeyCode == Enum.KeyCode[numbertostring] then
					Set()
				end
			end))
		end
	end
	AddToClean(Events.StateChanged.Event:Connect(function(State)
		for i, child in ipairs(toolsMenuScrollingFrame:GetChildren()) do
			if child:HasTag("Button") then
				SetButtonColor(State == child.Name,child)
			end
		end
		for i, child in ipairs(toolsButton:GetChildren()) do
			if child:IsA("ImageLabel") then
				child.Visible = State == child.Name
			end
		end
	end))


	--boton de color
	local Frame = colorButton.Frame
	AddToClean(Events.BrickColorChanged.Event:Connect(function(Color)
		Frame.BackgroundColor3 = Color.Color
	end))
	Frame.BackgroundColor3 = ActualBrickColor.Color

	--boton de material
	local ViewPortFrame = materialButton:FindFirstChildOfClass("ViewportFrame")
	local Camera = ViewPortFrame:FindFirstChildOfClass("Camera") or Instance.new("Camera",ViewPortFrame)
	ViewPortFrame.CurrentCamera = Camera
	Camera.FieldOfView = 10
	local Model = ViewPortFrame:FindFirstChildOfClass("Model")
	local Ball = Model:FindFirstChildOfClass("Part")
	ApuntaCamaraToItem(ViewPortFrame,Camera,Model)
	local function Update2()
		Ball.Color = ActualBrickColor.Color
		Ball.Material = ActualMaterial
	end
	Update2()

	AddToClean(Events.MaterialChanged.Event:Connect(Update2))
	AddToClean(Events.BrickColorChanged.Event:Connect(Update2))

end

