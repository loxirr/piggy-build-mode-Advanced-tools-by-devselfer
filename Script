		local CF = CFrame.new()
		ModelClon:PivotTo(CF*Offset)
		ApuntaCamaraToItem(ViewportFrame,ViewportFrame:FindFirstChildOfClass("Camera"),ModelClon)

		local TextLabel = newbutton:FindFirstChildOfClass("TextLabel")
		local FriendlyName = ObjectFolder:GetAttribute("FriendlyName") or Model:GetAttribute("FriendlyName") or ObjectFolder.Name
