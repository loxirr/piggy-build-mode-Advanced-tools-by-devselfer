--UI funcs
local UIFuncs = (function()
	local module = {}

	-- Guardamos la última posición válida (touch o mouse)
	local lastInputPosition = Vector2.new(0, 0)

	UserInputService.InputChanged:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseMovement
			or input.UserInputType == Enum.UserInputType.Touch then

			local pos = input.Position
			lastInputPosition = Vector2.new(pos.X, pos.Y) -- 🔥 FIX
		end
	end)

	UserInputService.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.Touch then
			local pos = input.Position
			lastInputPosition = Vector2.new(pos.X, pos.Y) -- 🔥 FIX
		end
	end)

	---------------------------------------------------------------
	-- 📌 1. POSICIÓN CRUDA (sin inset)
	----------------------------------------------------------------
	function module.GetPointerPosition(): Vector2
		-- En PC usamos el mouse directamente
		if UserInputService.MouseEnabled then
			return UserInputService:GetMouseLocation()
		end

		return lastInputPosition
	end

	----------------------------------------------------------------
	-- 📌 2. APLICAR GUI INSET CORRECTAMENTE
	----------------------------------------------------------------
	function module.ApplyGuiInset(position: Vector2, gui: ScreenGui?): Vector2
		if not gui then
			-- comportamiento por defecto (como Roblox)
			return position - GuiService:GetGuiInset()
		end

		if gui.IgnoreGuiInset then
			return position
		else
			return position - GuiService:GetGuiInset()
		end
	end
	function module.ApplyGuiInsetForced(position: Vector2): Vector2
		return position - GuiService:GetGuiInset()
	end

	local function GetObject(ObjectName:string):TextButton
		local Example = Examples:FindFirstChild(ObjectName)
		if not Example then
			error("No esta objeto imbecil, programa bien 🤓😭😭🥀🥀")
		end
		screenGuiJanitor:Add(Example)
		Example.Visible = true
		Example.Parent = nil
		return Example
	end

	local ScrollingFrameExampleToFuncs = Examples.ScrollingFrameExampleToFuncs
	screenGuiJanitor:Add(ScrollingFrameExampleToFuncs)
	ScrollingFrameExampleToFuncs.Visible = true
	ScrollingFrameExampleToFuncs.Parent = nil

	local function GetScrollingFrame(Frame:Frame)
		local ScrollingFrame = Frame:FindFirstChild("ScrollingFrameExampleToFuncs")
		if not ScrollingFrame then
			ScrollingFrame = ScrollingFrameExampleToFuncs:Clone()
			ScrollingFrame.Parent = Frame
		end
		return ScrollingFrame
