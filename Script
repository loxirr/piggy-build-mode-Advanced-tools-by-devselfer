	local function RemoveSelectedBlock(Model:Model,Index:number?,OmitirAspectoUpdate:boolean)
		if not Model then return end

		Index = Index or table.find(SelectedTargets,Model)
		if not Index then return end

		local Max = #SelectedTargets
		SelectedTargets[Index] = SelectedTargets[Max]
		SelectedTargets[Max] = nil

