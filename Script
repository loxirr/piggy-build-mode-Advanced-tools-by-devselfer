	local RedoState = false
	local RedoStateAnterior = false

	local DuplicatePool = Pooling.new(nil,"duplicate pool")
	--[[
	
	todo lo relacionado con acciones con el multiselect
	
	]]
	GlobalJanitor:AddConnection(Events.ConfigurationIsChanged.Event:Connect(function(id)
		if not PlayerCanBuild(Player) then return end
		ToolsWaitObject:SetCalculatePerFrame(Configurations.ReplicationPerFrame)
		if id == "RedoTask" then
			Redo()
		elseif id == "UndoTask" then
			Undo()
		elseif id == "DeleteTask" then

			if not ActualSelectedTargetingColor then return end
			if #SelectedTargets > 0 then
				if ToolsDisabled then return end
				ToolsDisabled = true
				OnToolsDisabledStateChanged:Fire()
				local information = table.clone(SelectedTargets)
				local UndoInformation = CreateUndoObject()
				UndoInformation.Type = "destroy"
				UndoInformation.Changes = {table.clone(SelectedTargets)}
				local InformationOfEliminated = UndoInformation.Changes
				for i = #information,1,-1 do
					local child = information[i]

					task.defer(function()
						InformationOfEliminated[#InformationOfEliminated+1] = {
							GetBlockType(child),
							child:GetPivot(),
							child:GetExtentsSize(),
							child:GetAttribute("Color"),
							child:GetAttribute("Material")
						}
						BuildFunctionsAdvanced.AdvancedDestroy(child,false)
					end)

					ToolsWaitObject:Wait()
				end

				PushUndoObject(UndoInformation)

				CreateBoxOfAllSelectedModels()
				ToolsDisabled = false
				OnToolsDisabledStateChanged:Fire()
			end
		elseif id == "DuplicateTask" then
			if not ActualSelectedTargetingColor then return end
			if #SelectedTargets > 0 then		
				DuplicatePool:Clean()
				--primeramente desactivar todas las demas herramientas
				if ToolsDisabled then return end
				ToolsDisabled = true
				OnToolsDisabledStateChanged:Fire()

				--clonar la tabla para evitar que el duplicado se modifique mientras se esta duplicando
				local TableToSelect = table.clone(SelectedTargets)

				--tablas que serviran para guardar los links de los bloques clonados
				local OldLinks2 = DuplicatePool:GetArray()
				local EndedTableToSelect = DuplicatePool:GetArray(nil,#TableToSelect,false)

				--informacion de undo
				local UndoInformation = CreateUndoObject()
				UndoInformation.Type = "add"
				UndoInformation.Changes = {TableToSelect}
				local cached = UndoInformation.Changes

				--deseleccionar todo
				DeselectAll()

				--clonar los bloques
				local Max = #TableToSelect
				for i, child in ipairs(TableToSelect) do
					EndedTableToSelect[i] = false
					--task spawn para empezar la peticion
					task.defer(function()

						--conseguir la informacion y crear el bloque
						local Pos = child:GetPivot()
						local Size = child:GetExtentsSize()
						local color = child:GetAttribute("Color")
						local material = child:GetAttribute("Material")
						local block = BuildFunctionsAdvanced.AdvancedBuild(
							GetBlockType(child),
							Pos,
							Size,
							color,
							material,
							true,
							false,
							child:FindFirstChild("Configuration")
						)

						--si el bloque se logro crear pues configurarlo y todo
						if block then
							if CheckIfIsLink(child) then
								OldLinks2[child] = block
							end

							AddSelectedBlock(block,true,true)

							table.insert(cached,{
								block,
								Pos,
								Size,
								color,
								material
							})
						end

						EndedTableToSelect[i] = true

						--si es el ultimo ciclo, empezar segundo procedimiento para conectar todos los links
						if i == Max then

							local function WaitForEnded(Table)
								local function CheckIfEnded()
									local allended = true
									for i = #Table, 1, -1 do
										if not Table[i] then
											allended = false
											break
										end
									end
									return allended
								end
								while not CheckIfEnded() do
									task.wait()
								end
							end

							WaitForEnded(EndedTableToSelect)

							if Configurations.CopiarConexionesAlDuplicar and next(OldLinks2) then

								Notification.Notify("Copying connections...")

								--tomar las configuraciones y y ponerlas en variables para evitar que el jugador cambie mientras se esta duplicando
								local ConectarDeInteriorAinterior = Configurations.CopiarConexionesDeInteriorAInterior	
								local ConectarDeInteriorAExterior = Configurations.CopiarConexionesDeInteriorAExterior
								local ConectarDeExteriorAInterior = Configurations.CopiarConexionesDeExteriorAinterior

								--crear tablas para guardar los links padres que se tendran que conectar al final de todo el proceso
								local ParentsLinks = DuplicatePool:GetArray()
								local index = 0
								for _,_ in pairs(OldLinks2) do
									index += 1
								end
								local Ended = DuplicatePool:GetArray(nil,index,false)
								local changingParentsLinks = false
								local function WaitForChangingParentsLinksBoolean()
									while changingParentsLinks do
										task.wait()
									end
								end

								index = 0
								for OldLink, NewLink in pairs(OldLinks2) do
									index += 1
									local actualindex = index
									Ended[actualindex] = false

									task.defer(function()

										-- =========================
										-- HIJOS (Child connections)
										-- =========================
										if ConectarDeInteriorAinterior 
											or ConectarDeInteriorAExterior then
											local NewLinkConnections = {}

											for _, child in ipairs(RemotesSimplificados.GetChildConnections(OldLink)) do
												local mapped = OldLinks2[child]

												if mapped then
													if ConectarDeInteriorAinterior then
														table.insert(NewLinkConnections, mapped)
													end
												else
													if ConectarDeInteriorAExterior then
														table.insert(NewLinkConnections, child)
													end
												end
											end

											RemotesSimplificados.SetConnections(NewLink, NewLinkConnections)
											table.clear(NewLinkConnections)
										end

										-- =========================
										-- PADRES (Parent connections)
										-- =========================
										if ConectarDeExteriorAInterior then
											for i, parentLink in ipairs(RemotesSimplificados.GetParentConnections(OldLink)) do
												if OldLinks2[parentLink] then continue end
												WaitForChangingParentsLinksBoolean()
												changingParentsLinks = true

												local parentConnections = ParentsLinks[parentLink]
												if not parentConnections then
													parentConnections = RemotesSimplificados.GetChildConnections(parentLink)
													ParentsLinks[parentLink] = parentConnections
													DuplicatePool:AddArray(parentConnections)
												end

												parentConnections[#parentConnections + 1] = NewLink
												changingParentsLinks = false
											end
										end

										Ended[actualindex] = true

									end)

									ToolsWaitObject:Wait()
								end

								WaitForEnded(Ended)

								if ConectarDeExteriorAInterior then
									local index = 0
									for _,_ in pairs(ParentsLinks) do 
										index += 1
									end
									local Ended2 = DuplicatePool:GetArray(nil,index,false)
									index = 0
									for ParentLink, ParentConnections in pairs(ParentsLinks) do 
										index += 1
										local actualindex = index
										Ended2[actualindex] = false
										task.defer(function()
											RemotesSimplificados.SetConnections(ParentLink, ParentConnections)
											Ended2[actualindex] = true
										end)
										ToolsWaitObject:Wait()
									end
									WaitForEnded(Ended2)
								end

								Notification.Notify("Connections copied!")
							end


							PushUndoObject(UndoInformation)

							CreateBoxOfAllSelectedModels()
							OnSelectedTargetsChanged:Fire()
							ToolsDisabled = false
							OnToolsDisabledStateChanged:Fire()
							DuplicatePool:Clean()
						end


					end)

					ToolsWaitObject:Wait()

				end
			end
		end
	end),nil,{Destruir = true})

