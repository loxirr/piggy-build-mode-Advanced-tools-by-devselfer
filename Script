			local child = PlayersModels[i]
			if not child or not child.Parent then 
				table.remove(PlayersModels,i)
				continue
			end
			table.insert(temp,child)
		end

		if IgnoreInvisibleBlocks then
			for i = #TransparentBlocks,1,-1 do
				local child = TransparentBlocks[i]
				if not child or not child.Parent then 
					table.remove(TransparentBlocks,i)
					continue
				end
				table.insert(temp,child)
			end
		else
			table.clear(TransparentBlocks)
		end

		RayCastParams.FilterDescendantsInstances = temp

		local MouseRay = CurrentCamera:ScreenPointToRay(Mouse.X, Mouse.Y)
		local RayCast = workspace:Raycast(MouseRay.Origin, MouseRay.Direction * 1000, RayCastParams)

		if not RayCast or not RayCast.Instance then return end

		local NewTarget = RayCast.Instance

		if IgnoreInvisibleBlocks and NewTarget.Transparency == 1 then
			AddObjectToExclude(NewTarget,TransparentBlocks)
		end

		for i = 1,3 do
			if not NewTarget or not NewTarget.Parent or not NewTarget:IsDescendantOf(BuildModel) then
				NewTarget = nil
				break
			end
			if NewTarget:IsA("Model") and NewTarget.PrimaryPart then
				break
			end
			NewTarget = NewTarget:FindFirstAncestorOfClass("Model")
		end

		if NewTarget then
			local MouseFilterPart = NewTarget:FindFirstChild("MouseFilterPart")
			if MouseFilterPart then
				MouseFilterPart:Destroy()
			end
		end

		return NewTarget
	end

	local function CreateInputs(Model:Model, Color,ModelToClone:Model,CenterPoint:boolean,Local:boolean)
		if not Model or not Model.Parent then return end
		if not ModelToClone then return end

		if CenterPoint == nil then
			CenterPoint = false
		end

		local _	,SizeClone = ModelToClone:GetBoundingBox()

		local cf, size = Model:GetBoundingBox()
		if not Local then
			cf = CFrame.new(cf.Position)
		end

		local MaxSize = math.max(SizeClone.X,SizeClone.Y,SizeClone.Z)
		local Offsets = Vector3.new(
			size.X/2,size.Y/2,size.Z/2
		) + Vector3.new(MaxSize,MaxSize,MaxSize)

		local BordersConfig = {

			-- offset X
			{NewCFrame = (cf*CFrame.Angles(0,0,math.rad(90))) * CFrame.new(0,Offsets.X,0)},
			{NewCFrame = (cf*CFrame.Angles(0,0,-math.rad(90))) * CFrame.new(0,Offsets.X,0)},

			-- offset Y
			{NewCFrame = (cf*CFrame.Angles(0,0,0)) * CFrame.new(0,Offsets.Y,0)},
			{NewCFrame = (cf*CFrame.Angles(math.rad(-180),0,0)) * CFrame.new(0,Offsets.Y,0)},

			-- offset Z
			{NewCFrame = (cf*CFrame.Angles(math.rad(90),0,0)) * CFrame.new(0,Offsets.Z,0)},
			{NewCFrame = (cf*CFrame.Angles(-math.rad(90),0,0)) * CFrame.new(0,Offsets.Z,0)},

			{NewCFrame = cf}
		}

		local Clones = {}
		for index = 1, 6 + ((CenterPoint and 1) or 0) do
			local config = BordersConfig[index]

			local Clone = Model:FindFirstChild("Input" .. tostring(index))
			if not Clone then

				if index == 7 then
					Clone = Instance.new("Model")
					local Part = Instance.new("Part")
					Part.Parent = Clone
					Part.Size = Vector3.new(0.4,0.4,0.4)
					Part.Transparency = 0
					Part.CanCollide = false
					Part.Anchored = true
				else
					Clone = ModelToClone:Clone()
				end
				local InitialCFrame = config.NewCFrame

				local function CalculateDistance()
					local ClonePosition = Clone:GetPivot().Position
					local CameraPosition = CurrentCamera.CFrame.Position
					local Distance = (ClonePosition - CameraPosition).Magnitude
					Clone:ScaleTo(Distance/15)
					if index == 7 then
						Clone:PivotTo(InitialCFrame)
					else
						Clone:PivotTo(InitialCFrame * CFrame.new(0,Distance/15,0))
					end
				end

				CalculateDistance()

				Clone:AddTag("Input")
				screenGuiJanitor:Add(Clone)

				Clone.Parent = Model
				Clone.Name = "Input" .. tostring(index)

				for i, child in ipairs(Clone:GetDescendants()) do
					if child:IsA("BasePart") and not child:HasTag("Input") then
						child:AddTag("Input")
					end
				end

				local JanitorObject = Janitor.new()

				JanitorObject:Add(RunService.Heartbeat:Connect(function(Property)
					CalculateDistance()
				end))

				Clone.Destroying:Connect(function()
					JanitorObject:Destroy()
				end)

			end

			table.insert(Clones,Clone)

			for i, Part in ipairs(Clone:GetDescendants()) do
				if Part:IsA("BasePart") then
					AddHighlightToModel(
						Part,
						Color,
						Color,
						0,
						0
					)
				end
			end
		end

		table.clear(BordersConfig)

		return Clones
	end

	local function GetInputTarget(Inputs)
		if not Inputs then warn("nil") return end

		local RayCastParams = RaycastParams.new()
		RayCastParams.FilterType = Enum.RaycastFilterType.Include
		local temp = {}
