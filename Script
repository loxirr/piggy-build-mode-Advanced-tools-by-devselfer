	local script = DebugModuleFolder
	
	do
		local InstancesTable = {}
		table.clear(InstancesTable)
	end
	
	local module = {}
	
	module.DebugState = false
	
	
	
	function module.SetGeneralDebugState(State)
		module.DebugState = State
		print("DebugState: ",module.DebugState)
	end
	
	function module.AdvancedDebugPrint(SecondCondition:boolean?,Name:string,...)
		if not SecondCondition and not module.DebugState then return end
		local DataToPrint = {...}
		local FinalString = "\n"
		for i, child in ipairs(DataToPrint) do
			FinalString =  FinalString .. tostring(child) .. "\n"
		end
		local Data = {}
	
		for Index = 2, 1000 do
			local source = debug.info(Index, "s")
			local line = debug.info(Index, "l")
			local msg = debug.info(Index, "n")
	
			if msg and #msg == 0 then
				msg = "Unknown"
			end
	
			if not source or not line or not msg then break end
	
			Data[Index-1] = {
				line = line,
				msg = msg,
				source = source,
			}
		end
		for i, v in Data do
			FinalString = FinalString .. string.format("%d -> %s",
				v.line,
				v.msg
			) .. "\n"
		end
		print("[" .. Name .. "]" .. FinalString)
		table.clear(DataToPrint)
	
	end
	
	function module.NormalDebugPrint(Condition:boolean,Name:string,...)
		if not Condition and not module.DebugState then return end
		local DataToPrint = {...}
		local FinalString = "|"
		for i, child in ipairs(DataToPrint) do
			FinalString =  FinalString .. tostring(child) .. "|"
		end
		print("[" .. Name .. "]: " .. FinalString)
	end
	
	return module
end)()
