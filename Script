	local MenuRemoverExample = GetObject("MenuRemoverExample")

	function module.AddMenuRemover(Frame:Frame)
		local ScrollingFrame = GetScrollingFrame(Frame)
		local MenuRemover = ScrollingFrame:FindFirstChild("MenuRemoverExample")
		if not MenuRemover then
			MenuRemover = MenuRemoverExample:Clone()
			MenuRemover.Parent = ScrollingFrame

			screenGuiJanitor:Add(MenuRemover.MouseButton1Up:Connect(function()
				Frame.Visible = false
			end))
		end
		return MenuRemover
	end

	local MenuDraggerExample = GetObject("MenuDraggerExample")

	function module.AddMenuDragger(Frame:Frame)
		local ScrollingFrame = GetScrollingFrame(Frame)
		local MenuDragger = ScrollingFrame:FindFirstChild("MenuDraggerExample")
		if not MenuDragger then
			MenuDragger = MenuDraggerExample:Clone()
			MenuDragger.Parent = ScrollingFrame

			local Dragging = false
			local InitialPosition
			local InitialMousePos

			MenuDragger.MouseButton1Down:Connect(function(input)
				Dragging = true
			end)

			UserInputService.InputEnded:Connect(function(input)
				if not (
					input.UserInputType == Enum.UserInputType.MouseButton1 or 
						input.UserInputType == Enum.UserInputType.Touch
					) 
				then
					return
				end
				Dragging = false
				InitialPosition = nil
				InitialMousePos = nil
			end)

			UserInputService.InputChanged:Connect(function(input)
				if not (
					input.UserInputType == Enum.UserInputType.MouseMovement or 
						input.UserInputType == Enum.UserInputType.Touch
					) 
				then
					return
				end
				if Dragging then
					if not InitialMousePos then
						InitialMousePos = module.GetPointerPosition()
						InitialPosition = Frame.Position
					end
					local ActualMousePosition = module.GetPointerPosition()
					local Delta = ActualMousePosition - InitialMousePos

					local NewPosition = InitialPosition + UDim2.new(
						0, Delta.X, 
						0, Delta.Y
					)

					Frame.Position = NewPosition
				end
			end)
		end
		return MenuDragger
	end

	local MenuResizerExample = GetObject("MenuResizerExample")

	function module.AddMenuResizer(Frame:Frame)
		local ScrollingFrame = GetScrollingFrame(Frame)
		local MenuResizer = ScrollingFrame:FindFirstChild("MenuResizerExample")
		if not MenuResizer then
			MenuResizer = MenuResizerExample:Clone()
			MenuResizer.Parent = ScrollingFrame

			local Dragging = false
			local InitialSize
			local InitialMousePos

			MenuResizer.MouseButton1Down:Connect(function(input)
				Dragging = true
			end)

			UserInputService.InputEnded:Connect(function(input)
				if not (
					input.UserInputType == Enum.UserInputType.MouseButton1 or 
						input.UserInputType == Enum.UserInputType.Touch
					) 
				then
					return
				end
				Dragging = false
				InitialSize = nil
				InitialMousePos = nil
			end)

			UserInputService.InputChanged:Connect(function(input)
				if not (
					input.UserInputType == Enum.UserInputType.MouseMovement or 
						input.UserInputType == Enum.UserInputType.Touch
					) 
				then
					return
				end
				if Dragging then
					if not InitialMousePos then
						InitialMousePos = module.GetPointerPosition()
						InitialSize = Frame.Size
					end
					local ActualMousePosition = module.GetPointerPosition()
					local Delta = ActualMousePosition - InitialMousePos

					local NewSize = InitialSize + UDim2.new(
						0, Delta.X, 
						0, -Delta.Y
					)

					Frame.Size = NewSize
				end
			end)
		end
		return MenuResizer
	end

	local MinimizeExample = GetObject("MinimizeExample")
	local MaximixeExample = GetObject("MaximixeExample")

	function module.AddMenuMinimizer(Frame:Frame)
		local ScrollingFrame = GetScrollingFrame(Frame)
		local MenuMinimizer = ScrollingFrame:FindFirstChild("MinimizeExample") :: TextButton
		if not MenuMinimizer then
			MenuMinimizer = MinimizeExample:Clone()
			MenuMinimizer.Parent = ScrollingFrame

			MenuMinimizer.MouseButton1Click:Connect(function()
				Frame.Visible = not Frame.Visible
				local Cloned = MaximixeExample:Clone()
				Cloned.Position = UDim2.fromOffset(
					Frame.AbsolutePosition.X,
					Frame.AbsolutePosition.Y
				)
				Cloned.Parent = ScreenGui
				screenGuiJanitor:Add(Cloned)
				Cloned.MouseButton1Click:Connect(function()
					Frame.Visible = true
					Cloned:Destroy()
				end)
			end)
		end
		return MenuMinimizer
	end

	local ActualmenteViendo = nil
	local ExtraInformationTextlabel = ScreenGui.ExtraInformation
	--Funcion para hacer que el frame otorgado tenga un mensaje de informacion
	function module.SetExtraInformationMessage(Frame:GuiButton,Information:string)

		Information = Information or ""

		local function OnMouseEnter()
			ActualmenteViendo = Frame
			ExtraInformationTextlabel.Visible = true
			ExtraInformationTextlabel.Text = Frame:GetAttribute("ExtraInformation")
		end

		if Frame:GetAttribute("ExtraInformation") then 
			Frame:SetAttribute("ExtraInformation",Information)	

			if ActualmenteViendo == Frame then
				OnMouseEnter()
			end

			return
		end
		Frame:SetAttribute("ExtraInformation",Information)

		Frame.MouseEnter:Connect(OnMouseEnter)
		Frame.MouseLeave:Connect(function()
			ActualmenteViendo = nil
			ExtraInformationTextlabel.Visible = false
		end)

	end

	--Funcion para obtener en que porcentaje esta el mouse en una barra de progreso
	function module.GetMousePercentageInBar(bar: GuiObject): number
		local mousePos = module.ApplyGuiInset(module.GetPointerPosition(),ScreenGui)
		return math.clamp((mousePos.X - bar.AbsolutePosition.X) / bar.AbsoluteSize.X, 0, 1)
	end

	return module
end)()

