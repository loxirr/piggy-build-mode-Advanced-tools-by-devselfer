			if ActualClonedModel then
				ActualClonedModel:Destroy()
				ActualClonedModel = nil
			end
		end

		local function CreateClonedModel()

			if ActualClonedModel and ActualClonedModel.Parent then
				if ActualClonedModel.Name ~= ActualCreationModel.Name then 
					DestroyClonedModel()
				else
					return ActualClonedModel
				end
			end

			ActualClonedModel = ActualCreationModel:Clone()
			ActualClonedModel.Parent = workspace
			ActualClonedModelSize = ActualClonedModel.PrimaryPart.Size

			UpdateClonedModel()

