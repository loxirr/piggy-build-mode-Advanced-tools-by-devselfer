--Janitor EZ
local Janitor = (function()
	local Janitor = {}

	local JanitorObj = {}
	function JanitorObj.Add(self:JanitorObj,obj, method)
		table.insert(self.Tasks, {obj, method})
		return obj
	end

	function JanitorObj.Cleanup(self:JanitorObj)
		for i = #self.Tasks, 1, -1 do
			local obj, method = unpack(self.Tasks[i])

			if typeof(obj) == "RBXScriptConnection" then
				obj:Disconnect()

			elseif typeof(obj) == "Instance" then
				obj:Destroy()

			elseif type(obj) == "thread" then
				task.cancel(obj)

			elseif method and obj[method] then
				obj[method](obj)

			elseif type(obj) == "function" then
				obj()
			end
		end
		table.clear(self.Tasks)
	end

	function JanitorObj.Destroy(self:JanitorObj)
		self:Cleanup()
		setmetatable(self, nil)
		for k, _ in pairs(self) do
			self[k] = nil
		end
		self = nil
	end

	function Janitor.new()
		return setmetatable({
			Tasks = {}
		}, {__index = JanitorObj}) :: JanitorObj
	end

	type Janitor = typeof(Janitor) & {

	}

	type JanitorObj = typeof(JanitorObj) & {

	}

	return Janitor :: Janitor
end)()

--basic build functions
local BuildFunctions = (function() 
	local Functions = {}

	local Folder = ReplicatedStorage:FindFirstChild("Functions")

	local BuildRemote = Folder:FindFirstChild("PlaceBlock")
	local DestroyRemote = Folder:FindFirstChild("DestroyBlock")
	local ResizeRemote = Folder:FindFirstChild("CommitResize")
	local MoveRemote = Folder:FindFirstChild("CommitMove")
	local FillRemote = Folder:FindFirstChild("FillBlock")

	function Functions.Build(
		block:Model,
		Position:CFrame,
		Color:BrickColor,
		Material:Enum.Material
	)
		return BuildRemote:InvokeServer(
			block,
			Position,
			Color,
			Material
		)

	end

	function Functions.Fill(
		block:Model,
		Color:BrickColor,
		Material:Enum.Material
	)
		return FillRemote:InvokeServer(
			block,
			Color,
			Material
		)
	end

	function Functions.GetConfigs(
		block:Model
	): (BrickColor,string)
		return block:GetAttribute("Color"), block:GetAttribute("Material")
	end

	function Functions.Destroy(
		block:Model
	)
		return DestroyRemote:InvokeServer(
			block
		)

	end

	function Functions.Resize(
		block:Model,
		Position:CFrame,
		Size:Vector3
	)
		local ColorPart = block:FindFirstChild("ColorPart",true)
		if not ColorPart then
			for i, child in ipairs(block:GetChildren()) do
				if child:IsA("BasePart") then
					ColorPart = child
					break
				end
			end
		end

		local success, data = pcall(function()			
			return ResizeRemote:InvokeServer(
				block,
				{
					ColorPart,
					Position,
					Size
				}
			)
		end)
		if success then
			return data
		else
			warn("Error al redimensionar el bloque:", data) -- Muestra el mensaje de error
		end

	end

	function Functions.Move(
		block:Model,
		Position:CFrame
	)
		return MoveRemote:InvokeServer(
			block,
			Position
		)

	end

	return Functions
end)()

