		function module.CreateKeybindSetting(Page:GuiObject,name:string,description:string)
			local connection = {}

			local Frame = ControlExample:Clone()
			Frame.Parent = Page
			Page.LayoutOrder += 1
			Frame.LayoutOrder = Page.LayoutOrder

			local Label = Frame:FindFirstChild("Label") :: TextLabel

			Label.Text = name
			UIFuncs.SetExtraInformationMessage(Frame,description)

			local Folder = Frame:FindFirstChildOfClass("Folder")

			local FirstControl = Folder:FindFirstChild("FirstControl") :: TextButton
			local SecondControl = Folder:FindFirstChild("SecondControl") :: TextButton
			local ThirdControl = Folder:FindFirstChild("ThirdControl") :: TextButton

			local FirstControlIsChanging = false
			local SecondControlIsChanging = false
			local ThirdControlIsChanging = false

			connection.ActualControls = {}
			connection.OnControlChanged = EventModule.GetEvent()

			function connection.Update(NewControls:{Enum.KeyCode})
				local Controls = connection.ActualControls

				local FirstKeybind = NewControls[1]
				local SecondKeybind = NewControls[2]
				local ThirdKeybind = NewControls[3]

				if 
					FirstKeybind == Controls[1] and
					SecondKeybind == Controls[2] and
					ThirdKeybind == Controls[3] 
				then 
					return 
				end

				FirstControl.Text = FirstKeybind and FirstKeybind.Name or "No Key"
				SecondControl.Text = SecondKeybind and SecondKeybind.Name or "No Key"
				ThirdControl.Text = ThirdKeybind and ThirdKeybind.Name or "No Key"

				connection.ActualControls = {FirstKeybind,SecondKeybind,ThirdKeybind}
				connection.OnControlChanged:Fire(connection.ActualControls)
			end

			screenGuiJanitor:Add(FirstControl.MouseButton1Down:Connect(function()
				SecondControlIsChanging = false
				ThirdControlIsChanging = false
				FirstControlIsChanging = true
			end))

			screenGuiJanitor:Add(SecondControl.MouseButton1Down:Connect(function()
				FirstControlIsChanging = false
				ThirdControlIsChanging = false
				SecondControlIsChanging = true
			end))

			screenGuiJanitor:Add(ThirdControl.MouseButton1Down:Connect(function()
				FirstControlIsChanging = false
				SecondControlIsChanging = false
				ThirdControlIsChanging = true
			end))

			screenGuiJanitor:Add(UserInputService.InputBegan:Connect(function(Input)

				local KeyCode = Input.KeyCode
				local UserInputType = Input.UserInputType

				if 
					UserInputType == Enum.UserInputType.MouseMovement or
					UserInputType == Enum.UserInputType.MouseButton1 or
					UserInputType == Enum.UserInputType.MouseButton2 or
					UserInputType == Enum.UserInputType.MouseButton3 or
					UserInputType == Enum.UserInputType.MouseWheel
				then
					return
				end

				if KeyCode == Enum.KeyCode.Backspace or KeyCode == Enum.KeyCode.Unknown then
					KeyCode = nil
				end

				if FirstControlIsChanging then
					connection.ActualControls[1] = KeyCode
					FirstControl.Text = KeyCode and KeyCode.Name or "No key"
					FirstControlIsChanging = false
					connection.OnControlChanged:Fire(connection.ActualControls)
				elseif SecondControlIsChanging then
					connection.ActualControls[2] = KeyCode
					SecondControl.Text = KeyCode and KeyCode.Name or "No key"
					SecondControlIsChanging = false
					connection.OnControlChanged:Fire(connection.ActualControls)
				elseif ThirdControlIsChanging then
					connection.ActualControls[3] = KeyCode
					ThirdControl.Text = KeyCode and KeyCode.Name or "No key"
					ThirdControlIsChanging = false
					connection.OnControlChanged:Fire(connection.ActualControls)
				end

			end))

			screenGuiJanitor:Add(connection)

			return connection
		end

