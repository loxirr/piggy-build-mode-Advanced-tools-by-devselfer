					end
				end
			end),nil,{Destruir = true})
		end

		--Rotar
		do

			local Handles

			local function CreateHandles()
				if not PlayerCanBuild(Player) then return end

				if Handles then
					Handles:Destroy()
					Handles = nil
				end

				if ToolsDisabled then return end

				local Act = SelectedTargets[#SelectedTargets]
				if not Act then
					return
				end
				
				local InitialPivot = Act:GetPivot()
				local Center,_ = GetCenter()
				for i, child in ipairs(SelectedTargets) do
					child:SetAttribute("InitialCFrame",child:GetPivot())
				end

				Handles = Instance.new("ArcHandles")
				Handles.Parent = PlayerGui
				Handles.Adornee = BoxOfAllSelectedModels

				local HandleJanitor = Janitor.new("position handle janitor")
				GlobalJanitor:AddJanitor(HandleJanitor,nil,{Destruir = true, DestruirTarget = true})
				HandleJanitor:LinkToInstance(Handles,nil,{Destruir = true, DestroyInstance = true})

				HandleJanitor:AddTask(function()
					MultiSelectEnabled = true
				end,nil,{Destruir = true})

				HandleJanitor:AddConnection(OnToolsDisabledStateChanged.Event:Connect(function()
					if ToolsDisabled and HandleJanitor then
						HandleJanitor:Destroy()
					end
				end),nil,{Destruir = true})

				HandleJanitor:AddConnection(Handles.MouseButton1Up:Connect(function()
					Mobile.SensibilityState(true)
					UIFuncs.CloseExtraInformation()

					MultiSelectEnabled = true
					UpdateBox = true
					local FinalRotationAct = Act:GetPivot().Rotation :: CFrame
					local InitialRotationAct = InitialPivot.Rotation :: CFrame
					local Diference = (Vector3.new(InitialRotationAct:ToEulerAnglesYXZ()) - Vector3.new(FinalRotationAct:ToEulerAnglesYXZ())).Magnitude
					if Diference <= 0 then
						return
					end

					if ToolsDisabled then return end
					ToolsDisabled = true
					OnToolsDisabledStateChanged:Fire()
					if HandleJanitor then
						HandleJanitor:Destroy()
						HandleJanitor = nil
					end

					local UndoInformation = CreateUndoObject()
					UndoInformation.Type = "modification"
					local cloned = table.clone(SelectedTargets)
					UndoInformation.Changes = {
						cloned,
					}
					local cached = UndoInformation.Changes
					ToolsWaitObject:SetCalculatePerFrame(Configurations.ReplicationPerFrame)
					for i, child in ipairs(cloned) do
						table.insert(cached,{
							child,
							child:GetAttribute("InitialCFrame"),
							child:GetExtentsSize(),
							child:GetAttribute("Color"),
							child:GetAttribute("Material")
						})
						task.defer(function()
							BuildFunctionsAdvanced.AdvancedModification(
								child,
								child:GetPivot(),
								nil,
								nil,
								nil,
								false
							)
						end)
						ToolsWaitObject:Wait()
					end
					PushUndoObject(UndoInformation)
					CreateBoxOfAllSelectedModels()

					ToolsDisabled = false
					OnToolsDisabledStateChanged:Fire()
				end),nil,{Destruir = true})

				HandleJanitor:AddConnection(Handles.MouseButton1Down:Connect(function()
					Mobile.SensibilityState(false)
					UpdateBox = false
					MultiSelectEnabled = false
					InitialPivot = Act:GetPivot()
					Center,_ = GetCenter()
					for i, child in ipairs(SelectedTargets) do
						child:SetAttribute("InitialCFrame",child:GetPivot())
					end
				end),nil,{Destruir = true})

				HandleJanitor:AddConnection(Handles.MouseDrag:Connect(function(axis, angle)

					local Vec

					if ActualToolGridState and ActualRotationGrid > 0 then
						angle = SnapToGrid(angle, math.rad(ActualRotationGrid))
					end

					if axis == Enum.Axis.X then
						Vec = Vector3.new(1,0,0)
					elseif axis == Enum.Axis.Y then
						Vec = Vector3.new(0,1,0)
					elseif axis == Enum.Axis.Z then
						Vec = Vector3.new(0,0,1)
					end

					if Configurations.PrecisionMode then
						angle /= 10
					end

					local rotation = CFrame.fromAxisAngle(Vec, angle)

					if Configurations.RotarIndividualmente then
						for _, child in ipairs(SelectedTargets) do
							local InitialCFrame = child:GetAttribute("InitialCFrame")
							local newRotation = rotation * InitialCFrame.Rotation
							child:PivotTo(
								CFrame.new(
									InitialCFrame.Position
								) * newRotation
							)
						end
					else
						local center
						if Configurations.RotarseDesdeCentro then
							center = Center
						else
							center = InitialPivot.Position
						end
						for _, child in ipairs(SelectedTargets) do
							local InitialCFrame = child:GetAttribute("InitialCFrame")

							local offset = InitialCFrame.Position - center
							local rotatedOffset = rotation:VectorToWorldSpace(offset)

							local newPosition = center + rotatedOffset
							local newRotation = rotation * InitialCFrame.Rotation

							child:PivotTo(CFrame.new(newPosition) * newRotation)
						end	
					end

					local orientation = Act:GetPivot() :: CFrame
					local Rotacion = Vector3.new(orientation:ToEulerAnglesXYZ())
					UIFuncs.OpenExtraInformation()
					UIFuncs.SetTextToExtraInformation(
						tostring(math.round(math.deg(Rotacion.X)*1000)/1000) .. ", " ..
							tostring(math.round(math.deg(Rotacion.Y)*1000)/1000) .. ", " ..
							tostring(math.round(math.deg(Rotacion.Z)*1000)/1000)
					)
					CreateBoxOfAllSelectedModels()
				end),nil,{Destruir = true})
			end

			GlobalJanitor:AddConnection(Events.StateChanged.Event:Connect(function()
				if ActualState == "rote" then
					TargetingEnabled = true
					ActualSelectedTargetingColor = Configurations.roteSelectedColor
					ActualTargetingBorderColor = Configurations.roteBaseColor
					ActualHandleFunc = CreateHandles
					ChangeSelectingStateOfNewBlocks = true
					LocalStateInBox =  false
					MultiSelectEnabled = true
					UpdateBox = true
					UpdateBorders()
					CreateHandles()
					CreateBoxOfAllSelectedModels()
				else
					if Handles then
						Handles:Destroy()
						Handles = nil
					end
				end
			end),nil,{Destruir = true})
		end

	end
end

