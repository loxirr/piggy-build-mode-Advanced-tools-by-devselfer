	local function GetPlayerUI(TargetedPlayer:Player,NoUpdateTeams:boolean?)
		local PlayerData = GetPlayerData(TargetedPlayer)
		local PlayerJanitor = GetPlayerJanitor(TargetedPlayer)
		local UI = PlayerData.UI
		if not UI then
			UI = PlayerExample:Clone()
			PlayerData.UI = UI
			UI.Principal.PlayerIcon.Image = GetPlayerIcon(TargetedPlayer)
	
			local TempJanitor = Janitor.new()
	
			---
	
			PlayerListJanitor:AddJanitor(TempJanitor,nil,{
				Destruirtarget = true,
				Destruir = true
			})
	
			---
	
			local DisplayName = TargetedPlayer.DisplayName
			local Name = TargetedPlayer.Name
			if Name == DisplayName then
				UI.Principal.PlayerInformation.PlayerName.Text = DisplayName
			else
				local Textlabel = UI.Principal.PlayerInformation.PlayerName
				Textlabel.Text = DisplayName
				TempJanitor:AddConnection(Textlabel.MouseEnter:Connect(function()
					Textlabel.Text = "@" .. Name 
				end),nil,{Destruir = true})
				TempJanitor:AddConnection(Textlabel.MouseLeave:Connect(function()
					Textlabel.Text = DisplayName
				end),nil,{Destruir = true})
			end
			UI.Name = Name
	
			TempJanitor:AddConnection(UI.MouseButton1Up:Connect(function()
				local function CloseMenu()
					ButtonTempJanitor:Cleanup()
					PlayerMenu.Name = ""
					PlayerMenu.Visible = false
				end
				if PlayerMenu.Name == TargetedPlayer.Name then
					CloseMenu()
					return
				else
					ButtonTempJanitor:Cleanup()
					PlayerMenu.Name = TargetedPlayer.Name
					PlayerMenu.Visible = true
	
					PlayerMenu.Position = UDim2.fromOffset(
						UI.AbsolutePosition.X - PlayerMenu.AbsoluteSize.X - 20,
						UI.AbsolutePosition.Y
					)
					ButtonTempJanitor:AddConnection(UI.Changed:Connect(function(Pro)
						if Pro == "AbsolutePosition" then
							PlayerMenu.Position = UDim2.fromOffset(
								UI.AbsolutePosition.X - PlayerMenu.AbsoluteSize.X - 20,
								UI.AbsolutePosition.Y
							)
						end
					end),nil,{})
	
					local PlayerIsInMenu = true
					ButtonTempJanitor:AddConnection(PlayerMenu.MouseEnter:Connect(function()
						PlayerIsInMenu = true
					end),nil,{})
					ButtonTempJanitor:AddConnection(PlayerMenu.MouseLeave:Connect(function()
						PlayerIsInMenu = false
					end),nil,{})
					ButtonTempJanitor:AddConnection(UI.MouseEnter:Connect(function()
						PlayerIsInMenu = true
					end),nil,{})
					ButtonTempJanitor:AddConnection(UI.MouseLeave:Connect(function()
						PlayerIsInMenu = false
					end),nil,{})
					ButtonTempJanitor:AddConnection(UserInputService.InputBegan:Connect(function(imp)
						if PlayerIsInMenu then return end
						if imp.UserInputType == Enum.UserInputType.MouseButton1 or imp.UserInputType == Enum.UserInputType.Touch then
							CloseMenu()
						end
					end),nil,{})
	
					local FinalText
					local DisplayName = TargetedPlayer.DisplayName
					local Name = TargetedPlayer.Name
					if Name == DisplayName then
						FinalText = DisplayName
					else
						FinalText = DisplayName .. " (@" .. Name .. ")"
					end
					PlayerMenu.PlayerInformation.PlayerIcon.Image = GetPlayerIcon(TargetedPlayer)
					PlayerMenu.PlayerInformation.PlayerName.Text = FinalText
	
					for i, child in ipairs(ButtonsFunctions) do
						local SuccessFunction = child[1]
						local success,ExtraResult1,ExtraResult2
						if SuccessFunction then
							success,ExtraResult1,ExtraResult2 = SuccessFunction(TargetedPlayer)
							if not success then continue end
						end
	
						local Type = child[2]
	
						if Type == "Button" then
							local Name = child[3]
							local Icon = child[4]
							local Order = child[5]
							local func = child[6]
	
							local Clone = ExampleButton:Clone()
							Clone.Name = Name
							Clone.TextLabel.Text = Name
							if Icon then
								Clone.ImageLabel.Image = "rbxassetid://" .. Icon
							else
								Clone.ImageLabel.Visible = false
							end
							Clone.LayoutOrder = Order
							Clone.Parent = PlayerMenu
							ButtonTempJanitor:AddConnection(Clone.MouseButton1Up:Connect(function()
								func(TargetedPlayer)
							end),nil,{})
							ButtonTempJanitor:AddInstance(Clone,nil,{})
						elseif Type == "Toggle" then
							local Name = child[3]
							local Icon = child[4]
							local Order = child[5]
							local func = child[6]
	
							local actualState = ExtraResult1
	
							local Clone = ToggleExample:Clone()
							Clone.Name = Name
							Clone.TextLabel.Text = Name
							if Icon then
								Clone.ImageLabel.Image = "rbxassetid://" .. Icon
							else
								Clone.ImageLabel.Visible = false
							end
							Clone.LayoutOrder = Order
							Clone.Parent = PlayerMenu
	
							local But = Clone.TogglePart
							local Circulo = But.MiniToggle
	
							local function UpdateToggle()
								if actualState then
									Circulo.Position = UDim2.fromScale(1,0.5)
									Circulo.AnchorPoint = Vector2.new(1,0.5)
								else
									Circulo.Position = UDim2.fromScale(0,0.5)
									Circulo.AnchorPoint = Vector2.new(0,0.5)
								end
							end
							UpdateToggle()
	
							ButtonTempJanitor:AddConnection(But.MouseButton1Up:Connect(function()
								actualState = not actualState
								UpdateToggle()
								func(TargetedPlayer,actualState)
							end),nil,{})
							ButtonTempJanitor:AddInstance(Clone,nil,{})
						elseif Type == "Separator" then
							local Clone = SeparatorExample:Clone()
							Clone.Parent = PlayerMenu
							Clone.LayoutOrder = child[3]
							ButtonTempJanitor:AddInstance(Clone,nil,{})
						end
	
					end
	
				end
			end),nil,{Destruir = true})
	
			module.GetIconsEvent:Fire(TargetedPlayer)
	
		end
		return UI
	end
	
