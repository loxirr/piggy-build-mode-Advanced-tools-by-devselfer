		{modelsMenu,modelsButton},
		{toolsMenu,toolsButton},
		{colorMenu,colorButton},
		{materialMenu,materialButton},
		{settingsMenu,settingsButton},
	}

	local ActualMenu = nil
	local BlockMenuChange = false

	for i, child in ipairs(Menus) do
		local Menu = child[1]

		Menu.Visible = false

		UIFuncs.AddMenuRemover(Menu)
		UIFuncs.AddMenuResizer(Menu)
		UIFuncs.AddMenuDragger(Menu)
	end

	local function SetMenusVisible(ActualMenuFunc,State)
		for i, child in ipairs(Menus) do
			local Menu = child[1]

			if Menu == ActualMenuFunc then 
				if ToolBar.Visible then
					local newstate
					if State == nil then
						newstate = not Menu.Visible
					else
						newstate = State
					end
					Menu.Visible = newstate
					if newstate then
						ActualMenu = Menu
					else
						ActualMenu = nil
					end
				else
					Menu.Visible = false
				end
			else
				Menu.Visible = false
			end
		end
	end

	local function ConvertNumberToString(Number)
		if Number == 1 then
			return "One"
		elseif Number == 2 then
			return "Two"
		elseif Number == 3 then
			return "Three"
		elseif Number == 4 then
			return "Four"
		elseif Number == 5 then
			return "Five"
		elseif Number == 6 then
			return "Six"
		elseif Number == 7 then
			return "Seven"
		elseif Number == 8 then
			return "Eight"
		elseif Number == 9 then
			return "Nine"
		end
	end
	for i, child in ipairs(Menus) do
		local Menu = child[1]
		local Button = child[2]
		AddToClean(Menu.Changed:Connect(function(propertie)
			if propertie == "Visible" then
				local state = Menu.Visible

				if Menu == toolsMenu then
					if state then
						BlockMenuChange = true
					else
						task.delay(0.1,function()
							BlockMenuChange = false
						end)
					end
				end

				if state then
					ActualMenu = Menu
				elseif ActualMenu == Menu then
					ActualMenu = nil
				end
			end
		end))
		AddToClean(Button.MouseButton1Up:Connect(function()
			SetMenusVisible(Menu)
		end))

		local numbertostring = ConvertNumberToString(Button.LayoutOrder)

		AddToClean(UserInputService.InputBegan:Connect(function(input,gameprocessedevent)

			if gameprocessedevent or BlockMenuChange then return end

			if input.KeyCode == Enum.KeyCode[numbertostring] then
				SetMenusVisible(Menu)
			end
		end))
	end

	--Boton de modelos
	local ViewPortFrame = modelsButton:FindFirstChildOfClass("ViewportFrame")
	local Camera = ViewPortFrame:FindFirstChildOfClass("Camera") or Instance.new("Camera",ViewPortFrame)
	ViewPortFrame.CurrentCamera = Camera
	Camera.FieldOfView = 10
	local function Update()
		local newmodel = ActualCreationModel:Clone()
		local oldmodel = ViewPortFrame:FindFirstChildOfClass("Model")
		if oldmodel then
			oldmodel:Destroy()
		end
		newmodel.Parent = ViewPortFrame

		local HasNoTransparentParts = false
		local descendants = newmodel:GetDescendants()
		for i, child in ipairs(descendants) do
			if child:IsA("BasePart") and child.Transparency < 1 then
				HasNoTransparentParts = true
				break
			end
		end

		if HasNoTransparentParts then
			for i, child in ipairs(descendants) do
				if child:IsA("BasePart") and child.Transparency >= 1 then
					child:Destroy()
				end
			end
		end

		newmodel.PrimaryPart = nil
		newmodel:PivotTo(CFrame.new())
		local center,size = newmodel:GetBoundingBox()
		local Offset = center:Inverse()
		local CF = CFrame.new()
		newmodel:PivotTo(CF*Offset)
		ApuntaCamaraToItem(ViewPortFrame,Camera,newmodel)

		local Rotacion = 0
		AddToClean(RunService.Heartbeat:Connect(function(delta)
			Rotacion += math.rad(delta*45)
			newmodel:PivotTo(
				(CF * CFrame.Angles(0,Rotacion,0)) * Offset
			)
		end))

		for i, child in ipairs(newmodel:GetDescendants()) do
			if child:IsA("BasePart") and (child.Name == "ColorPart" or child:HasTag("Colorable")) then
				child.BrickColor = ActualBrickColor
				child.Material = ActualMaterial
			end
		end

	end
	AddToClean(Events.ModelChanged.Event:Connect(Update))
	AddToClean(Events.MaterialChanged.Event:Connect(Update))
	AddToClean(Events.BrickColorChanged.Event:Connect(Update))
	Update()

	--Boton de tools
	local toolsMenuScrollingFrame = toolsMenu.ScrollingFrame
	for i, child in ipairs(toolsMenuScrollingFrame:GetChildren()) do
		if child:IsA("ImageButton") then
			local function Set()
				SetActualState(child.Name)
				toolsMenu.Visible = false
			end
			AddToClean(child.MouseButton1Up:Connect(Set))

			local numbertostring = ConvertNumberToString(child.LayoutOrder)

			AddToClean(UserInputService.InputBegan:Connect(function(input,gameprocessedevent)

				if gameprocessedevent or ActualMenu ~= toolsMenu then return end

				if input.KeyCode == Enum.KeyCode[numbertostring] then
					Set()
				end
			end))
		end
	end
	AddToClean(Events.StateChanged.Event:Connect(function(State)
		for i, child in ipairs(toolsButton:GetChildren()) do
			if child:IsA("ImageLabel") then
				child.Visible = State == child.Name
			end
		end
	end))


	--boton de color
