--Notification system,
local Notification = (function()
	local Notification = {}

	local NotificationFrame = ScreenGui.NotificationFrame
	local NotificationExample = Examples.NotificationExample
	NotificationExample.Visible = true
	screenGuiJanitor:Add(NotificationExample)
	NotificationExample.Parent = nil

	local ActualNotification = 0

	function Notification.Notify(Text:string,NotificationLife:number?,TextColor:Color3?)
		NotificationLife = NotificationLife or 5
		TextColor = TextColor or Color3.new(1, 1, 1)

		ActualNotification += 1

		local Notification = NotificationExample:Clone()
		Notification.Parent = NotificationFrame
		Notification.LayoutOrder = ActualNotification

		local TextLabel = Notification.TextLabel
		TextLabel.Text = Text
		TextLabel.TextColor3 = TextColor

		Debris:AddItem(Notification,NotificationLife)
	end

	return Notification
end)()

--UI funcs
local UIFuncs = (function()
	local module = {}

	local ScrollingFrameExampleToFuncs = Examples.ScrollingFrameExampleToFuncs
	screenGuiJanitor:Add(ScrollingFrameExampleToFuncs)
	ScrollingFrameExampleToFuncs.Visible = true
	ScrollingFrameExampleToFuncs.Parent = nil

	local MenuRemoverExample = Examples.MenuRemoverExample
	screenGuiJanitor:Add(MenuRemoverExample)
	MenuRemoverExample.Visible = true
	MenuRemoverExample.Parent = nil

	local MenuDraggerExample = Examples.MenuDraggerExample
	screenGuiJanitor:Add(MenuDraggerExample)
	MenuDraggerExample.Visible = true
	MenuDraggerExample.Parent = nil

	local MenuResizerExample = Examples.MenuResizerExample
	screenGuiJanitor:Add(MenuResizerExample)
	MenuResizerExample.Visible = true
	MenuResizerExample.Parent = nil

	--Funcion para obtener la posicion exacta del puntero en la pantalla tanto celular como pc
	function module.GetMousePosition(gui: ScreenGui?,ForceGuiInset:boolean?): Vector2
		local mousePos = UserInputService:GetMouseLocation()

		if ForceGuiInset ~= nil then
			if ForceGuiInset then
				return mousePos - GuiService:GetGuiInset()
			else
				return mousePos
			end
		else
			if gui and gui.IgnoreGuiInset then
				return mousePos
			else
				return mousePos - GuiService:GetGuiInset()
			end
		end
	end

	local function GetScrollingFrame(Frame:Frame)
		local ScrollingFrame = Frame:FindFirstChild("ScrollingFrameExampleToFuncs")
		if not ScrollingFrame then
			ScrollingFrame = ScrollingFrameExampleToFuncs:Clone()
			ScrollingFrame.Parent = Frame
		end
		return ScrollingFrame
	end

	function module.AddMenuRemover(Frame:Frame)
		local ScrollingFrame = GetScrollingFrame(Frame)
		local MenuRemover = ScrollingFrame:FindFirstChild("MenuRemoverExample")
		if not MenuRemover then
			MenuRemover = MenuRemoverExample:Clone()
			MenuRemover.Parent = ScrollingFrame

			screenGuiJanitor:Add(MenuRemover.MouseButton1Down:Connect(function()
				Frame.Visible = false
			end))
		end
		return MenuRemover
	end

	function module.AddMenuDragger(Frame:Frame)
		local ScrollingFrame = GetScrollingFrame(Frame)
		local MenuDragger = ScrollingFrame:FindFirstChild("MenuDraggerExample")
		if not MenuDragger then
			MenuDragger = MenuDraggerExample:Clone()
			MenuDragger.Parent = ScrollingFrame

			local Dragging = false
			local AnteriorMousePosition
			screenGuiJanitor:Add(MenuDragger.MouseButton1Down:Connect(function()
				AnteriorMousePosition = module.GetMousePosition(ScreenGui)
				Dragging = true
			end))
			screenGuiJanitor:Add(UserInputService.InputEnded:Connect(function(input)
				if Dragging and (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) then
					Dragging = false
					AnteriorMousePosition = nil
