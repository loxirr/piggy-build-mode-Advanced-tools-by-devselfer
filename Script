	local function CreateUndoObject()
		local UndoObject = {}

		UndoObject.Type = "add"
		UndoObject.Changes = {}

		return UndoObject
	end

	local function PushUndoObject(UndoObject)
		if UndoStack[ActualStack+1] then
			for i = ActualStack+1, #UndoStack do
				UndoStack[i] = nil
			end
		end
		UndoStack[#UndoStack+1] = UndoObject
		if #UndoStack > MaxStack then
			table.remove(UndoStack, 1)
		end
		ActualStack = #UndoStack
	end

	local function Undo()
		if ToolsDisabled then return end
		if ActualStack <= 0 or not UndoStack[ActualStack] then return end

		local UndoObject = UndoStack[ActualStack]
		local Type = UndoObject.Type
		local Changes = UndoObject.Changes

		if Type == "add" then
			ToolsDisabled = true
			OnToolsDisabledStateChanged:Fire()
			for i = #Changes,2,-1 do
				local child = Changes[i][1]
				if not child then continue end

				task.spawn(function()
					local AnteriorPosition = child:GetPivot()
					child:PivotTo(AnteriorPosition+Vector3.new(9999999,0,9999999))
					task.spawn(function()
						BuildFunctions.Destroy(child)
					end)
					task.wait(1)
					if child.Parent then
						Notification.Notify("Unexpected error, the block could not be destroyed ID:2.1.1",3,Color3.new(1, 0, 0.0156863))
						child:PivotTo(AnteriorPosition)
					end
				end)

				task.wait()
				task.wait()
				task.wait()
			end
			SelectTargetTable(Changes[1])
			ToolsDisabled = false
			OnToolsDisabledStateChanged:Fire()
		elseif Type == "destroy" then
			ToolsDisabled = true
			OnToolsDisabledStateChanged:Fire()

			local tempTable = {}
			for i = #Changes,2,-1 do
				local blockinformation = Changes[i]
				local model = blockinformation[1]
				local FinalPosition = blockinformation[2]
				local Size = blockinformation[3]

				local modelname = model.Name

				local BlockModelTemplate = BlocksFolder:FindFirstChild(modelname,true)
				if not BlockModelTemplate then continue end
				BlockModelTemplate = BlockModelTemplate:FindFirstChild(modelname)
				if not BlockModelTemplate then continue end

				local Random1 = (math.random(-1e+20,1e+20)*100)+1000000000
				local Random3 = (math.random(-1e+20,1e+20)*100)+1000000000

				tempTable[#tempTable+1] = {
					Size,
					FinalPosition,
					BlockModelTemplate,
					FinalPosition + Vector3.new(Random1,0,Random3),
					blockinformation[5],
					blockinformation[4],
				} 
			end
			for i, child in ipairs(tempTable) do
				local Size = child[1] 
				local finalPosition = child[2] 
				local Model = child[3] 
				local RandomPosition = child[4] 
				local Material = child[5] 
				local Color = child[6] 

				task.spawn(function()
					local block
					task.spawn(function()
						block = BuildFunctions.Build(Model,RandomPosition,Color,Material)
						if block then
							task.spawn(function()
								BuildFunctions.Move(block,finalPosition)
							end)
							task.spawn(function()
								BuildFunctions.Resize(block,finalPosition,Size)
							end)
						end
					end)
					local Time = 0
					while not block do
						Time += task.wait()
						if Time > 1 then
							Notification.Notify("The server refused to add the block ID:1.1.1",3,Color3.new(1, 0, 0.0156863))
							break
						end
					end
				end)

				task.wait()
				task.wait()
				task.wait()
			end
			task.wait(0.25)
			SelectTargetTable(Changes[1])
			ToolsDisabled = false
			OnToolsDisabledStateChanged:Fire()
		elseif Type == "modification" then
			ToolsDisabled = true
			OnToolsDisabledStateChanged:Fire()
			for i = #Changes,2,-1 do
				local blockinformation = Changes[i]
				local block = blockinformation[1]
				if not block then continue end
				
				task.spawn(function()
					BuildFunctions.Fill(block,blockinformation[4],blockinformation[5])
				end)
				task.spawn(function()
					BuildFunctions.Resize(block,blockinformation[2],blockinformation[3])
				end)
				
				task.wait()
				task.wait()
				task.wait()
			end
			SelectTargetTable(Changes[1])
			ToolsDisabled = false
			OnToolsDisabledStateChanged:Fire()
		end

		ActualStack -= 1
	end

