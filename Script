local ControlsManager = (function()
	local module = {}

	module.PressingKeysIsChanged = EventModule.GetEvent()

	local ActualPressingsKeys = GeneralPoolObject:GetArray()
	GlobalJanitor:AddTask(function()
		table.clear(ActualPressingsKeys)
	end,nil,{Destruir = true})
	GlobalJanitor:AddConnection(UserInputService.InputBegan:Connect(function(Key)
		local UserInputType = Key.UserInputType
		if 
			UserInputType == Enum.UserInputType.MouseMovement or
			UserInputType == Enum.UserInputType.MouseButton1 or
			UserInputType == Enum.UserInputType.MouseButton2 or
			UserInputType == Enum.UserInputType.MouseButton3 or
			UserInputType == Enum.UserInputType.MouseWheel
		then
			return
		end

		for i, child in pairs(ActualPressingsKeys) do
			if not child then continue end
			if child[1] then
				child[1] = false
			end
		end
		ActualPressingsKeys[Key.KeyCode] = {true}
		module.PressingKeysIsChanged:Fire()
	end),nil,{Destruir = true})
	GlobalJanitor:AddConnection(UserInputService.InputEnded:Connect(function(Key)
		ActualPressingsKeys[Key.KeyCode] = nil
		module.PressingKeysIsChanged:Fire()
	end),nil,{Destruir = true})

	function module.CheckIfIsPressingAndNew(Table:{Enum.KeyCode})

		if #Table <= 0 then
			return false
		end

		local New = false
		for _,Key in pairs(Table) do
			local information = ActualPressingsKeys[Key]
			if not information then
				return false
			end
			if information[1] then
				New = true
			end
		end

		return New
	end

	function module.CheckIfIsPressing(Table:{Enum.KeyCode})

		if #Table <= 0 then
			return false
		end

		for _,Key in pairs(Table) do
			if not ActualPressingsKeys[Key] then
				return false
			end
		end

		return true
	end

	return module
end)()

