		AddToClean(clon.MouseButton1Up:Connect(function()
			SetActualCreationModel(Model)
		end))

		local deltaacumulada = 0
		local Rotacion = 0
		AddToClean(RunService.Heartbeat:Connect(function(delta)
			deltaacumulada += delta
			if deltaacumulada < 0.1 then return end

			Rotacion += math.rad(45*deltaacumulada)
			local Pivot = (CF * CFrame.Angles(0,Rotacion,0)) * Offset

			ModelClon:PivotTo(Pivot)
			ModelClon2:PivotTo(Pivot)

			deltaacumulada -= 0.1
		end))

		UIFuncs.SetExtraInformationMessage(TextLabel,FriendlyName)
		UIFuncs.SetExtraInformationMessage(clon.TextLabel,FriendlyName)
		ModelsTable[FriendlyName] = clon

	end

