		local function UpdateClonedModel()
			if not ActualClonedModel then return end
			for i, child in ipairs(ActualClonedModel:GetDescendants()) do
				if child:IsA("BasePart") then
					child.CanCollide = false
					if child.Name == "ColorPart" then
						child.BrickColor = ActualBrickColor
