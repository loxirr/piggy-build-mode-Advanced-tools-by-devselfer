	local function CreateBoxOfAllSelectedModels()
		local LastTarget = SelectedTargets[#SelectedTargets]
		if not LastTarget then 
			if BoxOfAllSelectedModels then
				BoxOfAllSelectedModels:Destroy()
				BoxOfAllSelectedModels = nil
			end
			return
		end

		if not BoxOfAllSelectedModels then

			boxJanitor:Cleanup()

			BoxOfAllSelectedModels = Instance.new("Part")
			BoxOfAllSelectedModels.Anchored = true
			BoxOfAllSelectedModels.Transparency = 1
			BoxOfAllSelectedModels.CanCollide = false
			BoxOfAllSelectedModels.CanQuery = false
			BoxOfAllSelectedModels.CanTouch = false
			BoxOfAllSelectedModels.Parent = workspace
			AddObjectToExclude(BoxOfAllSelectedModels,Excluded)

			boxJanitor:AddConnection(Events.WorldStateChanged.Event:Connect(function()
				LastTarget = SelectedTargets[#SelectedTargets]
				if not LastTarget then boxJanitor:Cleanup() return end
				if not UpdateBox then return end
				local Pivot = LastTarget:GetPivot()
				if LocalStateInBox then
					BoxOfAllSelectedModels.Size = LastTarget:GetExtentsSize()
					BoxOfAllSelectedModels.CFrame = CFrame.new(Pivot.Position) * Pivot.Rotation
				else
					local max = 0
					local Size = LastTarget:GetExtentsSize()

					max = math.max(Size.X,max)
					max = math.max(Size.Y,max)
					max = math.max(Size.Z,max)

					BoxOfAllSelectedModels.Size = Vector3.new(max,max,max)
					BoxOfAllSelectedModels.CFrame = CFrame.new(Pivot.Position)
				end
			end),nil,{})

			boxJanitor:AddTask(function()
				if BoxOfAllSelectedModels then
					BoxOfAllSelectedModels:Destroy()
					BoxOfAllSelectedModels = nil
				end
			end,nil,{})

			boxJanitor:AddConnection(BoxOfAllSelectedModels.Destroying:Once(function()
				boxJanitor:Cleanup()
			end),nil,{})

		end

		if not UpdateBox then return end

		local Pivot = LastTarget:GetPivot()

		if LocalStateInBox then
			BoxOfAllSelectedModels.Size = LastTarget:GetExtentsSize()
			BoxOfAllSelectedModels.CFrame = CFrame.new(Pivot.Position) * Pivot.Rotation
		else
			local max = 0
			local Size = LastTarget:GetExtentsSize()

			max = math.max(Size.X,max)
			max = math.max(Size.Y,max)
			max = math.max(Size.Z,max)

			BoxOfAllSelectedModels.Size = Vector3.new(max,max,max)
			BoxOfAllSelectedModels.CFrame = CFrame.new(Pivot.Position)
		end
	end
