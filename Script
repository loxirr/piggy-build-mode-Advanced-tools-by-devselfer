ModulesTable["TableModule0"] = (function()
	local Folder = game:GetService("ReplicatedStorage"):FindFirstChild("FoldersContainers") or Instance.new("Folder")
	Folder.Name = "FoldersContainers"
	Folder.Parent = game:GetService("ReplicatedStorage")
	local TableModuleFolder = Instance.new("Folder")
	TableModuleFolder.Parent = Folder
	TableModuleFolder.Name = "TableModuleFolder"
	local script = TableModuleFolder
	
	do
		local InstancesTable = {}
		table.clear(InstancesTable)
	end
	
	
	local module = {}
	
	local table_clear = table.clear
	local table_insert = table.insert
	
	--copiar profundamente una tabla
	function module.DeepCopy(Original)
		
		local seen = {}
		local function InternalFunction(table)
			local Copy = {}
			seen[table] = Copy
			for k, v in pairs(table) do
				if type(v) == "table" then
					if seen[v] then
						Copy[k] = seen[v]
					else
						Copy[k] = InternalFunction(v)
					end
				else
					Copy[k] = v
				end
			end
			return Copy
		end
		local copy = InternalFunction(Original)
		table_clear(seen)
		return copy
	end
	
	--contar diccionario
	function module.CountAnyTable(Dictionary)
		local Count = 0
		for _,_ in pairs(Dictionary) do
			Count += 1
		end
		return Count
	end
	
	--limpiado profundo
	function module.DeepClear(TableToClear)
		local seen = {}
	
		local function InternalFunction(tbl)
			if type(tbl) ~= "table" or seen[tbl] then
				return
			end
	
			seen[tbl] = true
	
			for _, value in pairs(tbl) do
				InternalFunction(value)
			end
		end
	
		InternalFunction(TableToClear)
	
		for tbl, _ in pairs(seen) do
			table_clear(tbl)
		end
	
		table_clear(seen)
	end
	
	--funcion para combinar multiples arrays en uno solo, no sirve para iteracion con keys
	function module.MergeArrays(...)
		local NewArray = {}
		
		for i,Array in pairs({...}) do
			for _,v in pairs(Array) do
				table_insert(NewArray,v)
			end
		end
		
		return NewArray
	end
	
	return module
	
end)()
ModulesTable["WaitPerWorking0"] = (function()
	local Folder = game:GetService("ReplicatedStorage"):FindFirstChild("FoldersContainers") or Instance.new("Folder")
	Folder.Name = "FoldersContainers"
	Folder.Parent = game:GetService("ReplicatedStorage")
	local WaitPerWorkingFolder = Instance.new("Folder")
	WaitPerWorkingFolder.Parent = Folder
	WaitPerWorkingFolder.Name = "WaitPerWorkingFolder"
	local script = WaitPerWorkingFolder
	
	do
		local InstancesTable = {}
		table.clear(InstancesTable)
	end
	
	local RunService = game:GetService("RunService")
	
	local CyclicWait = {}
	CyclicWait.__index = CyclicWait
	
	--funcion wait que tendra un maximo tiempo de ejecucion, default 0.002
	-- en promedi ocada frame tiene aproximadamente 0.016666 segundos, se recomienda usar 2 tercios o menor
	function CyclicWait.new(budget)
		local self = setmetatable({}, CyclicWait)
	
		-- Tiempo máximo permitido antes de esperar
		-- default: ~2ms
		self:SetBudget(budget or 0.002)
	
		self.LastYield = os.clock()
		self.Waiting = false
	
		return self
	end
	
	function CyclicWait:SetBudget(budget)
		assert(type(budget) == "number", "Budget must be a number")
		assert(budget > 0, "Budget must be greater than 0")
	
		self.Budget = budget
	end
	
	function CyclicWait:WaitFrame()
		if self.Waiting then
			RunService.Heartbeat:Wait()
		else
			self.Waiting = true
			RunService.Heartbeat:Wait()
			self:SetLastYield()
			self.Waiting = false
		end
	end
	
	function CyclicWait:SetLastYield()
		self.LastYield = os.clock()
	end
	
	function CyclicWait:Step()
			
		-- Si excedimos el tiempo permitido esperamos un frame
		if os.clock() - self.LastYield >= self.Budget then
			self:WaitFrame()
		end
	end
	
	function CyclicWait:ForceWait(times)
		times = times or 1
	
		for _ = 1, times do
			self:WaitFrame()
		end
