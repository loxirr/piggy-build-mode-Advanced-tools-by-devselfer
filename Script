	function PoolObject.GetArray(self: PoolObject, Index: string?, TableSize: number?, DefaultObject: any,InstruccionID:string?): {any}
		if self.PoolJanitor:IsDestroyed() then return end
		local size: number = TableSize or 1
		assert(typeof(size) == "number", ERR_TABLE_SIZE)
	
		local NewArray: {any}
	
		if Index then
			assert(typeof(Index) == "string", ERR_INDEX_STR)
			local Arrays = self.ArraysWithIndex
			NewArray = Arrays[Index]
			if not NewArray then
				-- Crear nuevo — NO necesita clear
				NewArray = table.create(size, DefaultObject)
				Arrays[Index] = NewArray
				DebugModule.AdvancedDebugPrint(self.DebugState,
					"GetArray-Pooling",
					"NUEVO con index: " .. Index,
					"ID: " .. self.ID,
					"Ins: " .. (InstruccionID or "No ins")
				)
			else
				-- Reutilizado — limpiar contenido previo
				table.clear(NewArray)
				for i = 1,size do
					NewArray[i] = DefaultObject
				end
				DebugModule.AdvancedDebugPrint(self.DebugState,
					"GetArray-Pooling",
					"REUTILIZADO con index: " .. Index,
					"ID: " .. self.ID,
					"Ins: " .. (InstruccionID or "No ins")
				)
			end
		else
			self.ActualArray += 1
			local idx: number = self.ActualArray
			local Arrays = self.Arrays
			NewArray = Arrays[idx]
			if not NewArray then
				-- Crear nuevo
				NewArray = table.create(size, DefaultObject)
				Arrays[idx] = NewArray
				DebugModule.AdvancedDebugPrint(self.DebugState,
					"GetArray-Pooling",
					"NUEVO sin index: " .. idx,
					"ID: " .. self.ID,
					"Ins: " .. (InstruccionID or "No ins")
				)
			else
				-- Reutilizado
				table.clear(NewArray)
				for i = 1,size do
					NewArray[i] = DefaultObject
				end
				DebugModule.AdvancedDebugPrint(self.DebugState,
					"GetArray-Pooling",
					"REUTILIZADO sin index: " .. idx,
					"ID: " .. self.ID,
					"Ins: " .. (InstruccionID or "No ins")
				)
			end
		end
	
		-- OPTIMIZACIÓN: Solo hacer clear si se reutilizó
		-- (Ya se hizo arriba condicionalmente, eliminamos el clear incondicional original)
	
