		local WaitObjectSearcher = WaitFunc.new(250)
		local MaxDistance = 4.5*250

		Searcher.Visible = false
		screenGuiJanitor:Add(
			UserInputService.InputBegan:Connect(function(input)
				if not ActualSelectedTargetingColor or not MultiSelectEnabled then return end
				if 
					(
						input.UserInputType == Enum.UserInputType.MouseButton1 or
							input.UserInputType == Enum.UserInputType.Touch
					) and 
						Configurations.MultiSelectorBoxEnabled 
				then
					local Start = UIFuncs.GetPointerPosition()
					local StartInset = UIFuncs.ApplyGuiInset(Start,ScreenGui)

					Searcher.Position = UDim2.fromOffset(StartInset.X,StartInset.Y)
					Searcher.Size = UDim2.new(0, 0, 0, 0)
					Searcher.Visible = true

					local ArrastrarJanitor = Janitor.new()

					ArrastrarJanitor:Add(
						UserInputService.InputEnded:Connect(function(input)
							if 
								input.UserInputType == Enum.UserInputType.MouseButton1 or
								input.UserInputType == Enum.UserInputType.Touch
							then
								ArrastrarJanitor:Destroy()
							end
						end)
					)
					ArrastrarJanitor:Add(
						function()
							Searcher.Visible = false
						end
					)

					local TablaIterando
					local processedModels = {}
					ArrastrarJanitor:Add(
						RunService.Heartbeat:Connect(function()
							if not MultiSelectEnabled then
								ArrastrarJanitor:Destroy()
								return
							end
							local End = UIFuncs.GetPointerPosition()
							local EndInset = UIFuncs.ApplyGuiInset(End,ScreenGui)

							Searcher.Size = UDim2.fromOffset(
								(EndInset.X - StartInset.X),
								-(EndInset.Y - StartInset.Y)
							)

							if TablaIterando then return end
							TablaIterando = true

							table.clear(processedModels)

							local minX = math.min(Start.X, End.X)
							local maxX = math.max(Start.X, End.X)
							local minY = math.min(Start.Y, End.Y)
							local maxY = math.max(Start.Y, End.Y)

							local CameraCf = (CurrentCamera.CFrame) * CFrame.new(0, 0,-(MaxDistance/2))

							-- Datos de cámara
							local fov = math.rad(CurrentCamera.FieldOfView)
							local aspectRatio = CurrentCamera.ViewportSize.X / CurrentCamera.ViewportSize.Y

							-- Altura y ancho visibles a esa distancia
							local X = 2 * MaxDistance * math.tan(fov / 2)
							local Y = X * aspectRatio

							local BoxSize = Vector3.new(
								X,
								Y,
								MaxDistance
							)

							for _, child in ipairs(workspace:GetPartBoundsInBox(CameraCf,BoxSize)) do
								if not MultiSelectEnabled or ArrastrarJanitor:IsDestroyed() then
									ArrastrarJanitor:Destroy()
									break
								end

								local model = child:FindFirstAncestorOfClass("Model")

								if 
									not model or
									not model.Parent or
									processedModels[model] or 
									not next(model:GetChildren()) or
									model.Parent ~= BuildModel
								then 
									continue 
								end

								WaitObjectSearcher:Wait()
								local screenPos, onScreen = CurrentCamera:WorldToViewportPoint(model:GetPivot().Position)

								if not onScreen then continue end

								if screenPos.X < minX or screenPos.X > maxX
									or screenPos.Y < minY or screenPos.Y > maxY then
									continue
								end

								processedModels[model] = true
								AddSelectedBlock(model, nil, true)
							end

							CreateBoxOfAllSelectedModels()
							OnSelectedTargetsChanged:Fire()
							TablaIterando = false
						end)
					)
				end
			end)
		)

	end

	local function Undo()
		if ToolsDisabled then return end
		if ActualStack <= 0 or not UndoStack[ActualStack] then return end

		local UndoObject = UndoStack[ActualStack]
		local Type = UndoObject.Type
		local Changes = UndoObject.Changes

		ToolsDisabled = true
		OnToolsDisabledStateChanged:Fire()
		if Type == "add" then
			local DataToReBuild = {}
			for i = #Changes,2,-1 do
				local blockinformation = Changes[i]
				local child = blockinformation[1]
				if not child or not child.Parent then continue end

				DataToReBuild[#DataToReBuild+1] = {
					GetBlockType(child),
					blockinformation[2],
					blockinformation[3],
					blockinformation[4],
					blockinformation[5],
					child:FindFirstChild("Configuration")
				}
				task.spawn(function()
					BuildFunctionsAdvanced.AdvancedDestroy(child,false)
				end)

				task.wait(0.0166666666667)
			end
			SelectTargetTable(Changes[1])
			RedoStack[#RedoStack+1] = {
				Type = Type,
				Changes = DataToReBuild
			}
		elseif Type == "destroy" then

			local builded = {}
			DeselectAll()
			local Max = #Changes
			for i = 2,#Changes do
				local child = Changes[i]
				task.spawn(function()
					local block = BuildFunctionsAdvanced.AdvancedBuild(
						child[1], 
						child[2], 
						child[3], 
						child[4], 
						child[5],
						true,
						false,
						nil,
						child[6]
					)
					table.insert(builded,block)
					AddSelectedBlock(block,true,true)
					if i == Max then
						CreateBoxOfAllSelectedModels()
						OnSelectedTargetsChanged:Fire()
						RedoStack[#RedoStack+1] = {
							Type = Type,
							Changes = {Changes[1],table.unpack(builded)}
						}
					end
				end)

				task.wait(0.0166666666667)
			end

		elseif Type == "modification" then
			local AnteriorModifications = {Changes[1]}
			for i = #Changes,2,-1 do
				local blockinformation = Changes[i]
				local O1 = blockinformation[1]
				if not O1 or not O1.Parent then continue end

				AnteriorModifications[#AnteriorModifications+1] = {
					O1,
					O1:GetPivot(),
					O1:GetExtentsSize(),
					O1:GetAttribute("Color"),
					O1:GetAttribute("Material")
				}

				task.spawn(function()
					BuildFunctionsAdvanced.AdvancedModification(
						O1,
						blockinformation[2],
						blockinformation[3],
						blockinformation[4],
						blockinformation[5],
						false
					)
				end)

				task.wait(0.0166666666667)
			end
			SelectTargetTable(Changes[1])
			RedoStack[#RedoStack+1] = {
				Type = Type,
				Changes = AnteriorModifications
			}
		end
		ToolsDisabled = false
		OnToolsDisabledStateChanged:Fire()

		ActualStack -= 1
	end

	local ReplacementWait = WaitFunc.new(25)
	local function Redo()
		if ToolsDisabled then return end
		local max = #RedoStack
		if max <= 0 then return end

		local RedoItem = RedoStack[max]
		local Type = RedoItem.Type
		local Changes = RedoItem.Changes

		RedoStack[max] = nil
		ActualStack += 1
		local UndoItem = UndoStack[ActualStack]
		local UndoType = UndoItem.Type
		local UndoChanges = UndoItem.Changes

		ToolsDisabled = true
		OnToolsDisabledStateChanged:Fire()
		if Type == "add" then
			DeselectAll()
			local Max = #Changes
			for i, child in ipairs(Changes) do
				if not child[1] then continue end
				task.spawn(function()
					local block = BuildFunctionsAdvanced.AdvancedBuild(
						child[1], 
						child[2], 
						child[3], 
						child[4], 
						child[5],
						true,
						false,
						nil,
						child[6]
					)
					AddSelectedBlock(block,true,true)
					if i == Max then
						CreateBoxOfAllSelectedModels()
						OnSelectedTargetsChanged:Fire()
					end

					local AnteriorReferencia = UndoChanges[i+1][1]
					for _, UndoItemRecorrer in ipairs(UndoStack) do
						for i, UndoChangesRecorrer in ipairs(UndoItemRecorrer.Changes) do
							if UndoChangesRecorrer[1] == AnteriorReferencia then
								UndoChangesRecorrer[1] = block
							end
							ReplacementWait:Wait()
						end
						ReplacementWait:Wait()
					end
				end)

				task.wait(0.0166666666667)
			end
		elseif Type == "destroy" then
			for i = #Changes,2,-1 do
				local child = Changes[i]
				if not child or not child.Parent then continue end
				task.spawn(function()
					BuildFunctionsAdvanced.AdvancedDestroy(child,false)
				end)
				task.wait(0.0166666666667)
			end
			SelectTargetTable(Changes[1])
		elseif Type == "modification" then
			for i = #Changes,2,-1 do
				local blockinformation = Changes[i]
				local child = blockinformation[1]
				if not child or not child.Parent then continue end
				task.spawn(function()
					BuildFunctionsAdvanced.AdvancedModification(
						child,
						blockinformation[2],
						blockinformation[3],
						blockinformation[4],
						blockinformation[5],
						false
					)
				end)

				task.wait(0.0166666666667)
			end
			SelectTargetTable(Changes[1])
		end
		ToolsDisabled = false
		OnToolsDisabledStateChanged:Fire()
	end

