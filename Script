			if child.Name == "NoDestroy" then continue end
			table.insert(Teams,child)
		end
	
		return Teams
	end
	
	--Funcion para obtener todas las UI de los teams
	local function GetTeamsWithPlayers()
		local TeamsWithPlayers = {}
	
		for i, child in ipairs(Players:GetPlayers()) do
			local PlayerData = GetPlayerData(child)
			local TeamName = PlayerData.Team or "Neutral"
			local TeamUI = PlayerList:FindFirstChild(TeamName)
			if not TeamUI then continue end
			table.insert(TeamsWithPlayers,TeamUI)
		end
	
		return TeamsWithPlayers
	end
	
	--funcion para mirar todos los teams, y eliminar los teams vacios para eliminar basura visual
	local function RemoveTeamsWithNoPlayers()
		local TeamsWithPlayers = GetTeamsWithPlayers()
		local CurrentTeams = GetAllTeams()
		for i, child in ipairs(CurrentTeams) do
			if not table.find(TeamsWithPlayers,child) then
				child:Destroy()
			end
		end
	end
	
	--funcion para cuando un player se ha unido al juego
	local function OnPlayerJoinedFunc(Player:Player)
	
		--esto tomara los datos del jugador y los usara para crear una UI para el jugador en el PlayerList
		local function UpdatePlayerTeam(Player:Player)
			local ActualTeam = Player.Team
			local TeamName = ActualTeam and tostring(ActualTeam.Name) or "Neutral"
			local TeamColor
			if ActualTeam then
				TeamColor = Player.TeamColor.Color
			else
				TeamColor = Color3.new(1,1,1)
			end
			local Team = CreateTeam(
				TeamName,
				TeamColor
			)
			SetPlayerTeam(Player,TeamName)
			RemoveTeamsWithNoPlayers()
		end
	
		UpdatePlayerTeam(Player)
	
		GetPlayerJanitor(Player):AddConnection(Player.Changed:Connect(function(Property)
			if Property == "Team" then
				UpdatePlayerTeam(Player)
			end
		end),nil,{Destruir = true})
	
	end
	
	--funcion para cuando un jugador se ha ido del juego
	local function OnPlayerExitedFunc(Player:Player)
		GetPlayerJanitor(Player):Destroy()
	
		RemovePlayerUI(Player)
		RemovePlayerData(Player)
		RemoveTeamsWithNoPlayers()
	end
	
	function module.CreateIcon(Player:Player,IconID:number,IconDescription:string): ImageLabel
		assert(IconDescription,"IconDescription is nil")
		local PlayerData = GetPlayerData(Player)
		if not PlayerData then return end
		local Icons = PlayerData.Icons
		if not Icons then
			Icons = {}
			PlayerData.Icons = Icons
		end
		local Icon = Icons[IconDescription]
		if not Icon then
			local PlayerUI = GetPlayerUI(Player)
			if not PlayerUI then return end
	
			local Icon = ExampleIcon:Clone()
			Icon.Image = "rbxassetid://" .. IconID
	
			UIFuncs.SetExtraInformationMessage(Icon,IconDescription)
	
			Icon.Parent = PlayerUI.Principal.PlayerInformation.Icons
	
			Icons[IconDescription] = Icon
		end
	
		return Icon
	end
	
	local function RemoveAllIcons(Player:Player)
		local PlayerData = GetPlayerData(Player)
		local Icons = PlayerData.Icons
		if not Icons then return end
		for i, child in pairs(Icons) do
			child:Destroy()
		end
		table.clear(Icons)
	end
	
	function module.UpdateIconsInPlayer(Player:Player)
		RemoveAllIcons(Player)
		module.GetIconsEvent:Fire(Player)
	end
	
