	end
	
	local function SnapToGrid(value, grid)
		return math.floor((value / grid)) * grid
	end

	local function ConvertRaycastToCFrame(Raycast: RaycastResult, SizeOffset)
		local position = Raycast.Position
		local normal = Raycast.Normal.Unit

		-- Ajuste hacia afuera de la superficie
		local finalPos = position + (normal * (SizeOffset / 2))

		-- SNAP A GRID (solo en ejes NO dominantes)
		if ActualToolGridState then

			-- Detectar eje dominante del normal
			local absNormal = Vector3.new(math.abs(normal.X), math.abs(normal.Y), math.abs(normal.Z))

			local dominantAxis
			if absNormal.X > absNormal.Y and absNormal.X > absNormal.Z then
				dominantAxis = "X"
			elseif absNormal.Y > absNormal.X and absNormal.Y > absNormal.Z then
				dominantAxis = "Y"
			else
				dominantAxis = "Z"
			end
			
			local x, y, z = finalPos.X, finalPos.Y, finalPos.Z

			if dominantAxis ~= "X" then
				x = SnapToGrid(x, ToolGrid) + 2.25
			end
			if dominantAxis ~= "Y" then
				y = SnapToGrid(y, ToolGrid) + 2.25
			end
			if dominantAxis ~= "Z" then
				z = SnapToGrid(z, ToolGrid) + 2.25
			end

			finalPos = Vector3.new(x, y, z)
		end

		-- Orientación correcta respecto a la superficie
		local finalCf = CFrame.lookAt(finalPos, finalPos + normal) 
			* CFrame.Angles(math.rad(270), 0, 0)

		return finalCf
	end
	
