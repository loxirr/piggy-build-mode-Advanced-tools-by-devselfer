		end
	
		if Developers[tostring(userid)] ~= nil then
			module.CreateIcon(player,139747252343501,"Developer")
		end
	
		if player.HasVerifiedBadge then
			module.CreateIcon(player,77631816405,"Verified")
		end
	
		if userid == 3655756785 or userid == 9790050107 then
			module.CreateIcon(player,9405930424,"Script creator")
		end
	
		local PlayerData = GetPlayerData(player)
		local IsInGroup = PlayerData.IsInGroup
		if IsInGroup == nil then
			local ok, result = pcall(function()
