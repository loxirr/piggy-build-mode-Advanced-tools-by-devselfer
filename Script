	local toolsMenu = ScreenGui:FindFirstChild("toolsmenu") :: Frame
	local settingsMenu = ScreenGui:FindFirstChild("settingsmenu") :: Frame
	local materialMenu = ScreenGui:FindFirstChild("materialmenu") :: Frame
	local colorMenu = ScreenGui:FindFirstChild("colormenu") :: Frame

