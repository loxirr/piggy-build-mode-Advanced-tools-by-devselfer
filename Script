local ColorSelector = (function()

	local module = {}

	local ColorSelector = Examples.ColorSelector
	ColorSelector.Visible = false
	module.ActualColor = Color3.new(1,1,1)

	local Buttons = ColorSelector.Buttons
	local Cancel = Buttons.Cancel
	local Confirm = Buttons.Confirm

	local HexTextBox = ColorSelector.Hex.TextBox
	local function HexToColor3(hex: string): Color3
		-- Quitar el "#" si existe
		hex = hex:gsub("#", "")

		-- Soporte para formato corto (#FFF)
		if #hex == 3 then
			hex = hex:sub(1,1)..hex:sub(1,1)
				..hex:sub(2,2)..hex:sub(2,2)
				..hex:sub(3,3)..hex:sub(3,3)
		end

		-- Validación básica
		if #hex ~= 6 then
			Notification.Notify("Invalid hex ID:3.1.1",3,Color3.new(1, 0, 0.0156863))
			return
		end

		-- Convertir a números
		local r = tonumber(hex:sub(1,2), 16)
		local g = tonumber(hex:sub(3,4), 16)
		local b = tonumber(hex:sub(5,6), 16)

		return Color3.fromRGB(r, g, b)
	end

	local ColorSelectorContainer = ColorSelector.ColorSelectorContainer

	local OscuridadBar = ColorSelectorContainer.OscuridadBar
	local OscuridadBarSelect = OscuridadBar.OscuridadBarSelect

	local PaletaColorImagen = ColorSelectorContainer.PaletaColorImagen
	local PaletaColorImagenSelect = PaletaColorImagen.PaletaColorImagenSelect

	local ResultFrame = ColorSelectorContainer.ResultFrame

	local RecentColors = ColorSelectorContainer.RecentColors
	local RecentColorTemplate = RecentColors.RecentColorTemplate
	local AllColors = GeneralPoolObject:AddArray({RecentColorTemplate})
	GlobalJanitor:AddTask(function()
		table.clear(AllColors)
	end,nil,{Destruir = true})
	for i = 1, 27 do
		local RecentColor = RecentColorTemplate:Clone()
		RecentColor.Parent = RecentColors
		RecentColor.LayoutOrder += i
		table.insert(AllColors,RecentColor)
	end

	function module.AddRecentColor(color: Color3)
		local previousColor = color

		for i, child in ipairs(AllColors) do
			local currentColor = child.BackgroundColor3
			child.BackgroundColor3 = previousColor
			previousColor = currentColor
		end
	end

	local function Color3ToHex(color: Color3): string
		local r = math.floor(color.R * 255)
		local g = math.floor(color.G * 255)
		local b = math.floor(color.B * 255)

		return string.format("#%02X%02X%02X", r, g, b)
	end
	local function UpdateAspect(color:Color3,ColorOriginal:Color3)
		local h, s, v = color:ToHSV()

		--paleta
		do
			local cx = PaletaColorImagen.AbsolutePosition.X + PaletaColorImagen.AbsoluteSize.X/2
			local cy = PaletaColorImagen.AbsolutePosition.Y + PaletaColorImagen.AbsoluteSize.Y/2
			local radius = PaletaColorImagen.AbsoluteSize.X/2 * s

			local angle = (1 - h) * math.pi * 2
			local px = cx - math.cos(angle) * radius
			local py = cy - math.sin(angle) * radius


			PaletaColorImagenSelect.Position = UDim2.new(
				0, px - PaletaColorImagen.AbsolutePosition.X,
				0, py - PaletaColorImagen.AbsolutePosition.Y
			)
		end

		--oscuridad
		do
			local SliderX = (1 - v) * OscuridadBar.AbsoluteSize.X

			OscuridadBarSelect.Position = UDim2.new(
				0,
				SliderX,
				0.5,
				0
			)
		end

		--oscuridad color
		do
			if ColorOriginal then
				OscuridadBar.BackgroundColor3 = ColorOriginal
			end
		end

		--paleta color
		do
			PaletaColorImagen.ImageColor3 = Color3.new(v,v,v)
		end

		--result
		do
			ResultFrame.BackgroundColor3 = color
		end

		--hex
		do
			HexTextBox.Text = Color3ToHex(color)
		end
	end
	local function SetDarkness(color: Color3, darkness: number): Color3
		darkness = math.clamp(darkness, 0, 1)

		local h, s, _ = color:ToHSV()

		local v = 1 - darkness

		return Color3.fromHSV(h, s, v)
	end
	local function GetDarkness(color: Color3): number
		local _, _, v = color:ToHSV()
		return 1-v
	end

	local ResetFunc
	local ColorJanitor = Janitor.new("Color selector janitor")
	GlobalJanitor:AddJanitor(ColorJanitor,nil,{Destruir = true, DestruirTarget = true})
	function module.Open()
		if ResetFunc then
			ResetFunc()
			ResetFunc = nil
		end

		local Connection = {}
		Connection.OnColorChanged = EventModule.GetEvent()
		Connection.OnColorSelected = EventModule.GetEvent()
		Connection.ColorJanitor = ColorJanitor

		local NewColor = module.ActualColor
		local OriginalColor = SetDarkness(NewColor,0)
		local SliderState = false
		local buttonDown = false
		local OscuridadPorcentaje = 0
		UpdateAspect(NewColor,OriginalColor)

		local function CancelFunc()
			NewColor = module.ActualColor
			Connection.OnColorChanged:Fire(NewColor)
			Connection.OnColorSelected:Fire(NewColor)

			ColorSelector.Visible = false
			task.wait()
			ColorJanitor:Cleanup()
			ResetFunc = nil

		end

		local function ConfirmFunc()
			module.ActualColor = NewColor
			Connection.OnColorChanged:Fire(NewColor)
			Connection.OnColorSelected:Fire(NewColor)

			module.AddRecentColor(NewColor)

			ColorSelector.Visible = false
			task.wait()
			ColorJanitor:Cleanup()
			ResetFunc = nil

		end

		ResetFunc = CancelFunc
		ColorJanitor:AddConnection(Confirm.MouseButton1Up:Connect(ConfirmFunc),nil,{})
		ColorJanitor:AddConnection(Cancel.MouseButton1Up:Connect(CancelFunc),nil,{})
		
		local function StartDragging(FrameToDrag:TextButton)
			ColorJanitor:AddConnection(
				FrameToDrag.MouseButton1Down:Connect(function()
					local ID = UniqueIDCreator.GenerateID()
					SliderState = true
					ColorJanitor:AddConnection(
						UserInputService.InputChanged:Connect(function(input)
							if not SliderState then
								ColorJanitor:Remove(ID,{EjecutarTaskAlQuitar = true})
								return
							end
							if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
								OscuridadPorcentaje = UIFuncs.GetMousePercentageInBar(OscuridadBar)
								NewColor = SetDarkness(OriginalColor,OscuridadPorcentaje)
								Connection.OnColorChanged:Fire(NewColor)
							end
						end),nil,{}
					)
				end),nil,{}
			)
		end
		StartDragging(OscuridadBar)
		StartDragging(OscuridadBarSelect)

		ColorJanitor:AddConnection(HexTextBox.FocusLost:Connect(function()
			local AnteriorColor = NewColor
			NewColor = HexToColor3(HexTextBox.Text)
			if not NewColor then 
				NewColor = AnteriorColor
				return
			end
			OscuridadPorcentaje = GetDarkness(NewColor)
			OriginalColor = SetDarkness(NewColor,0)
			Connection.OnColorChanged:Fire(NewColor)
		end),nil,{})

		local function UpdateColor()
			local mousePos = UIFuncs.ApplyGuiInset(UIFuncs.GetPointerPosition(),ScreenGui)

			local centreOfWheel = Vector2.new(PaletaColorImagen.AbsolutePosition.X + (PaletaColorImagen.AbsoluteSize.X/2), PaletaColorImagen.AbsolutePosition.Y + (PaletaColorImagen.AbsoluteSize.Y/2))

			local distanceFromWheel = (mousePos - centreOfWheel).Magnitude


			if distanceFromWheel <= (PaletaColorImagen.AbsoluteSize.X/2) then

				PaletaColorImagenSelect.Position = UDim2.new(0, mousePos.X - PaletaColorImagen.AbsolutePosition.X, 0, mousePos.Y - PaletaColorImagen.AbsolutePosition.Y)

				local colourPickerCentre = Vector2.new(
					PaletaColorImagenSelect.AbsolutePosition.X + (PaletaColorImagenSelect.AbsoluteSize.X/2),
					PaletaColorImagenSelect.AbsolutePosition.Y + (PaletaColorImagenSelect.AbsoluteSize.Y/2)
				)

				local h = (math.pi - math.atan2(colourPickerCentre.Y - centreOfWheel.Y, colourPickerCentre.X - centreOfWheel.X)) / (math.pi * 2)
				local s = (centreOfWheel - colourPickerCentre).Magnitude / (PaletaColorImagen.AbsoluteSize.X/2)

				NewColor = Color3.fromHSV(math.clamp(h, 0, 1), math.clamp(s, 0, 1), math.clamp(1-OscuridadPorcentaje, 0, 1))
				OriginalColor = Color3.fromHSV(math.clamp(h, 0, 1), math.clamp(s, 0, 1), 1)

				Connection.OnColorChanged:Fire(NewColor)

			end
		end

		ColorJanitor:AddConnection(UserInputService.InputChanged:Connect(function(Input)
			if not buttonDown or (Input.UserInputType ~= Enum.UserInputType.MouseMovement and Input.UserInputType ~= Enum.UserInputType.Touch) then return end
			UpdateColor()
		end),nil,{})

		ColorJanitor:AddConnection(Connection.OnColorChanged.Event:Connect(function()
			UpdateAspect(NewColor,OriginalColor)
		end),nil,{})

		ColorJanitor:AddConnection(UserInputService.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
				buttonDown = true
				UpdateColor()
			end
		end),nil,{})

		for i, child in ipairs(AllColors) do
			child.Active = true
			ColorJanitor:AddConnection(child.MouseButton1Up:Connect(function()
				NewColor = child.BackgroundColor3
				OscuridadPorcentaje = GetDarkness(NewColor)
				OriginalColor = SetDarkness(NewColor,0)
				Connection.OnColorChanged:Fire(NewColor)
			end),nil,{})
		end

		ColorJanitor:AddConnection(UserInputService.InputEnded:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
				buttonDown = false
			end
		end),nil,{})

		ColorJanitor:AddConnection(
			UserInputService.InputEnded:Connect(function(input)
				if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
					SliderState = false
				end
			end),nil,{}
		)

		function Connection.SetFirstColor(color:Color3)
			module.ActualColor = color
			NewColor = color
			OscuridadPorcentaje = GetDarkness(NewColor)
			OriginalColor = SetDarkness(NewColor,0)
			ColorSelector.Visible = true
			Connection.OnColorChanged:Fire(NewColor)
		end

		function Connection.SetColor(color:Color3)
			NewColor = color
			OscuridadPorcentaje = GetDarkness(NewColor)
			OriginalColor = SetDarkness(NewColor,0)
			local mousePos = UIFuncs.ApplyGuiInset(UIFuncs.GetPointerPosition(),ScreenGui)
			Connection.OnColorChanged:Fire(NewColor)
		end

		function Connection.CloseCancelando()
			CancelFunc()
		end

		function Connection.CloseConfirmando()
			ConfirmFunc()
		end

		return Connection
	end

	return module

end)()

