		local function RemoveLinkLimitFunc(Link)
			if Link and Link.Parent then

				local ConfigurationsFolder = Link:FindFirstChild("Configuration")
				if not ConfigurationsFolder then return end

				local LinkConfiguration = ConfigurationsFolder:FindFirstChild("Link")
				if not LinkConfiguration then return end

				local Attribute = LinkConfiguration:GetAttribute("MaxLinks")
				if Attribute == nil then return end

				LinkConfiguration:SetAttribute("MaxLinks", math.huge)

			end
		end

		local RemoveLinksLimitWaitObject = WaitFunc.new(250)
		local function buttonfunc()
			Notification.Notify("Removing limits... \n Please wait", 3)
			for i, child in ipairs(BuildModel:GetChildren()) do
				RemoveLinksLimitWaitObject:Wait()
				RemoveLinkLimitFunc(child)
			end
			Notification.Notify("Limits removed!", 3)
		end
		GlobalJanitor:AddConnection(
			RemoveLimitsConn.ButtonClicked.Event:Connect(buttonfunc),nil,{Destruir = true}
		)	
		if Configurations.RemoveAutomaticallyLinksLimits then
			buttonfunc()
		end

