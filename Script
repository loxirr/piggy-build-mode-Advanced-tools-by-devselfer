		if Name == "1" then
			Vector = Vector3.new(1,0,0)
			StartPosition = Vector3.new(
				RayCast.Position.X,
				StartPosition.Y,
				StartPosition.Z
			)

		elseif Name == "2" then
			Vector = Vector3.new(-1,0,0)
			StartPosition = Vector3.new(
				RayCast.Position.X,
				StartPosition.Y,
				StartPosition.Z
			)

		elseif Name == "3" then
			Vector = Vector3.new(0,-1,0)
			StartPosition = Vector3.new(
				StartPosition.X,
				RayCast.Position.Y,
				StartPosition.Z
			)
		elseif Name == "4" then
			Vector = Vector3.new(0,1,0)
			StartPosition = Vector3.new(
				StartPosition.X,
				RayCast.Position.Y,
				StartPosition.Z
			)

		elseif Name == "5" then
			Vector = Vector3.new(0,0,-1)
			StartPosition = Vector3.new(
				StartPosition.X,
				StartPosition.Y,
				RayCast.Position.Z
			)

		elseif Name == "6" then
			Vector = Vector3.new(0,0,1)
			StartPosition = Vector3.new(
				StartPosition.X,
				StartPosition.Y,
				RayCast.Position.Z
			)


		elseif Name == "7" then
			Vector = Vector3.new(1,1,1)
			StartPosition = Vector3.new(
				StartPosition.X,
				StartPosition.Y,
				StartPosition.Z
			)

		end

		if not Vector then return warn("NoVector") end

		return FinalModel,StartPosition, Vector
	end

