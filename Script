			local function UpdateAll(Position,Size,Color,Material,Rotation)
				BucleBreaker:Cleanup()
				local RomperBucle = false
				BucleBreaker:AddTask(function()
					RomperBucle = true
				end,nil,{})

				--informacion de undo
				local tablaclonada = table.clone(SelectedTargets)
				local UndoInformation = CreateUndoObject()
				UndoInformation.Type = "modification"
				UndoInformation.Changes = {tablaclonada}
				local cached = UndoInformation.Changes

				PushUndoObject(UndoInformation)

				ToolsWaitObject:SetCalculatePerFrame(Configurations.ReplicationPerFrame)
				for i, child in ipairs(tablaclonada) do

					if not child then continue end
					local ThisBlockPosition = child:GetPivot()
					table.insert(cached,{
						child,
						ThisBlockPosition,
						child:GetExtentsSize(),
						child:GetAttribute("Color"),
						child:GetAttribute("Material")
					})
					local RealPosition
					if Position then
						RealPosition = CFrame.new(
							Position.X or ThisBlockPosition.Position.X,
							Position.Y or ThisBlockPosition.Position.Y,
							Position.Z or ThisBlockPosition.Position.Z
						)
					else
						RealPosition = ThisBlockPosition
					end
					if RealPosition and Rotation then
						RealPosition = CFrame.new(RealPosition.Position) * CFrame.Angles(math.rad(Rotation.X),math.rad(Rotation.Y),math.rad(Rotation.Z))
					end
					if Size then
						local ChildSize = child:GetExtentsSize()
						Size = Vector3.new(
							Size.X or ChildSize.X,
							Size.Y or ChildSize.Y,
							Size.Z or ChildSize.Z
						)
					end

					task.defer(function()
						BuildFunctionsAdvanced.AdvancedModification(
							child,
							RealPosition,
							Size,
							Color,
							Material,
							false
						)
					end)
					if RomperBucle then return end
					ToolsWaitObject:Wait()
				end
			end

