local Janitor = (function()
	local Janitor = {}

	local JanitorObj = {}
	function JanitorObj.Add(self:JanitorObj,obj)
		table.insert(self.Tasks, obj)
		return obj
	end

	function JanitorObj.Cleanup(self: JanitorObj)

		local function CleanupObject(obj)
			if not obj then return end

			local t = typeof(obj)

			-- Tipos primitivos (se ignoran)
			if t == "number" or t == "string" or t == "boolean" or t == "EnumItem" then
				return
			end

			-- Roblox types
			if t == "RBXScriptConnection" then
				pcall(function()
					obj:Disconnect()
				end)
				return
			end

			if t == "Instance" then
				if obj.Destroy and obj.Parent then
					pcall(function()
						obj:Destroy()
					end)
				end
				return
			end

			-- Threads
			if t == "thread" then
				pcall(function()
					task.cancel(obj)
				end)
				return
			end

			-- Funciones
			if t == "function" then
				pcall(function()
					obj()
				end)
				return
			end

			-- Tablas (más potente 👇)
			if t == "table" then
				-- Si tiene método Cleanup (tipo Janitor u otros sistemas)
				if typeof(obj.Cleanup) == "function" then
					pcall(function()
						obj:Cleanup()
					end)
					return
				end

				-- Si tiene Destroy personalizado
				if typeof(obj.Destroy) == "function" then
					pcall(function()
						obj:Destroy()
					end)
					return
				end

				-- Si tiene Disconnect personalizado
				if typeof(obj.Disconnect) == "function" then
					pcall(function()
						obj:Disconnect()
					end)
					return
				end

				-- Recursivo como fallback
				for _, v in pairs(obj) do
					CleanupObject(v)
				end

				table.clear(obj)
				return
			end
		end

		for i = #self.Tasks, 1, -1 do
			CleanupObject(self.Tasks[i])
			self.Tasks[i] = nil
		end

		table.clear(self.Tasks)
	end

	function JanitorObj.Destroy(self:JanitorObj)
		self:Cleanup()
		self.Destroyed = true
	end

	function JanitorObj.IsDestroyed(self:JanitorObj)
		return self.Destroyed
	end

	function Janitor.new()
		return setmetatable({
			Tasks = {},
			Destroyed = false
		}, {__index = JanitorObj}) :: JanitorObj
	end

	type Janitor = typeof(Janitor) & {

	}

	type JanitorObj = typeof(JanitorObj) & {

	}

	return Janitor :: Janitor
end)()


local function ResizeModel(Model: Model, NewSize: Vector3)
	local initialSize = Model:GetAttribute("InitialSizeForFunction")
	local pivot = Model:GetAttribute("InitialPivotForFunction")

	if not initialSize or not pivot then 
		pivot = Model:GetPivot()
		initialSize = Model:GetExtentsSize()
		Model:SetAttribute("InitialPivotForFunction", pivot)
		Model:SetAttribute("InitialSizeForFunction", initialSize)

		for _, child in ipairs(Model:GetDescendants()) do
			if child:IsA("BasePart") and not child:HasTag("Input") then
				child:SetAttribute("InitialSizeForFunction", child.Size)

				-- Guardamos el CFrame relativo al pivot
				local relativeCFrame = pivot:ToObjectSpace(child.CFrame)
				child:SetAttribute("RelativeCfForFunction", relativeCFrame)
			end
		end
	end

	local PivotAnterior = Model:GetPivot()
	Model:PivotTo(pivot)

	-- Factor de escala por eje
	local scale = Vector3.new(
		NewSize.X / initialSize.X,
		NewSize.Y / initialSize.Y,
		NewSize.Z / initialSize.Z
	)

	for _, child in ipairs(Model:GetDescendants()) do
		if child:IsA("BasePart") and not child:HasTag("Input") then

			local initialSizePart = child:GetAttribute("InitialSizeForFunction")
			local relativeCf = child:GetAttribute("RelativeCfForFunction") -- Cambiado a minúscula para consistencia

			if initialSizePart and relativeCf then

				-- Escalar tamaño
				child.Size = Vector3.new(
					initialSizePart.X * scale.X,
					initialSizePart.Y * scale.Y,
					initialSizePart.Z * scale.Z
				)

				-- Escalar posición relativa
				local scaledPos = Vector3.new(
					relativeCf.Position.X * scale.X,
					relativeCf.Position.Y * scale.Y,
					relativeCf.Position.Z * scale.Z
				)

				-- Aplicar nuevo CFrame correctamente
				local rot = relativeCf - relativeCf.Position
				local newCf = CFrame.new(scaledPos) * rot
				child.CFrame = pivot * newCf
			end
		end
	end

	Model:PivotTo(PivotAnterior)
end

--basic build functions
local RemotesSimplificados = (function() 
	local Functions = {}

	local Folder = ReplicatedStorage:FindFirstChild("Functions")

	local BuildRemote = Folder:FindFirstChild("PlaceBlock")
	local DestroyRemote = Folder:FindFirstChild("DestroyBlock")
	local ResizeRemote = Folder:FindFirstChild("CommitResize")
	local MoveRemote = Folder:FindFirstChild("CommitMove")
	local FillRemote = Folder:FindFirstChild("FillBlock")
	local UpdateBlockSettings = Folder:FindFirstChild("UpdateBlockSettings")
	local UpdateBlockLink = Folder:FindFirstChild("UpdateBlockLink")
	local GetParentLinks = Folder:FindFirstChild("GetParentLinks")
	local GetChildLinks = Folder:FindFirstChild("GetChildLinks")

	function Functions.Build(
		block:Model,
		Position:CFrame,
		Color:BrickColor,
		Material:Enum.Material
	)
		return BuildRemote:InvokeServer(
			block,
			Position,
			Color,
			Material
		)

	end

	function Functions.Fill(
		block:Model,
		Color:BrickColor,
		Material:Enum.Material
	)
		return FillRemote:InvokeServer(
			block,
			Color,
			Material
		)
	end

	function Functions.GetConfigs(
		block:Model
	): (BrickColor,string)
		return block:GetAttribute("Color"), block:GetAttribute("Material")
	end

	function Functions.Destroy(
		block:Model
	)
		return DestroyRemote:InvokeServer(
			block
		)

	end

	function Functions.Resize(
		block:Model,
		Position:CFrame,
		Size:Vector3
	)
		block:PivotTo(Position)
		ResizeModel(block,Size)

		local Children = block:GetChildren()

		local RealChildren = table.create(#Children)
		for i, child in ipairs(Children) do
			if child:IsA("BasePart") then
				RealChildren[#RealChildren+1] = child
			end
		end
		local Data = table.create(#RealChildren*3)
		for i, child in ipairs(RealChildren) do
			local realI = i*3
			Data[realI-2] = child
			Data[realI-1] = child.CFrame
			Data[realI] = child.Size
		end

		local success, data = pcall(function()			
			return ResizeRemote:InvokeServer(
				block,
				Data
			)
		end)

		if success then
			return data
		else
			warn("Error al redimensionar el bloque:", data) -- Muestra el mensaje de error
		end

	end

	function Functions.Move(
		block:Model,
		Position:CFrame
	)
		return MoveRemote:InvokeServer(
			block,
			Position
		)

	end

	function Functions.SetSettings(
		block:Model,
		TableOfConfigurations:{
			[string]:any
		}
	)
		UpdateBlockSettings:InvokeServer(block,TableOfConfigurations)
	end

	function Functions.SetConnections(
		block:Model,
		TableOfConnections:{
			[number]:Model
		}
	)
		UpdateBlockLink:InvokeServer(block,TableOfConnections)
	end

	function Functions.GetParentConnections(
		block:Model
	)
		return GetParentLinks:InvokeServer(block)
	end

	function Functions.GetChildConnections(
		block:Model
	)
		return GetChildLinks:InvokeServer(block)
	end

	return Functions
end)()

