	--Herramientas avanzadas
	do
		local function GetCFrameDiference(InitialPosition:CFrame,Axis:Vector3,Model:Model,IsLocal:boolean)
			if not InitialPosition then warn("nil") return end
			if not Axis then warn("nil") return end

			Axis = Axis.Unit

			--Obtener folder de planos
			local function GetPlanesFolder()
				local Planes = workspace:FindFirstChild("PlanesContainer")
				if not Planes then
					Planes = Instance.new("Folder")
					Planes.Name = "PlanesContainer"
					Planes.Parent = workspace
					screenGuiJanitor:Add(Planes)
				end

				return Planes
			end

			local IsX = Axis.X ~= 0
			local IsY = Axis.Y ~= 0
			local IsZ = Axis.Z ~= 0

			if 
				not IsX and
				not IsY and
				not IsZ
			then
				warn("Axis is zero or invalid")
				return nil, nil
			end

			--Obtener plano
			local function GetPlane(ThisInitialPosition,ThisAxis)
				local Planes = GetPlanesFolder()

				-- Crear un plano (Parte invisible) perpendicular al eje
				local plane = Instance.new("Part")
				plane.Name = "MovementPlane"
				plane.Anchored = true
				plane.CanCollide = false
				plane.Transparency = 1
				plane.Material = Enum.Material.SmoothPlastic
				plane.Parent = Planes

				-- Poner Size y posicionar
				local min = 0.01
				local largeSize = 10000
				if IsX or IsZ then
					plane.Size = Vector3.new(largeSize, min, largeSize)
				elseif IsY then
					plane.Size = Vector3.new(min, largeSize, largeSize)
				end
				if IsLocal then
					plane.CFrame = ThisInitialPosition
				else
					plane.CFrame = CFrame.new(ThisInitialPosition.Position)
				end

				return plane, Planes
			end

			local Params = RaycastParams.new()
			local Planes
			if IsX and IsY and IsZ then
				Planes = GetPlanesFolder()

				local temp = {}

				for i = #Excluded,1,-1 do
					local child = Excluded[i]
					if not child or not child.Parent then 
						table.remove(Excluded,i)
						continue
					end
					table.insert(temp,child)
				end

				for i = #PlayersModels,1,-1 do
					local child = PlayersModels[i]
					if not child or not child.Parent then 
						table.remove(PlayersModels,i)
						continue
					end
					table.insert(temp,child)
				end

				if IgnoreInvisibleBlocks then
					for i = #TransparentBlocks,1,-1 do
						local child = TransparentBlocks[i]
						if not child or not child.Parent then 
							table.remove(TransparentBlocks,i)
							continue
						end
						table.insert(temp,child)
					end
				else
					table.clear(TransparentBlocks)
				end

				table.insert(temp,Model)

				Params.FilterDescendantsInstances = temp
			else
				local Plane
				Plane,Planes = GetPlane(InitialPosition,Axis)

				Params.FilterType = Enum.RaycastFilterType.Include
				Params.FilterDescendantsInstances = {Planes}
			end

			local Connection = {}

			function Connection.Disconnect()
				Planes:ClearAllChildren()
				table.clear(Connection)
			end

			function Connection.GetDiference() :CFrame

				local MouseToRay = CurrentCamera:ScreenPointToRay(Mouse.X,Mouse.Y)

				local Raycast = workspace:Raycast(MouseToRay.Origin,MouseToRay.Direction*1000,Params)
				if not Raycast then return end

				local RayCastPosition = Raycast.Position
				if IsLocal then
					RayCastPosition = InitialPosition:PointToObjectSpace(Raycast.Position)
				end
				local Position = InitialPosition.Position
				if IsLocal then
					Position = InitialPosition:PointToObjectSpace(InitialPosition.Position)
				end
				local Part = Raycast.Instance

				if IgnoreInvisibleBlocks and Part.Transparency == 1 then
					AddObjectToExclude(Part,TransparentBlocks)
				end

				local DiferenceX = 0
				local DiferenceY = 0
				local DiferenceZ = 0
				if IsX then
					DiferenceX = RayCastPosition.X-Position.X
				end
				if IsY then
					DiferenceY = RayCastPosition.Y-Position.Y
				end
				if IsZ then
					DiferenceZ = RayCastPosition.Z-Position.Z
				end

				return Vector3.new(DiferenceX,DiferenceY,DiferenceZ)
			end

			return Connection

		end

		local MousePressingState = false
		Mouse.Button1Down:Connect(function()
			MousePressingState = true
		end)
		Mouse.Button1Up:Connect(function()
