	Events.ConfigurationIsChanged.Event:Connect(function(id)
		if id == "RedoTask" then
			Redo()
		elseif id == "UndoTask" then
			Undo()
		elseif id == "DeleteTask" then
			if not ActualSelectedTargetingColor then return end
			if #SelectedTargets > 0 then
				if ToolsDisabled then return end
				ToolsDisabled = true
				OnToolsDisabledStateChanged:Fire()
				local information = table.clone(SelectedTargets)
				local UndoInformation = CreateUndoObject()
				UndoInformation.Type = "destroy"
				UndoInformation.Changes = {table.clone(SelectedTargets)}
				local InformationOfEliminated = UndoInformation.Changes
				for i = #information,1,-1 do
					local child = information[i]

					task.spawn(function()
						InformationOfEliminated[#InformationOfEliminated+1] = {
							GetBlockType(child),
							child:GetPivot(),
							child:GetExtentsSize(),
							child:GetAttribute("Color"),
							child:GetAttribute("Material")
						}
						BuildFunctionsAdvanced.AdvancedDestroy(child,false)
					end)

					task.wait(0.0166666666667)
				end

				PushUndoObject(UndoInformation)
				
				CreateBoxOfAllSelectedModels()
				ToolsDisabled = false
				OnToolsDisabledStateChanged:Fire()
			end
		elseif id == "DuplicateTask" then
			if not ActualSelectedTargetingColor then return end
			if #SelectedTargets > 0 then
				if ToolsDisabled then return end
				ToolsDisabled = true
				OnToolsDisabledStateChanged:Fire()

				local TableToSelect = table.clone(SelectedTargets)

				local OldLinks = {}

				local UndoInformation = CreateUndoObject()
				UndoInformation.Type = "add"
				UndoInformation.Changes = {TableToSelect}
				local cached = UndoInformation.Changes
				DeselectAll()
				local Max = #TableToSelect
				for i, child in ipairs(TableToSelect) do
					task.spawn(function()
						local Pos = child:GetPivot()
						local Size = child:GetExtentsSize()
						local color = child:GetAttribute("Color")
						local material = child:GetAttribute("Material")
						local block = BuildFunctionsAdvanced.AdvancedBuild(
							GetBlockType(child),
							Pos,
							Size,
							color,
							material,
							true,
							false,
							nil,
							child:FindFirstChild("Configuration")
						)

						if block then
							if CheckIfIsLink(child) then
								OldLinks[child] = block
							end

							AddSelectedBlock(block,true,true)

							table.insert(cached,{
								block,
								Pos,
								Size,
								color,
								material
							})
						end

						if i == Max then
							if Configurations.CopiarConexionesAlDuplicar and next(OldLinks) then

								local ConectarDeInteriorAinterior = Configurations.CopiarConexionesDeInteriorAInterior	
								local ConectarDeInteriorAExterior = Configurations.CopiarConexionesDeInteriorAExterior
								local ConectarDeExteriorAInterior = Configurations.CopiarConexionesDeExteriorAinterior

								Notification.Notify("Copying connections...")

								local ParentsLinks = {}
								local Index = 1
								local Ended = {}

								for OldLink, NewLink in pairs(OldLinks) do
									if not OldLink or not OldLink.Parent or not NewLink or not NewLink.Parent then continue end

									local ActualIndex = Index
									Ended[ActualIndex] = false

									task.wait(0.06666666666666666666666666666667)

									task.spawn(function()

										-- =========================
										-- HIJOS (Child connections)
										-- =========================
										if ConectarDeInteriorAinterior 
											or ConectarDeInteriorAExterior then
											local NewLinkConnections = {}

											for _, child in ipairs(RemotesSimplificados.GetChildConnections(OldLink)) do
												local mapped = OldLinks[child]

												if mapped then
													if ConectarDeInteriorAinterior then
														table.insert(NewLinkConnections, mapped)
													end
												else
													if ConectarDeInteriorAExterior then
														table.insert(NewLinkConnections, child)
													end
												end
											end

											RemotesSimplificados.SetConnections(NewLink, NewLinkConnections)
										end

										-- =========================
										-- PADRES (Parent connections)
										-- =========================
										if ConectarDeExteriorAInterior then
											for _, parentLink in ipairs(RemotesSimplificados.GetParentConnections(OldLink)) do
												if OldLinks[parentLink] then continue end

												local parentConnections = ParentsLinks[parentLink] or RemotesSimplificados.GetChildConnections(parentLink)

												-- Evitar duplicados
												parentConnections[#parentConnections+1] = NewLink
												ParentsLinks[parentLink] = parentConnections
											end
										end

										Ended[ActualIndex] = true

									end)

									Index += 1
								end

								if ConectarDeExteriorAInterior then
									local function CheckIfEnded()
										local allended = true
										for _, ended in ipairs(Ended) do
											if not ended then
												allended = false
												break
											end
										end
										return allended
									end
									while true do
										task.wait(0.0166666667)
										local AllEnded = CheckIfEnded()
										if AllEnded then 
											task.wait(0.0166666667)
											AllEnded = CheckIfEnded()
											if AllEnded then 
												task.wait(0.0166666667)
												AllEnded = CheckIfEnded()
												if AllEnded then
													break
												end
											end
										end
									end
									for parentLink, parentConnections in pairs(ParentsLinks) do
										if not parentLink or not parentLink.Parent then continue end
										task.spawn(function()
											RemotesSimplificados.SetConnections(parentLink, parentConnections)
										end)

										task.wait(0.01666666667)
									end
								end

								Notification.Notify("Connections copied!")
							end


							PushUndoObject(UndoInformation)

							CreateBoxOfAllSelectedModels()
							OnSelectedTargetsChanged:Fire()
							ToolsDisabled = false
