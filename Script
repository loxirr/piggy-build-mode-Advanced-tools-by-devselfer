local function PlayerHasAdmin(TargetPlayer:Player)
	local function GetOwner()
		return tostring(OwnerValue and OwnerValue.Value or Player.Name)
	end
	local Name = tostring(TargetPlayer.Name)
	if RunService:IsStudio() or Name == GetOwner() then
		return "Owner"
	end
	for i, child in ipairs(TeamBuilders:GetChildren()) do
		if Name == child.Name then
			return "Builder"
		end
	end
end

local function PlayerIsOwner(PlayerTargeted)
	local AdminType = PlayerHasAdmin(PlayerTargeted)
	return AdminType and AdminType == "Owner"
end

local function PlayerIsBuilder(PlayerTargeted)
	local AdminType = PlayerHasAdmin(PlayerTargeted)
	return AdminType and AdminType == "Builder"
end

local function PlayerCanBuild(PlayerTargeted)
	local GameIsRunning 
	if GameRunning then
		GameIsRunning = GameRunning.Value
	else
		GameIsRunning = false
	end
	local result = PlayerHasAdmin(PlayerTargeted) and not GameIsRunning
	return result
end

local function ResizeModel(Model: Model, Size:Vector3, IsScale:boolean?,ChangesPosition:boolean?)
	if not PlayerCanBuild(Player) then return end
	local NewScale
	if IsScale then
		NewScale = Size
	else
		NewScale,_,_ = GetScale(Model,Size)
	end

	for _, child in ipairs(Model:GetDescendants()) do
		if child:IsA("BasePart") then
			local initial = child:GetAttribute("InitialSizeForFunction")
			child.Size = Vector3.new(
				math.abs(initial.X * NewScale.X),
				math.abs(initial.Y * NewScale.Y),
				math.abs(initial.Z * NewScale.Z)
			)
		end
	end
end

