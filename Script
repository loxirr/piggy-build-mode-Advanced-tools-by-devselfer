		local Teams = {}
		for i, child in ipairs(ActualPlayers) do
			local team = child.Team
			local TeamName = team and tostring(team.Name) or "Neutral"
			local ColorTeam = team and child.TeamColor or Color3.new(1, 1, 1)
			table.insert(Teams,{TeamName,ColorTeam})
