	end
	
	local function Load(ID:string,Frame:GuiObject,PropertyToSave:{string})
	
		assert(ID, "No ID")
		assert(Frame, "No Frame")
		assert(PropertyToSave, "No PropertyToSave")
		
		data.Update(function(OldData: {any}?): {any}? 
			local FrameData = OldData[ID]
			if FrameData then
				for i, child in ipairs(PropertyToSave) do
					if FrameData and FrameData[child] then
						Frame[child] = FrameData[child]
					end
				end
			else
				Save(ID,Frame,PropertyToSave)
			end
			return OldData
		end)
	end
	
	local AllDataShared = ModulesTable["AllDataShared0"]
	local GlobalJanitor = AllDataShared.GlobalJanitor
	GlobalJanitor:AddThread(
		task.spawn(function()
			while true do
				task.wait(1)
	
				data.Update(function(olddata)
	
					for Frame, Dat in pairs(TableModule.DeepCopy(Cache)) do
						Save(Dat.ID,Frame,Dat.PropertyToSave)
					end
	
					return olddata
				end)
			end
		end),nil,{Destruir = true}
	)
	
	local IdsUsed = {}
	
	function module.RestoreFramePosition(Frame:GuiBase,ID:string,PropertyToSave:{string})
	
		assert(ID, "No ID")
		assert(Frame, "No Frame")
		assert(PropertyToSave, "No PropertyToSave")	
	
		Load(ID,Frame,PropertyToSave)
	
		if not Cache[Frame] and not IdsUsed[IdsUsed] then
			IdsUsed[ID] = true
			Cache[Frame] = {
				ID = ID,
				PropertyToSave = PropertyToSave,
			}
			local tempjanitor = Janitor.new()
			GlobalJanitor:AddJanitor(tempjanitor,nil,{Destruir = true, DestruirTarget = true})
			GlobalJanitor:LinkToInstance(Frame,nil,{Destruir = true})
			
			tempjanitor:AddTask(function()
				Cache[Frame] = nil
				IdsUsed[ID] = nil
			end,nil,{Destruir = true})
			tempjanitor:AddConnection(Frame.Changed:Connect(function(property: string) 
				if table.find(PropertyToSave,property) then
					Save(ID,Frame,PropertyToSave)
				end
			end),nil,{Destruir = true})
		end
		
	end
	
	return module
	
end)()
