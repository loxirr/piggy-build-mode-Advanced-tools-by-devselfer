							end

							if ActualInputTarget ~= TargetInput then
								if ActualInputTarget then
									for i, child in ipairs(ActualInputTarget:GetDescendants()) do
										AddHighlightToModel(
											child,
											ActualColors.NoSelected,
											ActualColors.NoSelected,
											0,
											0
										)
									end
								end
								if TargetInput then
									for i, child in ipairs(TargetInput:GetDescendants()) do
										AddHighlightToModel(
											child,
											ActualColors.Selected,
											ActualColors.Selected,
											0,
											0
										)
									end
								end
								ActualInputTarget = TargetInput
							end
						else
							local _,NormPos,Norm = GetInputTarget(Inputs)
							local Cf = ActualClicked:GetPivot()

							if NormPos and Norm and Cf then

								if not StartCFrame then
									StartCFrame = Cf
								end
								if not Normal then
									Normal = Norm
								end
								if not StartCframeInput and StartCFrame then
									StartCframeInput = CFrame.new(NormPos) * StartCFrame.Rotation
								end

								if not CframeCalculator then
									CframeCalculator = GetCFrameDiference(StartCframeInput,Normal,ActualClicked,MoveToolIsLocal)
								end
							end

							if StartCFrame and Normal and StartCframeInput and CframeCalculator then
								local PosDiference = CframeCalculator.GetDiference()

								if PosDiference then

									if ActualToolGridState then

										local function ApplyToolGrid(Number)
											return (Number // ToolGrid)*ToolGrid
										end

										PosDiference = Vector3.new(
											ApplyToolGrid(PosDiference.X),
											ApplyToolGrid(PosDiference.Y),
											ApplyToolGrid(PosDiference.Z)
										)
									end

									if MoveToolIsLocal then
										ActualFinalCframe = StartCFrame*CFrame.new(PosDiference)
									else
										ActualFinalCframe = StartCFrame.Position + PosDiference
										ActualFinalCframe = CFrame.new(ActualFinalCframe) * StartCFrame.Rotation
									end
									ActualClicked:PivotTo(ActualFinalCframe)
									RemoveBorders(ActualClicked)
									CreateBorders(ActualClicked,ActualColors.Selected)
									Inputs = CreateInputs(ActualClicked,ActualColors.NoSelected,FlechaExample,true,MoveToolIsLocal)

								end
							end
						end

					end

					--NormalTarget

					--Obtener targets
					local NewTarget = GetTarget()
					local AnteriorTarget = ActualTarget
					ActualTarget = NewTarget

					--condicionales
					local TargetIsNew = not ActualTarget or not AnteriorTarget or ActualTarget ~= AnteriorTarget


					--Poner y quitar bordes
					if TargetIsNew then

						--condicionales
						local AnteriorTargetIsClicked = ActualClicked and AnteriorTarget and AnteriorTarget == ActualClicked
						local TargetIsClicked = ActualClicked and ActualTarget and ActualTarget == ActualClicked

						--si el anterior es clicked ponerle otro color, en contrario caso quitarle bordes
						if AnteriorTargetIsClicked then
							CreateBorders(AnteriorTarget,ActualColors.Selected)
						else
							RemoveBorders(AnteriorTarget)
						end

						--si el nuevo es clicked ponerle otro color, en otro caso ponerles bordes
						if TargetIsClicked then
							CreateBorders(ActualTarget,ActualColors.Selected)
						else
							CreateBorders(ActualTarget,ActualColors.NoSelected)
						end
					end

				end

			end))

			AddToClean(Mouse.Button1Down:Connect(function()
				if ActualState == "position" and not ActualInputTarget then
					Inputs = nil
					RemoveBorders(ActualClicked)
					ActualClicked = ActualTarget
					CreateBorders(ActualClicked,ActualColors.Selected)
					Inputs = CreateInputs(ActualClicked,ActualColors.NoSelected,FlechaExample,true,MoveToolIsLocal)
				end
			end))

			AddToClean(Events.StateChanged.Event:Connect(function()
				RemoveBorders(ActualTarget)
				RemoveBorders(ActualClicked)
				ActualTarget = nil
				ActualClicked = nil
				ActualTarget = nil
				ActualClicked = nil
				Inputs = nil
				Normal = nil
				StartCFrame = nil
				StartCframeInput = nil
				if CframeCalculator then
					CframeCalculator.Disconnect()
					CframeCalculator = nil
				end
				ActualInputTarget = nil
				ActualFinalCframe = nil
