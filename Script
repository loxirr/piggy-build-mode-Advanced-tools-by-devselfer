							for i, child in ipairs(SelectedTargets) do
								local RealInitialSize = child:GetAttribute("InitialSize")
								child:PivotTo(child:GetAttribute("InitialPosition") * CFrame.new(NewPositionX,NewPositionY,NewPositionZ))
								ResizeModel(child,RealInitialSize,RealInitialSize + Vector3.new(OffsetX,OffsetY,OffsetZ))
							end
						end
					end

					LastDistance = distance
				end))

				HandleJanitor:Add(Handles)
				HandleJanitor:Add(Handles.Destroying:Connect(function()
					HandleJanitor:Destroy()
				end))

				screenGuiJanitor:Add(HandleJanitor)
			end

			AddToClean(Events.StateChanged.Event:Connect(function()
				if ActualState == "resize" then
					ActualSelectedTargetingColor = Color3.new(0.72549, 0.568627, 0)
					ActualTargetingBorderColor = Color3.new(1, 0.784314, 0)
					ActualHandleFunc = CreateHandles
					ChangingSelectedBlocksState = true
					LocalStateInBox = true
					UpdateBorders()
					CreateHandles()
				else
					if Handles then
						Handles:Destroy()
						Handles = nil
					end
				end
			end))
		end

		--Rotar
		do

			local Handles

			local function CreateHandles()

				if Handles then
					Handles:Destroy()
					Handles = nil
				end

				if ToolsDisabled then return end

				local Act = SelectedTargets[#SelectedTargets]
				if not Act then
					return
				end

				local HandleJanitor = Janitor.new()
				local InitialPivot = Act:GetPivot()
				local center = InitialPivot.Position
				for i, child in ipairs(SelectedTargets) do
					child:SetAttribute("InitialCFrame",child:GetPivot())
				end

				Handles = Instance.new("ArcHandles")
				Handles.Parent = PlayerGui
				Handles.Adornee = BoxOfAllSelectedModels

				HandleJanitor:Add(function()
					MultiSelectEnabled = true
				end)

				HandleJanitor:Add(OnToolsDisabledStateChanged.Event:Connect(function()
					if ToolsDisabled then
						HandleJanitor:Destroy()
					end
				end))

				HandleJanitor:Add(Handles.MouseButton1Up:Connect(function()
					if ToolsDisabled then return end
					ToolsDisabled = true
					HandleJanitor:Destroy()
					OnToolsDisabledStateChanged:Fire()

					MultiSelectEnabled = true
					UpdateBox = true
					InitialPivot = Act:GetPivot()
					center = InitialPivot.Position
					local UndoInformation = CreateUndoObject()
					UndoInformation.Type = "modification"
					UndoInformation.Changes = {
						table.clone(SelectedTargets)
					}
					local cache = UndoInformation.Changes
					local Information = {}
					for i = #SelectedTargets, 1, -1 do
						local child = SelectedTargets[i]
							Information[i] = {child,child:GetPivot()}
						cache[#cache+1] = {
							child,
							child:GetAttribute("InitialCFrame"),
							child:GetExtentsSize(),
							child:GetAttribute("Color"),
							child:GetAttribute("Material")
						}
					end
					for i, child in ipairs(Information) do
						task.spawn(function()
							BuildFunctions.Move(child[1],child[2])
						end)
						task.wait()
						task.wait()
						task.wait()
					end
					PushUndoObject(UndoInformation)

					ToolsDisabled = false
					OnToolsDisabledStateChanged:Fire()
				end))

				HandleJanitor:Add(Handles.MouseButton1Down:Connect(function()
					UpdateBox = false
					MultiSelectEnabled = false
					HandleJanitor = Janitor.new()
					InitialPivot = Act:GetPivot()
					center = InitialPivot.Position
					for i, child in ipairs(SelectedTargets) do
						child:SetAttribute("InitialCFrame",child:GetPivot())
					end
				end))

				HandleJanitor:Add(Handles.MouseDrag:Connect(function(axis, angle)
					local Vec

					if ActualToolGridState and ActualRotationGrid > 0 then
						local actrot = math.rad(ActualRotationGrid)
						angle = (angle // actrot)*actrot
					end

					if axis == Enum.Axis.X then
						Vec = Vector3.new(1,0,0)
					elseif axis == Enum.Axis.Y then
						Vec = Vector3.new(0,1,0)
					elseif axis == Enum.Axis.Z then
						Vec = Vector3.new(0,0,1)
					end

					local rotation = CFrame.fromAxisAngle(Vec, angle)

					for _, child in ipairs(SelectedTargets) do
						local InitialCFrame = child:GetAttribute("InitialCFrame")

						local offset = InitialCFrame.Position - center
						local rotatedOffset = rotation:VectorToWorldSpace(offset)

						local newPosition = center + rotatedOffset
						local newRotation = rotation * InitialCFrame.Rotation

						child:PivotTo(CFrame.new(newPosition) * newRotation)
					end
				end))

				HandleJanitor:Add(Handles)
				HandleJanitor:Add(Handles.Destroying:Connect(function()
					HandleJanitor:Destroy()
				end))

				screenGuiJanitor:Add(HandleJanitor)
			end

			AddToClean(Events.StateChanged.Event:Connect(function()
				if ActualState == "rote" then
					ActualSelectedTargetingColor = Color3.new(0.647059, 0, 0.592157)
					ActualTargetingBorderColor = Color3.new(1, 0, 0.901961)
					ActualHandleFunc = CreateHandles
					ChangingSelectedBlocksState = true
					LocalStateInBox = false
					UpdateBorders()
					CreateHandles()
				else
					if Handles then
						Handles:Destroy()
						Handles = nil
					end
				end
			end))
		end

	end
end

