						elseif Face == Enum.NormalId.Left then
							distance = -DiferencePositions.X 
						elseif Face == Enum.NormalId.Top then
							distance = DiferencePositions.Y 
						elseif Face == Enum.NormalId.Bottom then
							distance = -DiferencePositions.Y 
						elseif Face == Enum.NormalId.Back then
							distance = DiferencePositions.Z 
						elseif Face == Enum.NormalId.Front then
							distance = -DiferencePositions.Z 
						end
					end
					distance = math.min(distance,2000)
					if ActualToolGridState and ToolGrid > 0 then
						distance = SnapToGrid(distance, ToolGrid)
					end

					if Configurations.EstirarEnAmbosEjes then

						if Configurations.EstirarProporcionalmente then

							local AxisNewSize
							local AxisInitialSize

							if Face == Enum.NormalId.Right then
								AxisInitialSize = InitialSize.X
							elseif Face == Enum.NormalId.Left then
								AxisInitialSize = InitialSize.X
							elseif Face == Enum.NormalId.Top then
								AxisInitialSize = InitialSize.Y
							elseif Face == Enum.NormalId.Bottom then
								AxisInitialSize = InitialSize.Y
							elseif Face == Enum.NormalId.Back then
								AxisInitialSize = InitialSize.Z
							elseif Face == Enum.NormalId.Front then
								AxisInitialSize = InitialSize.Z
							end
							AxisNewSize = AxisInitialSize + distance

							if ActualToolGridState and ToolGrid > 0 then
								AxisNewSize = SnapToGrid(AxisNewSize, ToolGrid)
							end

							local Calculo = (AxisNewSize / AxisInitialSize)
							if Configurations.EstirarProporcionalmenteEnGrupo and #SelectedTargets > 1 then

								for _, child in ipairs(SelectedTargets) do
									local InitialScale = child:GetAttribute("InitialScale")
									local InitialCFrame = child:GetAttribute("InitialPosition")

									local NewScale = Calculo * InitialScale
									if NewScale <= 0 then
										NewScale = 0.001
									end

									-- Escalar tamaño
									child:ScaleTo(NewScale)

									local offset = InitialCFrame.Position - center
									local newOffset = offset * Calculo
									local newPosition = center + newOffset

									-- Mantener rotación original
									child:PivotTo(CFrame.new(newPosition) * InitialCFrame.Rotation)
								end
							else
								for i, child in ipairs(SelectedTargets) do
									local InitialScale = child:GetAttribute("InitialScale")
									local NewScale = Calculo*InitialScale
									if NewScale <= 0 then
										NewScale = 0.001
									end

									child:ScaleTo(NewScale)
								end
							end
						else
							distance *= 2

							local OffsetX = 0
							local OffsetY = 0
							local OffsetZ = 0

							if Face == Enum.NormalId.Right or Face == Enum.NormalId.Left then
								OffsetX = distance
							elseif Face == Enum.NormalId.Top or Face == Enum.NormalId.Bottom then
								OffsetY = distance
							elseif Face == Enum.NormalId.Back or Face == Enum.NormalId.Front then
								OffsetZ = distance
							end

							for i, child in ipairs(SelectedTargets) do
								local realInitialSize = child:GetAttribute("InitialSize")
								ResizeModel(child,realInitialSize + Vector3.new(OffsetX,OffsetY,OffsetZ))
							end
						end
					else

						if Configurations.EstirarProporcionalmente then

							local AxisNewSize
							local AxisInitialSize

							local NewPositionX = 0
							local NewPositionY = 0
							local NewPositionZ = 0

							if Face == Enum.NormalId.Right then
								AxisInitialSize = InitialSize.X
								AxisNewSize = AxisInitialSize + distance
								if AxisNewSize > 0 then
									NewPositionX += distance/2
								else
									NewPositionX += -InitialSize.X/2
								end
							elseif Face == Enum.NormalId.Left then
								AxisInitialSize = InitialSize.X
								AxisNewSize = AxisInitialSize + distance
								if AxisNewSize > 0 then
									NewPositionX -= distance/2
								else
									NewPositionX -= -InitialSize.X/2
								end
							elseif Face == Enum.NormalId.Top then
								AxisInitialSize = InitialSize.Y
								AxisNewSize = AxisInitialSize + distance
								if AxisNewSize > 0 then
									NewPositionY += distance/2
								else
									NewPositionY += -InitialSize.Y/2
								end
							elseif Face == Enum.NormalId.Bottom then
								AxisInitialSize = InitialSize.Y
								AxisNewSize = AxisInitialSize + distance
								if AxisNewSize > 0 then
									NewPositionY -= distance/2
								else
									NewPositionY -= -InitialSize.Y/2
								end
							elseif Face == Enum.NormalId.Back then
								AxisInitialSize = InitialSize.Z
								AxisNewSize = AxisInitialSize + distance
								if AxisNewSize > 0 then
									NewPositionZ += distance/2
								else
									NewPositionZ += -InitialSize.Z/2
								end
							elseif Face == Enum.NormalId.Front then
								AxisInitialSize = InitialSize.Z
								AxisNewSize = AxisInitialSize + distance
								if AxisNewSize > 0 then
									NewPositionZ -= distance/2
								else
									NewPositionZ -= -InitialSize.Z/2
								end
							end

							local Calculo = AxisNewSize / AxisInitialSize
							if Configurations.EstirarProporcionalmenteEnGrupo then

								local AxisX = center.X
								local AxisY = center.Y
								local AxisZ = center.Z
								if Face == Enum.NormalId.Right then
									AxisX = center.X-(sizeBox.X/2)
								elseif Face == Enum.NormalId.Left then
									AxisX = center.X+(sizeBox.X/2)
								elseif Face == Enum.NormalId.Top then
									AxisY = center.Y-(sizeBox.Y/2)
								elseif Face == Enum.NormalId.Bottom then
									AxisY = center.Y+(sizeBox.Y/2)
								elseif Face == Enum.NormalId.Back then
									AxisZ = center.Z-(sizeBox.Z/2)
								elseif Face == Enum.NormalId.Front then
									AxisZ = center.Z+(sizeBox.Z/2)
								end
								local ThisCenter = Vector3.new(
									AxisX,
									AxisY,
									AxisZ
								)

								for i,child in ipairs(SelectedTargets) do

									local InitialScale = child:GetAttribute("InitialScale")
									local InitialCFrame = child:GetAttribute("InitialPosition")
									local NewScale = Calculo*InitialScale
									if NewScale <= 0 then
										NewScale = 0.001
									end
									child:ScaleTo(NewScale)

									local offset = InitialCFrame.Position - ThisCenter
									local newOffset = offset * Calculo
									local newPosition = ThisCenter + newOffset

									-- Mantener rotación original
									child:PivotTo(CFrame.new(newPosition) * InitialCFrame.Rotation)
								end
							else
								for i, child in ipairs(SelectedTargets) do
									local InitialScale = child:GetAttribute("InitialScale")
									local RealInitialPosition = child:GetAttribute("InitialPosition")
									local NewScale = Calculo*InitialScale
									if NewScale <= 0 then
										NewScale = 0.001
									end
									child:ScaleTo(NewScale)
									child:PivotTo(RealInitialPosition + Vector3.new(
										NewPositionX,
										NewPositionY,
										NewPositionZ
										))
								end
							end
						else

							local NewPositionX = 0
							local NewPositionY = 0
							local NewPositionZ = 0
							local OffsetX = 0
							local OffsetY = 0
							local OffsetZ = 0

							if Face == Enum.NormalId.Right then
								OffsetX = math.max(distance,-InitialSize.X+0.001)
								NewPositionX = (OffsetX/2)
							elseif Face == Enum.NormalId.Left then
								OffsetX = math.max(distance,-InitialSize.X+0.001)
								NewPositionX = -(OffsetX/2)
							elseif Face == Enum.NormalId.Top then
								OffsetY = math.max(distance,-InitialSize.Y+0.001)
								NewPositionY = (OffsetY/2)
							elseif Face == Enum.NormalId.Bottom then
								OffsetY = math.max(distance,-InitialSize.Y+0.001)
								NewPositionY = -(OffsetY/2)
							elseif Face == Enum.NormalId.Back then
								OffsetZ = math.max(distance,-InitialSize.Z+0.001)
								NewPositionZ = (OffsetZ/2)
							elseif Face == Enum.NormalId.Front then
								OffsetZ = math.max(distance,-InitialSize.Z+0.001)
								NewPositionZ = -(OffsetZ/2)
							end

							for i, child in ipairs(SelectedTargets) do
								local RealInitialSize = child:GetAttribute("InitialSize")
								child:PivotTo(child:GetAttribute("InitialPosition") * CFrame.new(NewPositionX,NewPositionY,NewPositionZ))
								ResizeModel(child,RealInitialSize + Vector3.new(OffsetX,OffsetY,OffsetZ))
							end
						end
					end

					LastDistance = distance
					CreateBoxOfAllSelectedModels()
				end))

				HandleJanitor:Add(Handles)
				HandleJanitor:Add(Handles.Destroying:Connect(function()
					HandleJanitor:Destroy()
				end))

				screenGuiJanitor:Add(HandleJanitor)
			end

			AddToClean(Events.StateChanged.Event:Connect(function()
				if ActualState == "resize" then
					ActualSelectedTargetingColor = Color3.new(0.72549, 0.568627, 0)
					ActualTargetingBorderColor = Color3.new(1, 0.784314, 0)
					ActualHandleFunc = CreateHandles
					ChangeSelectingStateOfNewBlocks = true
					LocalStateInBox = true
					MultiSelectEnabled = true
					UpdateBox = true
					UpdateBorders()
					CreateHandles()
					CreateBoxOfAllSelectedModels()
				else
					if Handles then
						Handles:Destroy()
						Handles = nil
					end
				end
			end))
		end

		--Rotar
		do

			local Handles

			local function CreateHandles()

				if Handles then
					Handles:Destroy()
					Handles = nil
				end

				if ToolsDisabled then return end

				local Act = SelectedTargets[#SelectedTargets]
				if not Act then
					return
				end

				local HandleJanitor = Janitor.new()
				local InitialPivot = Act:GetPivot()
				local Center,_ = GetCenter()
				for i, child in ipairs(SelectedTargets) do
					child:SetAttribute("InitialCFrame",child:GetPivot())
				end

				Handles = Instance.new("ArcHandles")
				Handles.Parent = PlayerGui
				Handles.Adornee = BoxOfAllSelectedModels

				HandleJanitor:Add(function()
					MultiSelectEnabled = true
				end)

				HandleJanitor:Add(OnToolsDisabledStateChanged.Event:Connect(function()
					if ToolsDisabled then
						HandleJanitor:Destroy()
					end
				end))

				HandleJanitor:Add(Handles.MouseButton1Up:Connect(function()
					local FinalRotationAct = Act:GetPivot().Rotation :: CFrame
					local InitialRotationAct = InitialPivot.Rotation :: CFrame
					local Diference = (Vector3.new(InitialRotationAct:ToEulerAnglesYXZ()) - Vector3.new(FinalRotationAct:ToEulerAnglesYXZ())).Magnitude
					if Diference <= 0 then
						return
					end

					if ToolsDisabled then return end
					ToolsDisabled = true
					OnToolsDisabledStateChanged:Fire()
					HandleJanitor:Destroy()

					MultiSelectEnabled = true
					UpdateBox = true

					local UndoInformation = CreateUndoObject()
					UndoInformation.Type = "modification"
					local cloned = table.clone(SelectedTargets)
					UndoInformation.Changes = {
						cloned,
					}
					local cached = UndoInformation.Changes
					for i, child in ipairs(cloned) do
						child:SetAttribute("FinalPosition",child:GetPivot())
						child:PivotTo(child:GetAttribute("InitialCFrame"))
					end
					for i, child in ipairs(cloned) do
						table.insert(cached,{
							child,
							child:GetAttribute("InitialCFrame"),
							child:GetExtentsSize(),
							child:GetAttribute("Color"),
							child:GetAttribute("Material")
						})
						task.spawn(function()
							BuildFunctionsAdvanced.AdvancedModification(
								child,
								child:GetAttribute("FinalPosition"),
								nil,
								nil,
								nil,
								false
							)
						end)
						task.wait(0.0166666666667)
					end
					PushUndoObject(UndoInformation)
					CreateBoxOfAllSelectedModels()

					ToolsDisabled = false
					OnToolsDisabledStateChanged:Fire()
				end))

				HandleJanitor:Add(Handles.MouseButton1Down:Connect(function()
					UpdateBox = false
					MultiSelectEnabled = false
					InitialPivot = Act:GetPivot()
					Center,_ = GetCenter()
					for i, child in ipairs(SelectedTargets) do
						child:SetAttribute("InitialCFrame",child:GetPivot())
					end
				end))

				HandleJanitor:Add(Handles.MouseDrag:Connect(function(axis, angle)
					local Vec

					if ActualToolGridState and ActualRotationGrid > 0 then
						angle = SnapToGrid(angle, math.rad(ActualRotationGrid))
					end

					if axis == Enum.Axis.X then
						Vec = Vector3.new(1,0,0)
					elseif axis == Enum.Axis.Y then
						Vec = Vector3.new(0,1,0)
					elseif axis == Enum.Axis.Z then
						Vec = Vector3.new(0,0,1)
					end

					local rotation = CFrame.fromAxisAngle(Vec, angle)

					if Configurations.RotarIndividualmente then
						for _, child in ipairs(SelectedTargets) do
							local InitialCFrame = child:GetAttribute("InitialCFrame")
							local newRotation = rotation * InitialCFrame.Rotation
							child:PivotTo(
								CFrame.new(
									InitialCFrame.Position
								) * newRotation
							)
						end
					else
						local center
						if Configurations.RotarseDesdeCentro then
							center = Center
						else
							center = InitialPivot.Position
						end
						for _, child in ipairs(SelectedTargets) do
							local InitialCFrame = child:GetAttribute("InitialCFrame")

							local offset = InitialCFrame.Position - center
							local rotatedOffset = rotation:VectorToWorldSpace(offset)

							local newPosition = center + rotatedOffset
							local newRotation = rotation * InitialCFrame.Rotation

							child:PivotTo(CFrame.new(newPosition) * newRotation)
						end	
					end
					CreateBoxOfAllSelectedModels()
				end))

				HandleJanitor:Add(Handles)

				HandleJanitor:Add(Handles.Destroying:Connect(function()
					HandleJanitor:Destroy()
				end))

				screenGuiJanitor:Add(HandleJanitor)
			end

			AddToClean(Events.StateChanged.Event:Connect(function()
				if ActualState == "rote" then
					ActualSelectedTargetingColor = Color3.new(0.160784, 0.596078, 0)
					ActualTargetingBorderColor = Color3.new(0, 1, 0)
					ActualHandleFunc = CreateHandles
					ChangeSelectingStateOfNewBlocks = true
					LocalStateInBox =  false
					MultiSelectEnabled = true
					UpdateBox = true
					UpdateBorders()
					CreateHandles()
					CreateBoxOfAllSelectedModels()
				else
					if Handles then
						Handles:Destroy()
						Handles = nil
					end
				end
			end))
		end

	end
end

