local WaitFunc = (function()
	local module = {}

	local WaitObject = {}

	function module.new(Frames:number)
		local self = setmetatable({}, {__index = WaitObject})
		self.Number = 0
		self.Frames = Frames or 5
		return self :: WaitObject
	end

	function WaitObject.Wait(self:WaitObject)
		local Number = self.Number
		Number += 1
		if Number >= self.Frames then
			Number = 0
			task.wait()
		end
		self.Number = Number
	end

	type WaitObject = typeof(WaitObject) & {

	}

	return module
end)()

