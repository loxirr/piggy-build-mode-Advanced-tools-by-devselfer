SetActualCreationModel(ActualCreationModel)
SetActualMaterial(ActualMaterial)
SetActualBrickColor(ActualBrickColor)

--Menu de seleccion de bloques
do 
	local objectsmenu = ScreenGui.objectsmenu
	local ScrollingFrame = objectsmenu.ScrollingFrame
	local Menus = objectsmenu.Menus :: Folder
	local MenuRemover = objectsmenu.MenuRemover :: TextButton

	AddToClean(MenuRemover.Activated:Connect(function()
		objectsmenu.Visible = false
	end))

	local ExampleMenuButton = ScrollingFrame.ExampleMenuButton :: TextButton
	local ExampleMenuFrame = Menus.ExampleMenuFrame :: Frame
	local ExampleModelButton = ExampleMenuFrame.ScrollingFrame.ExampleModelButton :: TextButton

	ExampleMenuButton.Parent = nil
	ExampleMenuFrame.Parent = nil
	ExampleModelButton.Parent = nil

	local ModelsTable = {}

	local function ButtonClicked(MenuFrame)
		for i, Menu in ipairs(Menus:GetChildren()) do
			Menu.Visible = false
		end
		MenuFrame.Visible = true
		ScrollingFrame.Visible = false
		MenuRemover.Visible = false
	end

	local function CloseButtonFunc(MenuFrame)
		MenuFrame.Visible = false
		ScrollingFrame.Visible = true
		MenuRemover.Visible = true
	end

	local function CreateModelButton(ObjectFolder:Folder,MenuFrame,Model:Model)

		local newbutton = ExampleModelButton:Clone()
		newbutton.Parent = MenuFrame:FindFirstChildOfClass("ScrollingFrame")
		newbutton.Name = ObjectFolder:GetAttribute("FriendlyName") or Model:GetAttribute("FriendlyName") or ObjectFolder.Name

		local ViewportFrame = newbutton:FindFirstChildOfClass("ViewportFrame")

		local Camera = ViewportFrame:FindFirstChildOfClass("Camera") or Instance.new("Camera")
		Camera.Parent = ViewportFrame

		ViewportFrame.CurrentCamera = Camera

		local ModelClon = Model:Clone()
		ModelClon.Parent = ViewportFrame
		ModelClon:PivotTo(CFrame.new())

		local function update()
			for i, child in ipairs(ModelClon:GetDescendants()) do
				if child:IsA("BasePart") and child.Name == "ColorPart" then
					child.BrickColor = ActualBrickColor
					child.Material = ActualMaterial
				end
			end
		end
		AddToClean(Events.BrickColorChanged.Event:Connect(update))
		AddToClean(Events.MaterialChanged.Event:Connect(update))
		update()

		ApuntaCamaraToItem(ViewportFrame,ViewportFrame:FindFirstChildOfClass("Camera"),ModelClon)

		local TextLabel = newbutton:FindFirstChildOfClass("TextLabel")
		TextLabel.Text = ObjectFolder.Name
		TextLabel.TextTransparency = 0
		TextLabel.ZIndex = 100

		AddToClean(newbutton.Activated:Connect(function()
			SetActualCreationModel(Model)
			objectsmenu.Visible = false
		end))

		local PivotAnterior = ModelClon:GetPivot()
		AddToClean(RunService.Heartbeat:Connect(function(delta)
			PivotAnterior = PivotAnterior * CFrame.Angles(0,math.rad(45*delta),0)
			ModelClon:PivotTo(PivotAnterior)
		end))

	end

	local function CreateMenu(MenuInstance:Folder)

		local TempDictionary = {}
		local TempArray = {}
		local Children = MenuInstance:GetChildren()
		for i, child in ipairs(Children) do
			local name = child.Name
			TempDictionary[name] = child
			TempArray[i] = name
		end

		table.sort(TempArray)

		local RealTable = {}
		for i, name in ipairs(TempArray) do
			RealTable[i] = TempDictionary[name]
		end

		table.clear(Children)
		table.clear(TempArray)
		table.clear(TempDictionary)

		local MenuFrame = ExampleMenuFrame:Clone()
		MenuFrame.Name = MenuInstance:GetAttribute("FriendlyName") or MenuInstance.Name
		MenuFrame.Parent = Menus
		MenuFrame.Visible = false

		local CloseButton = MenuFrame.CloseButton
		AddToClean(CloseButton.Activated:Connect(function()
			CloseButtonFunc(MenuFrame)
		end))

		local newbutton = ExampleMenuButton:Clone()
		newbutton.Parent = ScrollingFrame
		newbutton.Name = MenuInstance.Name

		AddToClean(newbutton.Activated:Connect(function()
			ButtonClicked(MenuFrame)
		end))

		local ModelFolder = RealTable[1]
		local Model = ModelFolder:FindFirstChildOfClass("Model")
		if not Model then
			warn("No se encontro el modelo en "..MenuInstance.Name)
		else

			local ViewportFrame = newbutton:FindFirstChildOfClass("ViewportFrame")

			local Camera = ViewportFrame:FindFirstChildOfClass("Camera") or Instance.new("Camera")
			Camera.Parent = ViewportFrame

			ViewportFrame.CurrentCamera = Camera

			local ModelClon = Model:Clone()
			ModelClon.Parent = ViewportFrame
			ModelClon:PivotTo(CFrame.new())

			local TextLabel = newbutton:FindFirstChildOfClass("TextLabel")
			TextLabel.Text = MenuInstance.Name
			TextLabel.TextTransparency = 0
			TextLabel.ZIndex = 100

			ApuntaCamaraToItem(ViewportFrame,ViewportFrame:FindFirstChildOfClass("Camera"),ModelClon)

			ModelsTable[ScrollingFrame] = ModelsTable[ScrollingFrame] or {}
			table.insert(ModelsTable[ScrollingFrame],{ModelClon})
		end

		for i, ObjectFolder:Folder in ipairs(RealTable) do
			WaitFunc(25)
			local Model = ObjectFolder:FindFirstChildOfClass("Model")
			if not Model then
				warn("No se encontro el modelo en "..ObjectFolder.Name)
				continue
			end

			CreateModelButton(ObjectFolder,MenuFrame,Model)
		end

	end


	local TempDictionary = {}
	local TempArray = {}
	local Children = BlocksFolder:GetChildren()
	for i, child in ipairs(Children) do
		local name = child.Name
		TempDictionary[name] = child
		TempArray[i] = name
	end

	table.sort(TempArray)

	local RealTable = {}
	for i, name in ipairs(TempArray) do
		RealTable[i] = TempDictionary[name]
	end

	table.clear(Children)
	table.clear(TempArray)
	table.clear(TempDictionary)
	for i, MenuInstance:Folder in ipairs(RealTable) do
		CreateMenu(MenuInstance)
	end

end

