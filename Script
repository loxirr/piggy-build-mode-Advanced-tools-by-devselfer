			)
			local function GetPLayersInServer()
				task.wait(0.1)
				PlayersInServerConn.SetText(Text .. tostring(#Players:GetChildren()))
				local ValueOwner = (Players:FindFirstChild(OwnerUsernameValue.Value) ~= nil)
				if ValueOwner ~= AnteriorValueOwner then
					if ValueOwner then
						Notification.Notify(
							"Owner joined the server",
							5,
							Color3.new(0.666667, 1, 0.498039)
						)
					else
						Notification.Notify(
							"Owner left the server",
							5,
							Color3.new(1, 0.203922, 0.203922)
						)
					end
				end
				AnteriorValueOwner = ValueOwner
				OwnerIsInServer.SetText("Owner is in server: " .. tostring(ValueOwner))
			end
