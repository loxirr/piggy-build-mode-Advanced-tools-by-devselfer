				local MouseRay = CurrentCamera:ScreenPointToRay(Mouse.X, Mouse.Y)
				local RayCast = workspace:Raycast(MouseRay.Origin, MouseRay.Direction * 1000, RayCastParams)

				if RayCast then
					local Part = RayCast.Instance
					if IgnoreInvisibleBlocks and Part.Transparency == 1 then
						AddObjectToExclude(Part,TransparentBlocks)
						return
					end

					local PositionResult = RayCast.Position

					local Normal = RayCast.Normal.Unit -- importante normalizar

					if ActualToolGridState then
						local absX = math.abs(Normal.X)
						local absY = math.abs(Normal.Y)
						local absZ = math.abs(Normal.Z)

						local XIsMax = absX > absY and absX > absZ
						local YIsMax = absY > absX and absY > absZ
						local ZIsMax = absZ > absX and absZ > absY

						PositionResult = Vector3.new(
							XIsMax and PositionResult.X or ((PositionResult.X // ToolGrid)*ToolGrid)+ToolGrid/2,
							YIsMax and PositionResult.Y or ((PositionResult.Y // ToolGrid)*ToolGrid)+ToolGrid/2,
							ZIsMax and PositionResult.Z or ((PositionResult.Z // ToolGrid)*ToolGrid)+ToolGrid/2
						)
					end

					local offset = ActualClonedModelSize / 2

					ActualClonedModel:PivotTo((CFrame.new(PositionResult) + (Normal * offset)) * CFrame.Angles(math.rad(RotationOffset.X),math.rad(RotationOffset.Y),math.rad(RotationOffset.Z)))
				end

