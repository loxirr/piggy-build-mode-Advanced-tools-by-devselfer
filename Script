	local function CreateMenu(MenuInstance:Folder)

		local RealTable = MenuInstance:GetChildren()

		local MenuFrame = ExampleMenuFrame:Clone()
		MenuFrame.Name = MenuInstance:GetAttribute("FriendlyName") or MenuInstance.Name
		MenuFrame.Parent = Menus
		MenuFrame.Visible = false

		local newbutton = ExampleMenuButton:Clone()
		newbutton.Parent = ScrollingFrame
		newbutton.Name = MenuInstance.Name

		GlobalJanitor:AddConnection(newbutton.MouseButton1Up:Connect(function()
			ButtonClicked(MenuFrame)
		end),nil,{Destruir = true})
		ButtonClicked(MenuFrame)

		local ModelFolder = RealTable[1]
		local Model = ModelFolder:FindFirstChildOfClass("Model")
		if not Model then
			warn("No se encontro el modelo en "..MenuInstance.Name)
		else

			local ViewportFrame = newbutton:FindFirstChildOfClass("ViewportFrame")

			local Camera = ViewportFrame:FindFirstChildOfClass("Camera") or Instance.new("Camera")
			Camera.Parent = ViewportFrame

			ViewportFrame.CurrentCamera = Camera

			local ModelClon = Model:Clone()
			ModelClon.Parent = ViewportFrame

			local HasNoTransparentParts = false
			local descendants = ModelClon:GetDescendants()
			for i, child in ipairs(descendants) do
				if child:IsA("BasePart") and child.Transparency < 1 then
					HasNoTransparentParts = true
					break
				end
			end

			if HasNoTransparentParts then
				for i, child in ipairs(descendants) do
					if child:IsA("BasePart") and child.Transparency >= 1 then
						child:Destroy()
					end
				end
			end
			table.clear(descendants)

			ModelClon.PrimaryPart = nil
			ModelClon:PivotTo(CFrame.new())
			local center,size = ModelClon:GetBoundingBox()
			local Offset = center:Inverse()
			local CF = CFrame.new()
			ModelClon:PivotTo((CF*Offset) * CFrame.Angles(0,math.rad(-90),0))
			ApuntaCamaraToItem(ViewportFrame,ViewportFrame:FindFirstChildOfClass("Camera"),ModelClon)

			local TextLabel = newbutton:FindFirstChildOfClass("TextLabel")
			TextLabel.Text = MenuInstance.Name
			TextLabel.ZIndex = 100
			UIFuncs.SetExtraInformationMessage(TextLabel,TextLabel.Text)
		end

		local WaitFuncObject = WaitFunc.new(25)
		for i, ObjectFolder:Folder in ipairs(RealTable) do
			local Model = ObjectFolder:FindFirstChildOfClass("Model")
			if not Model then
				warn("No se encontro el modelo en "..ObjectFolder.Name)
				continue
			end

			CreateModelButton(ObjectFolder,MenuFrame,Model)
			WaitFuncObject:Wait()
		end

	end


	local RealTable = BlocksFolder:GetChildren()
	for i, MenuInstance:Folder in ipairs(RealTable) do
		CreateMenu(MenuInstance)
	end

	local SearcherMenu = ExampleMenuFrame:Clone()
	SearcherMenu.Name = "Search"
	SearcherMenu.Parent = Menus
	SearcherMenu.Visible = false

	local Searcher = objectsmenu.Searcher.TextBox
	local ScrollingFrame = SearcherMenu.ScrollingFrame
	for name, button in pairs(ModelsTable) do
		button.Parent = ScrollingFrame
	end
	local function SearchFunc()
		local text = string.lower(Searcher.Text)
		if text == "" then
			for name, button in pairs(ModelsTable) do
				button.Visible = true
			end
		else
			for name, button in pairs(ModelsTable) do
				name = string.lower(tostring(name))
				local found = string.find(name, text, 1, true)
				button.Visible = found and true or false
			end
		end
		ButtonClicked(SearcherMenu)
	end
	GlobalJanitor:AddConnection(Searcher.FocusLost:Connect(SearchFunc),nil,{Destruir = true})
	GlobalJanitor:AddConnection(Searcher.Changed:Connect(function(p)
		if p == "Text" then
			SearchFunc()
		end
	end),nil,{Destruir = true})

