	--Funcion para obtener en que porcentaje esta el mouse en una barra de progreso
	function module.GetMousePercentageInBar(bar: GuiObject,ScreenGui): number
		local mousePos = module.ApplyGuiInset(module.GetPointerPosition(),ScreenGui)
		return math.clamp((mousePos.X - bar.AbsolutePosition.X) / bar.AbsoluteSize.X, 0, 1)
	end
	
	--Funcion para cambiar el anchorpoint de un frame pero volver a la posicion original
	--antes del cambio
	function module.SetAnchorPointWithoutMoving(gui: GuiObject, newAnchor: Vector2)
		local oldAnchor = gui.AnchorPoint
		local oldPos = gui.Position
		local size = gui.Size
	
		local deltaAnchor = newAnchor - oldAnchor
	
		gui.AnchorPoint = newAnchor
	
		gui.Position = UDim2.new(
			oldPos.X.Scale + size.X.Scale * deltaAnchor.X,
			oldPos.X.Offset + size.X.Offset * deltaAnchor.X,
			oldPos.Y.Scale + size.Y.Scale * deltaAnchor.Y,
			oldPos.Y.Offset + size.Y.Offset * deltaAnchor.Y
		)
	end
	
	function module.ScaleToOffset(Udim:UDim2,Parent:GuiObject):UDim2
		return UDim2.new(
			0,
			Udim.X.Scale * Parent.AbsoluteSize.X + Udim.X.Offset,
			0,
			Udim.Y.Scale * Parent.AbsoluteSize.Y + Udim.Y.Offset
		)
	end
	
	function module.OffsetToScale(Udim:UDim2,Parent:GuiObject):UDim2
		return UDim2.new(
			Udim.X.Offset / Parent.AbsoluteSize.X + Udim.X.Scale,
			0,
			Udim.Y.Offset / Parent.AbsoluteSize.Y + Udim.Y.Scale,
			0
		)
	end
	
	local FrameToSizes = Instance.new("Frame")
	--Funcion para obtener la posicion de un elemento en un anchorpoint simulando el anchor point dado
	function module.GetPositionWithOtherAnchorPointForThisAnchorPoint(Size,Position:UDim2,InitialAnchor, anchor: Vector2): UDim2
		FrameToSizes.AnchorPoint = anchor
		FrameToSizes.Position = Position
		FrameToSizes.Size = Size
		
		module.SetAnchorPointWithoutMoving(FrameToSizes,InitialAnchor)
		
		return FrameToSizes.Position
	end
	
	return module
	
