		assert(typeof(Array) == "table", ERR_ARRAY_TBL)
	
		if Index then
			assert(typeof(Index) == "string", ERR_INDEX_STR)
	
			local Arrays = self.ArraysWithIndex
			local existing = Arrays[Index]
			if existing then
				table.clear(existing)
				DebugModule.AdvancedDebugPrint(self.DebugState,
					"AddArray-Pooling",
					"REEMPLAZADO index: " .. Index,
					"ID: " .. self.ID,
					"Ins: " .. (InstruccionID or "No ins")
				)
			else
				DebugModule.AdvancedDebugPrint(self.DebugState,
					"AddArray-Pooling",
					"NUEVO index: " .. Index,
					"ID: " .. self.ID,
					"Ins: " .. (InstruccionID or "No ins")
				)
			end
			Arrays[Index] = Array
			return Array, Index
		end
	
		-- Sin índice: append directo, O(1) — sin shifting
		self.ActualArray += 1
		local idx: number = self.ActualArray
		local Result = self.Arrays[idx]
		if Result then
			self.Arrays[#self.Arrays+1] = Result
		end
		self.Arrays[idx] = Array
	
		DebugModule.AdvancedDebugPrint(self.DebugState,
			"AddArray-Pooling",
			"APPEND sin index: " .. idx,
			"ID: " .. self.ID,
			"Ins: " .. (InstruccionID or "No ins")
		)
		return Array, idx
	end
	
	-- ═══════════════════════════════════════════════════════════
	-- RemoveArray — Remueve un array por su index con nombre.
