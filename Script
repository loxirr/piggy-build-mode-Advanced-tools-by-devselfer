	local function PushUndoObject(UndoObject)
		if UndoStack[ActualStack+1] then
			for i = ActualStack+1, #UndoStack do
				local object = UndoStack[i]
				if object then
					table.clear(object.Changes)
					table.clear(object)
				end
				UndoStack[i] = nil
			end
		end
		UndoStack[#UndoStack+1] = UndoObject
		if #UndoStack > MaxStack then
			table.remove(UndoStack, 1)
		end
		ActualStack = #UndoStack
		table.clear(RedoStack)
	end

	--retorna la posicion y size, de la seleccion actual
	local function GetCenter(): (number,number)
		local min = Vector3.new(math.huge, math.huge, math.huge)
		local max = Vector3.new(-math.huge, -math.huge, -math.huge)

		for _, child in ipairs(SelectedTargets) do
			local cf, size = child:GetBoundingBox()

			local half = size / 2

			-- 8 esquinas del bounding box
			local corners = {
				cf * Vector3.new( half.X,  half.Y,  half.Z),
				cf * Vector3.new(-half.X,  half.Y,  half.Z),
				cf * Vector3.new( half.X, -half.Y,  half.Z),
				cf * Vector3.new(-half.X, -half.Y,  half.Z),
				cf * Vector3.new( half.X,  half.Y, -half.Z),
				cf * Vector3.new(-half.X,  half.Y, -half.Z),
				cf * Vector3.new( half.X, -half.Y, -half.Z),
				cf * Vector3.new(-half.X, -half.Y, -half.Z),
			}

			for _, corner in ipairs(corners) do
				min = Vector3.new(
					math.min(min.X, corner.X),
					math.min(min.Y, corner.Y),
					math.min(min.Z, corner.Z)
				)

				max = Vector3.new(
					math.max(max.X, corner.X),
					math.max(max.Y, corner.Y),
					math.max(max.Z, corner.Z)
				)
			end
		end

		--pos,size
		return (min + max) / 2, max-min
	end

