		end

		local function updateText()
			Button.Value.Text = connection.ActualSelection
		end

		local function UpdateSelection()
			updateText()
			if SelectionMenu then
				SelectionMenuJanitor:Cleanup()

				for i, child in ipairs(connection.Selections) do
					local String = child[1]
					local Order = child[2]

					local Button = module.CreateButtonSetting(
						SelectionMenu.Scroll,
						String,
						"Select"
					)
					Button.Instance.LayoutOrder = Order
					connection.OnButtonAdded:Fire(Button.Instance,String)
					SelectionMenuJanitor:AddInstance(Button.Instance,nil,{})
					SelectionMenuJanitor:AddConnection(Button.ButtonClicked.Event:Connect(function()
						connection.Select(String)
					end),nil,{})
				end

			end
		end

		local function FindSelectionInTable(Name):number
			for i, Selection in ipairs(connection.Selections) do
				if Selection[1] == Name then
					return i
				end
			end
		end

		function connection.AddOption(OptionName:string,NoUpdate:boolean,NewOrder:number)

			local String
			local Order
			if typeof(OptionName) == "table" then
				String = OptionName[1]
				Order = OptionName[2]
			else
				String = OptionName
				Order = NewOrder or 10000
			end
			if FindSelectionInTable(String) then return end

			table.insert(connection.Selections,{String,Order})
			table.sort(connection.Selections,function(a,b)
				return a[1] < b[1]
			end)
			if NoUpdate then return end
			UpdateSelection()
		end

		function connection.RemoveOption(OptionName:string,NoUpdate:boolean)
			local index = FindSelectionInTable(OptionName)
			if not index then return end
			table.remove(connection.Selections,index)
			table.sort(connection.Selections,function(a,b)
				return a[1] < b[1]
			end)
			if NoUpdate then return end
			UpdateSelection()
		end

		function connection.GetSelection()
			return connection.ActualSelection
		end

		function connection.RemoveAllOptions()
			connection.ActualSelection = ""
			table.clear(connection.Selections)
			UpdateSelection()
		end

		function connection.SetSelections(OptionsTable:{string})
			connection.RemoveAllOptions()
			for i,Option in ipairs(OptionsTable) do
				connection.AddOption(Option,true)
			end
			UpdateSelection()
		end

		function connection.Select(Option:string)
			connection.AddOption(Option)

			connection.ActualSelection = Option
			updateText()
			connection.OnSelectionChanged:Fire(Option)
		end

		FrameJanitor:AddConnection(
			Button.MouseButton1Up:Connect(function()
				if SelectionMenu then
					SelectionMenu.Instance:Destroy()
					SelectionMenu = nil
					return
				end
				SelectionMenu = module.CreateMenu(
					connection.Title,
					connection.Description
				)


				UpdateSelection()

			end),nil,{Destruir = true}
		)

		return connection
	end

	return module

end)()

