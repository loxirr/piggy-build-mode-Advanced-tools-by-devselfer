	local function ExecuteSerializeFunc(Val)
		if Val == nil then
			warn("val is nil",Val)
			return
		end
		local RealVar = Val
		local ValType = typeof(RealVar)
		local func = SerializeFuncs[ValType]
		if not func then
			warn("DataSaver: Serialize function not found for type:",ValType)
			return nil
		end
		local Success, NewVal = pcall(function()
			return func(RealVar)
		end)
		if Success then
			return {NewVal,ValType}
		else
			warn("DataSaver: Failed to serialize value:",RealVar,ValType)
			return nil
		end
	end
	
	local function ExecuteDeserializeFunc(Val)
		if Val == nil then
			warn("No val in datasaver",Val)
			return
		end
		local RealVar = Val[1]
		if RealVar == nil then
			warn("No RealVar in datasaver")
			return
		end
		local ValType = Val[2]
		if ValType == nil then
			warn("No ValType in datasaver")
			return
		end
		local func = DeserializeFuncs[ValType]
		if not func then
			warn("DataSaver: Deserialize function not found for type:",ValType)
			return nil
		end
		local Success, NewVal = pcall(function()
			return func(RealVar)
		end)
		if Success then
			return NewVal
		else
			warn("DataSaver: Failed to deserialize value:",Val,RealVar,ValType,NewVal)
			return nil
		end
	end
	
