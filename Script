	local BuildFunctionsAdvanced = (function()
		local module = GeneralPoolObject:GetArray()

		local function CheckIfPositionIsOccupied(Cf,Size,ExtraExclude:{Instance}?)
			local params = OverlapParams.new()
			params.FilterType = Enum.RaycastFilterType.Exclude
			local Table = GetAllExcluded(false,false)
			for i, child in ipairs(ExtraExclude or {}) do
				table.insert(Table,child)
			end
			params.FilterDescendantsInstances = Table

			return #workspace:GetPartBoundsInBox(Cf,Size-Vector3.new(0.01,0.01,0.01),params) > 0
		end

		local function GenerateRandomPosition(Cf:CFrame,Size:Vector3,Attemps)
			Attemps = (Attemps or 0) + 1
			if Attemps > 100 then return end
			local Rng = Random.new()
			local result = Cf + Vector3.new(
				(Rng:NextInteger(-1e+18,1e+18)*10000),
				0,
				(Rng:NextInteger(-1e+18,1e+18)*10000)
			)

			if CheckIfPositionIsOccupied(result,Size) then
				return GenerateRandomPosition(result,Size,Attemps)
			else
				return result
			end
		end

		function module.ModificateModel(
			Model:Model,
			Cf:CFrame?,
			Size:Vector3?,
			Color:BrickColor?,
			Material:Enum.Material?
		)
			if not PlayerCanBuild(Player) then return end
			if not Model then 
				warn("No model") 
				return 
			end
			if Cf then
				Model:PivotTo(Cf)
			end
			if Size and Model:HasTag("Resizable") then
				ResizeModel(Model,Size)
			end
			if Color or Material then
				for i,v in pairs(Model:GetDescendants()) do
					if v:IsA("BasePart") and (v.Name == "ColorPart" or v:HasTag("Colorable")) then
						if Color then
							v.BrickColor = Color
						end
						if Material then
							v.Material = Material
						end
					end
				end
			end
		end

		function module.GenerateTempClone(Model,Position,Size,Color,Material)
			local tempcloned = Model:Clone()
			tempcloned.Parent = BuildModel
			module.ModificateModel(tempcloned,Position,Size,Color,Material)
			return tempcloned
		end

		function module.AdvancedBuild(
			Model:Model,
			Cf:CFrame?,
			Size:Vector3?,
			Color:BrickColor?,
			Material:Enum.Material?,
			IgnoreHitboxes:boolean?,
			CreateUndo:boolean?,
			ConfigurationsFolder:Folder?
		):Model?
			if not PlayerCanBuild(Player) then return end
			if not Model then 
				warn("Model is nil")
				return
			end

			local TempClone = module.GenerateTempClone(Model,Cf,Size,Color,Material)

			IgnoreHitboxes = IgnorePiggyHitboxs or IgnoreHitboxes
			local SpaceOccuped = CheckIfPositionIsOccupied(Cf,(Size or Model:GetExtentsSize()),{TempClone})

			local block,AnteriorCf = nil,nil
			if SpaceOccuped and IgnoreHitboxes then
				AnteriorCf = Cf or Model:GetPivot()
				block = RemotesSimplificados.Build(Model,GenerateRandomPosition(Cf,(Size or Model:GetExtentsSize())),Color,Material)
			elseif SpaceOccuped then
				Notification.Notify("The space is occupied, enable IgnorePiggyHitboxs to avoid this ID:1.1.1",3,Color3.new(1, 0, 0.0156863))
			else
				block = RemotesSimplificados.Build(Model,Cf,Color,Material)
			end

			if block then

				if Size and block:HasTag("Resizable") then
					RemotesSimplificados.Resize(block,AnteriorCf or Cf,Size)
				elseif AnteriorCf then
					RemotesSimplificados.Move(block,AnteriorCf)
				end
				if ConfigurationsFolder and Configurations.CopiarConfiguracionesAlDuplicar then
					local ThisConfigurationFolder = block:FindFirstChild("Configuration")
					if ThisConfigurationFolder then


						local children = ConfigurationsFolder:GetChildren()
						local RealConfigurations = table.create(#children)

						for i, child in ipairs(children) do
							local value = child.Value
							if typeof(value) == "Instance" and value:IsDescendantOf(ConfigurationsFolder) then
								local ValueInThisConfigurations = ThisConfigurationFolder:FindFirstChild(child.Name)
								value = ValueInThisConfigurations:FindFirstChild(value.Name)
							end
							RealConfigurations[child.Name] = value
						end
						RemotesSimplificados.SetSettings(block,RealConfigurations)


					end
				end
				if CreateUndo then
					local UndoInformation = CreateUndoObject()
					UndoInformation.Type = "add"
					UndoInformation.Changes = {table.clone(SelectedTargets),{
						block,
						Cf or block:GetPivot(),
						Size or block:GetExtentsSize(),
						Color or block:GetAttribute("Color"),
						Material or block:GetAttribute("Material"),
					}}
					PushUndoObject(UndoInformation)
				end
			else
				Notification.Notify("The server refused to add the block ID:1.1.1",3,Color3.new(1, 0, 0.0156863))
			end

			TempClone:Destroy()

			return block
		end

		function module.AdvancedDestroy(Model,CreateUndo:boolean?)
			if not PlayerCanBuild(Player) then return end
			if not Model then 
				warn("Model is nil")
				return
			end

			local UndoInformation
			local AnteriorPosition = Model:GetPivot()
			local AnteriorSize = Model:GetExtentsSize()
			if CreateUndo then
				UndoInformation = CreateUndoObject()
				UndoInformation.Type = "destroy"
				UndoInformation.Changes = {table.clone(SelectedTargets)}

				local TypeBlock = GetBlockType(Model)
				if not TypeBlock then
					Notification.Notify("Unexpected error, the block could not be destroyed ID:2.1.1",3,Color3.new(1, 0, 0.0156863))
					return
				end
				table.insert(UndoInformation.Changes,{
					TypeBlock,
					AnteriorPosition,
					AnteriorSize,
					Model:GetAttribute("Color"),
					Model:GetAttribute("Material")
				})
			end

			Model:PivotTo(GenerateRandomPosition(AnteriorPosition,AnteriorSize))

			UpdateActualTarget()

			task.defer(function()
				RemotesSimplificados.Destroy(Model)
				if UndoInformation then
					PushUndoObject(UndoInformation)
				end
			end)

			task.wait(1)
			if Model.Parent then
				Model:PivotTo(AnteriorPosition)
			end
		end

		function module.AdvancedModification(
			Model:Model,
			Cf:CFrame?,
			Size:Vector3?,
			Color:BrickColor?,
			Material:Enum.Material?,
			CreateUndo:boolean?
		)
			if not PlayerCanBuild(Player) then return end
			if not Model then 
				warn("Model is nil")
				return
			end

			local AnteriorPosition = Model:GetPivot()
			local AnteriorSize = Model:GetExtentsSize()
			local AnteriorColor = Model:GetAttribute("Color")
			local AnteriorMaterial = Model:GetAttribute("Material")

			if CreateUndo then
				local UndoInformation = CreateUndoObject()
				UndoInformation.Type = "modification"
				UndoInformation.Changes = {table.clone(SelectedTargets)}
				table.insert(UndoInformation.Changes,
					{
						Model,
						AnteriorPosition,
						AnteriorSize,
						AnteriorColor,
						AnteriorMaterial,
					}
				)
				PushUndoObject(UndoInformation)
			end

			module.ModificateModel(Model,Cf,Size,Color,Material)
			if Size and Model:HasTag("Resizable") then
				RemotesSimplificados.Resize(Model,Cf,Size)
			elseif Cf then
				RemotesSimplificados.Move(Model,Cf)
			end
			if Color or Material then
				local RealColor = Color or AnteriorColor
				local RealMaterial = Material or AnteriorMaterial
				if RealMaterial ~= AnteriorMaterial or RealColor ~= AnteriorColor then
					RemotesSimplificados.Fill(Model,Color or AnteriorColor,Material or AnteriorMaterial)
				end 
			end
		end

		return module
	end)()

