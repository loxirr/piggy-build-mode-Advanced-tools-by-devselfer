		assert(typeof(Index) == "string", ERR_INDEX_STR)
	
		local element = self.ArraysWithIndex[Index]
		if element then
			table.clear(element)
			DebugModule.AdvancedDebugPrint(self.DebugState,
				"RemoveArray-Pooling",
				"LIMPIADO y removido index: " .. Index,
				"ID: " .. self.ID,
				"Ins: " .. (InstruccionID or "No ins")
			)
			self.ArraysWithIndex[Index] = nil
		else
			DebugModule.AdvancedDebugPrint(self.DebugState,
				"RemoveArray-Pooling",
				"Index no encontrado: " .. Index,
				"ID: " .. self.ID,
				"Ins: " .. (InstruccionID or "No ins")
			)
		end
	end
	
