--Menu de configuraciones
do
	local settingsmenu = ScreenGui:FindFirstChild("settingsmenu")

	local tabs = settingsmenu.Tabs
	local pages = settingsmenu.Settings.SettingsPages

	local function GetSettings(name:string)
		local Tab = tabs:FindFirstChild(name)
		local Page = pages:FindFirstChild(name)

		local TabIsConfigured = Tab:GetAttribute("Configured")
		if not TabIsConfigured then
			Tab:SetAttribute("Configured",true)

			Tab.Activated:Connect(function()
				Page.Visible = true
				for i, OtherPage in ipairs(pages:GetChildren()) do
					if OtherPage ~= Page then
						OtherPage.Visible = false
					end
				end
			end)
		end

		return Page
	end

	--Funcion para obtener la posicion exacta del puntero en la pantalla tanto celular como pc
	local function GetMousePosition(): Vector2
		local Guiinset = GuiService:GetGuiInset()
		local mousePos = UserInputService:GetMouseLocation()

		return Vector2.new(mousePos.X - Guiinset.X, mousePos.Y - Guiinset.Y)
	end

	--Funcion para obtener en que porcentaje esta el mouse en una barra de progreso
	local function GetMousePercentageInBar(bar: GuiObject): number
		local mousePos = GetMousePosition()
		return math.clamp((mousePos.X - bar.AbsolutePosition.X) / bar.AbsoluteSize.X, 0, 1)
	end

	local function ConfigureBoolean(Frame:GuiObject)

		local connection = {}

		local Off = Frame:FindFirstChild("Off") :: ImageButton
		local On = Frame:FindFirstChild("On") :: ImageButton

		connection.StateChanged = EventModule.GetEvent()
		connection.Instance = Frame

		local Colors = GuiConfigurations.Colors
		local Transparencys = GuiConfigurations.Transparencys
		local ActualState = nil
		function connection.SetState(State)
			if State == ActualState then return end
			ActualState = State
			connection.StateChanged:Fire(State)
			if State then
				Off.BackgroundColor3 = Colors.NoSelected
				On.BackgroundColor3 = Colors.Selected
				Off.BackgroundTransparency = Transparencys.NoSelected
				On.BackgroundTransparency = Transparencys.Selected
			else
				On.BackgroundColor3 = Colors.NoSelected
				Off.BackgroundColor3 = Colors.Selected
				On.BackgroundTransparency = Transparencys.NoSelected
				Off.BackgroundTransparency = Transparencys.Selected
			end
		end

		Off.Activated:Connect(function()
			connection.SetState(false)
		end)
		On.Activated:Connect(function()
			connection.SetState(true)
		end)

		return connection

	end

	local function ConfigureSlider(Frame:GuiObject)

		local connection = {}

		local Slider = Frame:FindFirstChild("Slider") :: TextButton
		local Select = Slider:FindFirstChild("Select") :: Frame

		connection.Instance = Frame
		connection.NumberChanged = EventModule.GetEvent()

		connection.Number = 1
		connection.ClampedNumber = 1
		connection.DividedNumber = 1
		connection.MinNumber = 0
		connection.MaxNumber = 100
		connection.Divisor = 1

		function connection.Update(NewValue)
			NewValue = tonumber(NewValue)

			if math.isnan(NewValue) then
				return
			end

			if NewValue == connection.Number then return end

			connection.Number = NewValue

			local clamped = math.clamp(NewValue,connection.MinNumber,connection.MaxNumber)
			connection.DividedNumber = math.floor(clamped * connection.Divisor) / connection.Divisor
			connection.DividedNumber = math.clamp(connection.DividedNumber,connection.MinNumber,connection.MaxNumber)

			connection.ClampedNumber = clamped

			local Porcentaje = connection.DividedNumber / (connection.MaxNumber - connection.MinNumber)
			Select.Position = UDim2.new(Porcentaje,0,0.5,0)

			connection.NumberChanged:Fire()
		end

		local SliderState = false

		local function StartDragging(FrameToDrag:TextButton)
			screenGuiJanitor:Add(
				FrameToDrag.MouseButton1Down:Connect(function()
					SliderState = true
					local conn
					conn = screenGuiJanitor:Add(
						UserInputService.InputChanged:Connect(function(input)
							if not SliderState then
								conn:Disconnect()
								return
							end
							if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
								local MousePercentage = GetMousePercentageInBar(Slider)
								connection.Update((connection.MaxNumber-connection.MinNumber)*MousePercentage)			
							end
						end)
					)
				end)
			)
		end
		StartDragging(Slider)
		StartDragging(Select)

		screenGuiJanitor:Add(
			UserInputService.InputEnded:Connect(function(input)
				if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
					SliderState = false
				end
			end)
		)

		return connection

	end

	--Tools menu
	do
		local Page = GetSettings("Tools")

		local IgnoreInvisibleBlocksConn = ConfigureBoolean(Page:FindFirstChild("IgnoreInvisibleBlocks"))
		local MoveToolStateConn = ConfigureBoolean(Page:FindFirstChild("MoveToolState"))
		local IgnoreModelsHitboxsConn = ConfigureBoolean(Page:FindFirstChild("IgnoreModelsHitboxs"))
		local IgnoreToolGridConn = ConfigureBoolean(Page:FindFirstChild("IgnoreToolGrid"))
		local ToolGridConn = ConfigureSlider(Page:FindFirstChild("ToolGrid"))
		local RotationConn = ConfigureSlider(Page:FindFirstChild("Rotation"))

		--ignore invisible blocks
		IgnoreInvisibleBlocksConn.StateChanged.Event:Connect(function(State)
			IgnoreInvisibleBlocks = State
		end)
		IgnoreInvisibleBlocksConn.SetState(IgnoreInvisibleBlocks)

		--movetoolstate
		MoveToolStateConn.StateChanged.Event:Connect(function(State)
			MoveToolIsLocal = State
			Events.WorldStateChanged:Fire(State)
		end)
		MoveToolStateConn.SetState(MoveToolIsLocal)

		--ignore piggy hitboxs
		IgnoreModelsHitboxsConn.StateChanged.Event:Connect(function(State)
			IgnorePiggyHitboxs = State
		end)
		IgnoreModelsHitboxsConn.SetState(IgnorePiggyHitboxs)

		--toolgridstate
		IgnoreToolGridConn.StateChanged.Event:Connect(function(State)
			ActualToolGridState = State
		end)
		IgnoreToolGridConn.SetState(ActualToolGridState)		

		--toolgrid
		ToolGridConn.Divisor = 10
		ToolGridConn.MinNumber = 0.01
		ToolGridConn.MaxNumber = 45
		ToolGridConn.Update(ToolGrid)
		local TextBoxToolGrid = ToolGridConn.Instance.Count :: TextBox
		ToolGridConn.NumberChanged.Event:Connect(function()
			ToolGrid = ToolGridConn.Number
			TextBoxToolGrid.Text = ToolGridConn.Number
		end)
		TextBoxToolGrid.FocusLost:Connect(function()
			ToolGridConn.Update(TextBoxToolGrid.Text)
			ToolGrid = ToolGridConn.Number
		end)	

		--ActualRotation
		RotationConn.Divisor = 1
		RotationConn.MinNumber = 0
		RotationConn.MaxNumber = 90
		RotationConn.Update(ActualRotationGrid)
		local TextBoxRotation = RotationConn.Instance.Count :: TextBox
		RotationConn.NumberChanged.Event:Connect(function()
			ActualRotationGrid = RotationConn.DividedNumber
			TextBoxRotation.Text = RotationConn.DividedNumber
		end)
		TextBoxRotation.FocusLost:Connect(function()
			RotationConn.Update(TextBoxRotation.Text)
			ActualRotationGrid = RotationConn.Number
		end)

	end
end

