	for i = 1, 1250 do
		local color = BrickColor.new(i)

		if TempChecker[color.Name] then
			continue
		else
			TempChecker[color.Name] = true
		end

		table.insert(brickColors, color)

		WaitFuncObject:Wait()
	end

	table.sort(brickColors, function(a, b)
		local h1, s1, v1 = a.Color:ToHSV()
		local h2, s2, v2 = b.Color:ToHSV()

		if v1 == v2 then
			return h1 < h2 -- ordena por tono si tienen mismo brillo
		end

		return v1 > v2
	end)

	table.clear(TempChecker)

	local WaitFuncObject = WaitFunc.new(25)
	for i, brickColor in pairs(brickColors) do
