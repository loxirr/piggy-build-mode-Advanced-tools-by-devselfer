	--obtener la player data del jugador argumentado
	local function GetPlayerData(Player:Player)
		local UserId = tostring(Player.UserId)
		local PlayerData = PlayersData[UserId]
		if not PlayerData then
			PlayerData = {}
			PlayersData[UserId] = PlayerData
		end
		return PlayerData
	end
	
	--Obtiene el janitor del jugador, si no existe lo crea
	local function GetPlayerJanitor(Player:Player)
		local PlayerData = GetPlayerData(Player)
		local PlayerJanitor = PlayerData.PlayerJanitor
		if not PlayerJanitor then
			local PlayerJanitor = Janitor.new()
	
			---
	
			--Sincronizar con otro janitor
			GlobalJanitor:AddJanitor(PlayerJanitor,nil,{Destruir = true, Destruirtarget = true})
	
			---
			PlayerData.PlayerJanitor = PlayerJanitor
		end
		return PlayerJanitor
	end
	
	local function RemovePlayerData(Player:Player)
		local UserId = tostring(Player.UserId)
		local PlayerData = PlayersData[UserId]
		if PlayerData then
			table.clear(PlayerData)
			PlayersData[UserId] = nil
		end
	end
	
	--obtener la imagen del icono de la player argumentada
	local function GetPlayerIcon(Player:Player)
		local PlayerData = GetPlayerData(Player)
		local Icon = PlayerData.Icon
		if not Icon then
			local ready = false
			Icon,ready = Players:GetUserThumbnailAsync(
				Player.UserId,
				Enum.ThumbnailType.HeadShot,
				Enum.ThumbnailSize.Size180x180
			)
			while not ready do
				task.wait()
			end
			PlayerData.Icon = Icon
		end
		return Icon
	end
	
