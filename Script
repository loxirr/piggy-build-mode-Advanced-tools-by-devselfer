			)	
		then

			local mousePos = UIFuncs.ApplyGuiInset(UIFuncs.GetPointerPosition(),ScreenGui)

			local MaxPositionOfTextLabel = mousePos + Vector2.new(
				ExtraInformationTextlabel.TextBounds.X,
				ExtraInformationTextlabel.TextBounds.Y
			)
			local screenSize = ScreenGui.AbsoluteSize

			local PositionRemoverX = 0
			local PositionRemoverY = 0
			if MaxPositionOfTextLabel.X > screenSize.X or MaxPositionOfTextLabel.Y > screenSize.Y then
				PositionRemoverX = MaxPositionOfTextLabel.X - screenSize.X
				PositionRemoverY = MaxPositionOfTextLabel.Y - screenSize.Y
				if PositionRemoverX < 0 then
					PositionRemoverX = 0
				end
				if PositionRemoverY < 0 then
					PositionRemoverY = 0
				end
			end
			mousePos = mousePos - Vector2.new(PositionRemoverX, PositionRemoverY)


			-- Convertir a escala (0 - 1)
			local scaleX = mousePos.X / screenSize.X
			local scaleY = mousePos.Y / screenSize.Y

			-- Clamp por seguridad
			scaleX = math.clamp(scaleX, 0, 1)
			scaleY = math.clamp(scaleY, 0, 1)

			-- Tamaño restante de pantalla
			local sizeX = 1 - scaleX
			local sizeY = 1 - scaleY

			-- Aplicar
			ExtraInformationTextlabel.Position = UDim2.new(scaleX, 0, scaleY, 0)
			ExtraInformationTextlabel.Size = UDim2.new(sizeX, 0, sizeY, 0)
		end
	end)
end

