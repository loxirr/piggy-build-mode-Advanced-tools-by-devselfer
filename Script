local function safeDiv(a, b)
	return b ~= 0 and a / b or 0
end

local function GetScale(Model: Model,Size:Vector3?)

	local function UpdateBasicPropertys(Model)
		local initialSize = Model:GetAttribute("InitialSizeForFunction")
		local ActualSize = Model:GetExtentsSize()

		if not initialSize then 
			initialSize = ActualSize
			Model:SetAttribute("InitialSizeForFunction", initialSize)

			for _, child in ipairs(Model:GetDescendants()) do
				if child:IsA("BasePart") then
					child:SetAttribute("InitialSizeForFunction", child.Size)
				end
			end
		end

		return initialSize,ActualSize
	end

	local initialSize,ActualSize = UpdateBasicPropertys(Model)

	local NewScale

	NewScale = Vector3.new(
		math.abs(safeDiv((Size or ActualSize).X, initialSize.X)),
		math.abs(safeDiv((Size or ActualSize).Y, initialSize.Y)),
		math.abs(safeDiv((Size or ActualSize).Z, initialSize.Z))
	)
	Model:SetAttribute("ActualScaleForFunction", NewScale)

	return NewScale, initialSize,ActualSize
end

local OwnerValue = ReplicatedStorage:FindFirstChild("Owner")
