	end

	local function SnapToGrid(value, grid)
		if grid <= 0 then
			grid = 0.0001
		end
		return math.floor((value / grid)) * grid
	end

	local function ConvertRaycastToCFrame(Raycast: RaycastResult, SizeOffset: Vector3, Cf: CFrame,Inverse:boolean?)
		local position = Raycast.Position
		local normal = Raycast.Normal.Unit

		-- Convertir los ejes del objeto al mundo
		local right = Cf.RightVector
		local up = Cf.UpVector
		local look = Cf.LookVector

		-- Proyectar el tamaño en la normal
		local projectedSize =
			math.abs(right:Dot(normal)) * SizeOffset.X +
			math.abs(up:Dot(normal)) * SizeOffset.Y +
			math.abs(look:Dot(normal)) * SizeOffset.Z

		if Inverse then
			projectedSize = -projectedSize
		end

		-- Ajuste hacia afuera de la superficie
		local finalPos = position + normal * (projectedSize / 2)

		-- SNAP A GRID (solo en ejes NO dominantes)
		if ActualToolGridState then

			-- Detectar eje dominante del normal
			local absNormal = Vector3.new(math.abs(normal.X), math.abs(normal.Y), math.abs(normal.Z))

			local dominantAxis
			if absNormal.X > absNormal.Y and absNormal.X > absNormal.Z then
				dominantAxis = "X"
			elseif absNormal.Y > absNormal.X and absNormal.Y > absNormal.Z then
				dominantAxis = "Y"
			else
				dominantAxis = "Z"
			end

			local x, y, z = finalPos.X, finalPos.Y, finalPos.Z
			if dominantAxis ~= "X" then
				x = SnapToGrid(x, ToolGrid)+ToolGrid/2
			end
			if dominantAxis ~= "Y" then
				y = SnapToGrid(y, ToolGrid)+ToolGrid/2
			end
			if dominantAxis ~= "Z" then
				z = SnapToGrid(z, ToolGrid)+ToolGrid/2
			end
			finalPos = Vector3.new(x, y, z)
		end

		-- Orientación correcta respecto a la superficie
		local finalCf
		if Configurations.AddToolsRoteTheModel then
			finalCf = CFrame.lookAt(finalPos, finalPos + normal) 
				* CFrame.Angles(math.rad(270), math.rad(-90), 0)
		else
			finalCf = CFrame.new(finalPos)
		end

		return finalCf
	end

