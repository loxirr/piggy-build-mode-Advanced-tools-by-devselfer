		if self.PoolJanitor:IsDestroyed() then return end
		self.DebugState = State
	end
	
	-- ═══════════════════════════════════════════════════════════
	-- Constructor
	-- ═══════════════════════════════════════════════════════════
	function Pool.new(ArraysNumber: number?,PoolName:string?): PoolObject
		Actualpool+= 1
		local n: number = ArraysNumber or 0
		local PoolJanitor = Janitor.new()
		
		local self = setmetatable({
			Arrays = table.create(n),
			ArraysWithIndex = {},
			ActualArray = 0,
			ID = PoolName or Actualpool,
			DebugState = DebugModule.DebugState,
			PoolJanitor = PoolJanitor
		}, { __index = PoolObject })
		
		globalJanitor:AddJanitor(PoolJanitor,nil,{Destruir = true,DestruirTarget = true})
		
		PoolJanitor:AddTask(function()
			for i, child in pairs(self.Arrays) do
				table.clear(child)
			end
			table.clear(self.Arrays)
			self.Arrays = nil
	
			for i, child in pairs(self.ArraysWithIndex) do
				table.clear(child)
			end
			table.clear(self.ArraysWithIndex)
			self.ArraysWithIndex = nil
			self.ActualArray = nil
			self.ID = nil
			self.DebugState = nil
			self.PoolJanitor = nil
		end,nil,{Destruir = true})
		
		DebugModule.AdvancedDebugPrint(DebugModule.DebugState,
			"Pool.new",
			"Pool creado con capacidad: " .. n,
			"ID: " .. self.ID,
			"Pools creados: " .. Actualpool
		)
		return self :: PoolObject
	end
	
