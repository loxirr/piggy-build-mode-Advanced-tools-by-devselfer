local function ResizeModel(Model: Model, InitialSize: Vector3, NewSize: Vector3)
	local Diference = InitialSize - NewSize
	for i, child in ipairs(Model:GetDescendants()) do
		if child:IsA("BasePart") and not child:HasTag("Input") then
			child.Size = child:GetAttribute("InitialSize")-Diference
		end
	end
end

