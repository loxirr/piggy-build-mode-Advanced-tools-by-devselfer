		if ActualSelectedTargetingColor then
			for i, child in ipairs(SelectedTargets) do
				if not child then continue end
				CreateBordersForSelected(child)
			end
		else
			for i, child in ipairs(SelectedTargets) do
				if not child then continue end
				RemoveBorders(child)
			end	
		end
	end

	local function AddSelectedBlock(Model:Model,OmitirFind:boolean,OmitirAspectoUpdate:boolean)
		if not Model then return end

		if not OmitirFind and table.find(SelectedTargets,Model) then return end

		local ModelJanitor = Janitor.new("Model")
		ModelJanitor:LinkToInstance(Model,nil,{Destruir = true})
		GlobalJanitor:AddJanitor(ModelJanitor,nil,{Destruir = true,DestruirTarget = true})
		ModelJanitor:AddTask(function()
			RemoveSelectedBlock(Model)
		end,"Task",{Destruir = true})

		JanitorsSelectedsBlocks[Model] = function()
			ModelJanitor:Remove("Task",{Destruir = true})
			ModelJanitor:Destroy()
		end
		SelectedTargets[#SelectedTargets+1] = Model

		CreateBordersForSelected(Model)
		if not OmitirAspectoUpdate then
			CreateBoxOfAllSelectedModels()
			OnSelectedTargetsChanged:Fire()
		end
	end

	local function ToggleObjectToSelected(Model:Model,OmitirAspectoUpdate:boolean)
