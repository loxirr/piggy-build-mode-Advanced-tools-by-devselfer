--Janitor EZ
local Janitor = (function()
	local Janitor = {}

	local JanitorObj = {}
	function JanitorObj.Add(self:JanitorObj,obj)
		table.insert(self.Tasks, obj)
		return obj
	end

	function JanitorObj.Cleanup(self: JanitorObj)

		local function CleanupObject(obj)
			if not obj then return end

			local t = typeof(obj)

			-- Tipos primitivos (se ignoran)
			if t == "number" or t == "string" or t == "boolean" or t == "EnumItem" then
				return
			end

			-- Roblox types
			if t == "RBXScriptConnection" then
				pcall(function()
					obj:Disconnect()
				end)
				return
			end

			if t == "Instance" then
				if obj.Destroy and obj.Parent then
					pcall(function()
						obj:Destroy()
					end)
				end
				return
			end

			-- Threads
			if t == "thread" then
				pcall(function()
					task.cancel(obj)
				end)
				return
			end

			-- Funciones
			if t == "function" then
				pcall(function()
					obj()
				end)
				return
			end

			-- Tablas (más potente 👇)
			if t == "table" then
				-- Si tiene método Cleanup (tipo Janitor u otros sistemas)
				if typeof(obj.Cleanup) == "function" then
					pcall(function()
						obj:Cleanup()
					end)
					return
				end

				-- Si tiene Destroy personalizado
				if typeof(obj.Destroy) == "function" then
					pcall(function()
						obj:Destroy()
					end)
					return
				end

				-- Si tiene Disconnect personalizado
				if typeof(obj.Disconnect) == "function" then
					pcall(function()
						obj:Disconnect()
					end)
					return
				end

				-- Recursivo como fallback
				for _, v in pairs(obj) do
					CleanupObject(v)
				end

				table.clear(obj)
				return
			end
		end

		for i = #self.Tasks, 1, -1 do
			CleanupObject(self.Tasks[i])
			self.Tasks[i] = nil
		end

		table.clear(self.Tasks)
	end

	function JanitorObj.Destroy(self:JanitorObj)
		self:Cleanup()
		setmetatable(self, nil)
		for k, _ in pairs(self) do
			self[k] = nil
		end
		self = nil
	end

	function Janitor.new()
		return setmetatable({
			Tasks = {}
		}, {__index = JanitorObj}) :: JanitorObj
	end

	type Janitor = typeof(Janitor) & {

	}

	type JanitorObj = typeof(JanitorObj) & {

	}

	return Janitor :: Janitor
end)()

--basic build functions
local BuildFunctions = (function() 
	local Functions = {}

	local Folder = ReplicatedStorage:FindFirstChild("Functions")

	local BuildRemote = Folder:FindFirstChild("PlaceBlock")
	local DestroyRemote = Folder:FindFirstChild("DestroyBlock")
	local ResizeRemote = Folder:FindFirstChild("CommitResize")
	local MoveRemote = Folder:FindFirstChild("CommitMove")
	local FillRemote = Folder:FindFirstChild("FillBlock")

	function Functions.Build(
		block:Model,
		Position:CFrame,
		Color:BrickColor,
		Material:Enum.Material
	)
		return BuildRemote:InvokeServer(
			block,
			Position,
			Color,
			Material
		)

	end

	function Functions.Fill(
		block:Model,
		Color:BrickColor,
		Material:Enum.Material
	)
		return FillRemote:InvokeServer(
			block,
			Color,
			Material
		)
	end

	function Functions.GetConfigs(
		block:Model
	): (BrickColor,string)
		return block:GetAttribute("Color"), block:GetAttribute("Material")
	end

	function Functions.Destroy(
		block:Model
	)
		return DestroyRemote:InvokeServer(
			block
		)

	end

	function Functions.Resize(
		block:Model,
		Position:CFrame,
		Size:Vector3
	)
		local ColorPart = block:FindFirstChild("ColorPart",true)
		if not ColorPart then
			for i, child in ipairs(block:GetChildren()) do
				if child:IsA("BasePart") then
					ColorPart = child
					break
				end
			end
		end

		local success, data = pcall(function()			
			return ResizeRemote:InvokeServer(
				block,
				{
					ColorPart,
					Position,
					Size
				}
			)
		end)
		if success then
			return data
		else
			warn("Error al redimensionar el bloque:", data) -- Muestra el mensaje de error
		end

	end

	function Functions.Move(
		block:Model,
		Position:CFrame
	)
		return MoveRemote:InvokeServer(
			block,
			Position
		)

	end

	return Functions
end)()

