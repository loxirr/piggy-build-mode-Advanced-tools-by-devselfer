local function ApuntaCamaraToItem(viewportFrame, camera:Camera, item)
	camera = camera or Instance.new("Camera")
	camera.Parent = viewportFrame
	camera.FieldOfView = 10

	-- Obtener el centro y tamaño del modelo
	local cframe, size = item:GetBoundingBox()
	local center = cframe.Position

	-- Calcular la distancia ideal basada en el tamaño
	local maxSize = math.max(size.X, size.Y, size.Z)
	local distance = maxSize * 10 -- ajusta este multiplicador a tu gusto

	-- Dirección de la cámara (puedes cambiarla si quieres otro ángulo)
	local direction = Vector3.new(1, 1, 1)

	-- Posicionar la cámara
	local cameraPosition = center + direction.Unit * distance

	camera.CFrame = CFrame.new(cameraPosition, center)
	camera.Focus = CFrame.new(center)

	viewportFrame.CurrentCamera = camera
end

