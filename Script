	local SliderExample = GetExampleConfigurations("SliderExample")
	function module.CreateSliderSetting(Page:GuiObject,name:string,description:string,tools:{string},IsMobile:boolean?,order:number?)

		local connection = {}

		local Frame = SliderExample:Clone()
		Frame.Parent = Page
		Page.LayoutOrder += 1
		Frame.LayoutOrder = Page.LayoutOrder

		local FrameJanitor = Janitor.new()
		FrameJanitor:LinkToInstance(Frame,nil,{Destruir = true,DestroyInstance = true})
		GlobalJanitor:AddJanitor(FrameJanitor,nil,{Destruir = true, DestruirTarget = true})

		local Label = Frame:FindFirstChild("Label") :: TextLabel

		Label.Text = name
		UIFuncs.SetExtraInformationMessage(Frame,description)

		local Folder = Frame:FindFirstChildOfClass("Folder")

		local Slider = Folder:FindFirstChild("Slider") :: TextButton
		local Count = Folder:FindFirstChild("Count") :: TextButton

		local Select = Slider:FindFirstChild("Select") :: TextButton

		connection.TextBox = Count
		connection.NumberChanged = EventModule.GetEvent()

		connection.Instance = Frame

		connection.Number = nil
		connection.MinNumber = 0
		connection.MaxNumber = 100
		connection.Divisor = 1

		function connection.Update(NewValue,DirectNumber:boolean?)
			NewValue = tonumber(NewValue)
			if not NewValue then return end

			if math.isnan(NewValue) then
				return
			end

			if NewValue == connection.Number then return end

			local Divisor = connection.Divisor
			local MinNumber = connection.MinNumber
			local MaxNumber = connection.MaxNumber

			local finalNumber
			if DirectNumber then
				finalNumber = NewValue
			else
				local clamped = math.clamp(NewValue,MinNumber,MaxNumber)
				finalNumber = math.floor(clamped * Divisor) / Divisor
			end

			local Porcentaje = finalNumber / (MaxNumber - MinNumber)
			Select.Position = UDim2.new(Porcentaje,0,0.5,0)

			connection.Number = finalNumber

			connection.NumberChanged:Fire()
		end

		function connection.UpdateAppareance(NewValue)
			NewValue = tonumber(NewValue)

			if math.isnan(NewValue) then
				return
			end

			local Divisor = connection.Divisor
			local MinNumber = connection.MinNumber
			local MaxNumber = connection.MaxNumber

			local clamped = math.clamp(NewValue,MinNumber,MaxNumber)
			local DividedNumber = math.floor(clamped * Divisor) / Divisor

			local Porcentaje = DividedNumber / (MaxNumber - MinNumber)
			Select.Position = UDim2.new(Porcentaje,0,0.5,0)
		end

		local SliderState = false

		local function StartDragging(FrameToDrag:TextButton)
			FrameJanitor:AddConnection(
				FrameToDrag.MouseButton1Down:Connect(function()
					SliderState = true
					local conn
					conn = FrameJanitor:AddConnection(
						UserInputService.InputChanged:Connect(function(input)
							if not SliderState then
								conn:Disconnect()
								return
							end
							if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
								local MousePercentage = UIFuncs.GetMousePercentageInBar(Slider)
								connection.Update((connection.MaxNumber-connection.MinNumber)*MousePercentage)			
							end
						end),nil,{Destruir = true}
					)
				end),nil,{Destruir = true}
			)
		end
		StartDragging(Slider)
		StartDragging(Select)

		FrameJanitor:AddConnection(
			UserInputService.InputEnded:Connect(function(input)
				if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
					SliderState = false
				end
			end),nil,{Destruir = true}
		)

		if tools then
			local ToAdd = {}
			ToAdd.Update = function(number)
				connection.Update(number,true)
			end
			ToAdd.Name = name
			ToAdd.Type = "number"
			ToAdd.Order = order or 10
			ToAdd.Updated = {connection.NumberChanged}
			ToAdd.GetState = function()
				return connection.Number
			end
			ToAdd.Mobile = IsMobile or false
			for i, child in ipairs(tools) do
				ConfigurationsConns[child] = ConfigurationsConns[child] or {}
				table.insert(ConfigurationsConns[child],ToAdd)
			end
		end

		return connection
	end

